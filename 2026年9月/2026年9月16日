/*
https://codeforces.com/problemset/problem/371/C
*/
#include<bits/stdc++.h>
using namespace std;

#define int long long

int cb, cs, cc;
int nb, ns, nc;
int pb, ps, pc;
int n;

bool check(int x){
    int cntb = x * cb, cnts = x * cs, cntc = x * cc;
    int cost = 0;
    if(cntb > nb) cost += (cntb - nb) * pb;
    if(cnts > ns) cost += (cnts - ns) * ps;
    if(cntc > nc) cost += (cntc - nc) * pc;
    
    if(cost <= n) return true;
    return false;
}

signed main(){

    string s; cin >> s;
    for(char x : s){
        if(x == 'B') cb ++;
        else if(x == 'S') cs ++;
        else cc ++;
    }

    cin >> nb >> ns >> nc;
    cin >> pb >> ps >> pc;
    cin >> n;

    int l = 0, r = 1000000000000000, ans = 0;
    while(l <= r){
        int mid = (l + r) / 2;
        if(check(mid)){
            ans = mid;
            l = mid + 1;
        }
        else r = mid - 1;
    }

    cout << ans << endl;
    return 0;
}
