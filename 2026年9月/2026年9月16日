/*
https://www.luogu.com.cn/problem/U41492
*/
#include<bits/stdc++.h>
using namespace std;

const int N = 100000 + 100;
vector<int> adj[N];

int n, a[N];
int color[N], cnt[N];
int L[N], R[N], totdfn, node[N];
int son[N], sz[N];
int ans[N], totcolor;

void add(int u){
    if(!cnt[color[u]]) totcolor ++;
    cnt[color[u]] ++;
}
void del(int u){
    cnt[color[u]] --;
    if(!cnt[color[u]]) totcolor --;
}

void dfs_son(int u, int fa){
    sz[u] = 1;
    L[u] = ++ totdfn;
    node[totdfn] = u;
    
    for(int v : adj[u]){
        if(v == fa || v == son[u]) continue;
        dfs_son(v, u);
        sz[u] += sz[v];
        if(!son[u] || sz[v] > sz[son[u]]) son[u] = v;
    }
    R[u] = totdfn;
}

void dfs_ans(int u, int fa, bool keep){

    for(int v : adj[u]){
        if(v == fa || v == son[u]) continue;
        dfs_ans(v, u, false);
    }

    if(son[u]) dfs_ans(son[u], u, true);

    for(int v : adj[u]){
        if(v == fa || v == son[u]) continue;
        for(int i = L[v]; i <= R[v]; i ++) add(node[i]);
    }

    add(u);
    ans[u] = totcolor;
    
    if(!keep){
        for(int i = L[u]; i <= R[u]; i ++) del(node[i]);
    }
}

int main(){

    cin >> n;
    for(int i = 1; i <= n - 1; i ++){
        int u, v; cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    for(int i = 1; i <= n; i ++) cin >> color[i];

    dfs_son(1, -1);
    dfs_ans(1, -1, false);

    int q; cin >> q;
    while(q --){
        int x; cin >> x;
        cout << ans[x] << endl;
    }
    return 0;
}
