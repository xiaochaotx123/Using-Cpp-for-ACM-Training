*/

#include<bits/stdc++.h>
using namespace std;


const int N = 1000000 + 100;

string s; 

struct Node{
    int l, r;
    int cnt;
    int cntl, cntr;
}tr[4 * N];

void push_up(int u){
    tr[u].cnt = (tr[u << 1].cnt + tr[u << 1 | 1].cnt);
    int now_cnt = min(tr[u << 1].cntl, tr[u << 1 | 1].cntr);
    tr[u].cnt += now_cnt;

    tr[u].cntl = tr[u << 1].cntl - now_cnt + tr[u << 1 | 1].cntl;
    tr[u].cntr = tr[u << 1].cntr + tr[u << 1 | 1].cntr - now_cnt;
}

void build(int u, int l, int r){
    if(l == r){
        tr[u] = {l, r, 0, 0, 0};
        if(s[l] == '(') tr[u].cntl = 1;
        else tr[u].cntr = 1;
        return ;
    }
    else{
        tr[u] = {l, r, 0, 0, 0};
        int mid = (tr[u].l + tr[u].r) >> 1;
        build(u << 1, l, mid);
        build(u << 1 | 1, mid + 1, r);

        push_up(u);
    }
}


Node query(int u, int l, int r){
    if(l <= tr[u].l && tr[u].r <= r) return tr[u];
    else{

        int mid = (tr[u].l + tr[u].r) >> 1;

        Node left = {-1, -1, 0, 0, 0}, right = {-1, -1, 0, 0, 0};
        if(l <= mid) left = query(u << 1, l, r);
        if(r > mid) right = query(u << 1 | 1, l, r);
        if(left.l == -1) return right;
        if(right.l == -1) return left;
        
        Node now = {left.l, right.r, 0, 0, 0};
        now.cnt = left.cnt + right.cnt;
        int now_cnt = min(left.cntl, right.cntr);
        now.cnt += now_cnt;
        now.cntl = left.cntl + right.cntl - now_cnt;
        now.cntr = left.cntr + right.cntr - now_cnt;
 
        return now;
    }
}

int main(){

    cin >> s;
    int n = (int)s.size();
    s = " " + s;

    build(1, 1, n);

    int q; cin >> q;
    while(q --){
        int l, r; cin >> l >> r;
        Node node = query(1, l, r);
        cout << 2 * node.cnt << endl;
    }
    return 0;
}
