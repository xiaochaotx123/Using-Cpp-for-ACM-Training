#include<bits/stdc++.h>
using namespace std;


void solve(){

    int n; cin >> n;
    vector<int> a(n + 10), dp(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i];
    for(int i = n; i >= 1; i --) dp[i] = n - i + 1;
    for(int i = n; i >= 1; i --){
        if(i <= n - 1) dp[i] = min(dp[i], dp[i + 1] + 1);
        if(i + a[i] + 1 <= n + 1) dp[i] = min(dp[i], dp[i + a[i] + 1]);
    }
    cout << dp[1] << endl;
    return ;
}
int main(){

    int tt; cin >> tt;
    while(tt --) solve();
    return 0;
}
