/*
https://codeforces.com/contest/1187/problem/E
*/

#include<bits/stdc++.h>
using namespace std;

#define int long long
#define endl '\n'

const int N = 200000 + 100;
const int rinf = -1000000000000000000;
int n;
vector<int> adj[N];
map<pair<int, int>, int> ma;
int sz[N], ans[N];
int sum[N];

void dfs_sz(int u, int fa){
    sz[u] = 1;
    for(int v : adj[u]){
        if(v == fa) continue;
        dfs_sz(v, u);
        sz[u] += sz[v];
    }
}
void dfs_ans(int u, int fa){

    ans[u] = sz[u];
    for(int v : adj[u]){
        if(v == fa) continue;
        dfs_ans(v, u);
        ans[u] += ans[v];
        ma[{u, v}] = ans[v];
        sum[u] += ans[v];
    }
}
void dfs_fans(int u, int fa){

    if(fa != -1){
        int now_ans = n - sz[u];
        now_ans += sum[fa] - ma[{fa, u}];
        ma[{u, fa}] = now_ans;
        sum[u] += ma[{u, fa}];
    }
    for(int v : adj[u]){
        if(v == fa) continue;
        dfs_fans(v, u);
    }
}
signed main(){
    ios::sync_with_stdio(false);cin.tie(NULL);cout.tie(NULL);

    cin >> n;
    for(int i = 1; i <= n - 1; i ++){
        int u, v; cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }
    dfs_sz(1, -1);
    dfs_ans(1, -1);
    dfs_fans(1, -1);

    int ans = rinf;
    for(int i = 1; i <= n; i ++){
        int now_ans = 0;
        for(int v : adj[i]){
            now_ans += ma[{i, v}];
        }
        ans = max(ans, now_ans);
    }
    cout << ans + n << endl;
    return 0;
}
