*/
#include<bits/stdc++.h>
using namespace std;

#define int long long

const int N = 1000000 + 100;
int n, a[N];
vector<int> b;
int find_pos(int x){
    return lower_bound(b.begin(), b.end(), x) - b.begin() + 1;
}

int c1[N], c2[N];
struct Node{
    int l, r;
    int cnt;
}tr[4 * N];

void push_up(int u){
    tr[u].cnt = (tr[u << 1].cnt + tr[u << 1 | 1].cnt);
}

void build(int u, int l, int r){
    if(l == r){
        tr[u] = {l, r, 0};
        return ;
    }
    else{
        tr[u] = {l, r, 0};
        int mid = (tr[u].l + tr[u].r) >> 1;
        build(u << 1, l, mid);
        build(u << 1 | 1, mid + 1, r);
    }
}

void modify(int u, int x){
    if(tr[u].l == tr[u].r) tr[u].cnt ++;
    else{
        int mid = (tr[u].l + tr[u].r) >> 1;
        if(x <= mid) modify(u << 1, x);
        else modify(u << 1 | 1, x);
        push_up(u);
    }
}

int query(int u, int l, int r){
    if(l <= tr[u].l && tr[u].r <= r) return tr[u].cnt;
    else{
        int res = 0;
        int mid = (tr[u].l + tr[u].r) >> 1;
        if(l <= mid) res += query(u << 1, l, r);
        if(r > mid) res += query(u << 1 | 1, l, r);
        return res;
    }
}

signed main(){
    
    int n; cin >> n;
    for(int i = 1; i <= n; i ++){
        cin >> a[i];
        b.push_back(a[i]);
    }
    sort(b.begin(), b.end());
    b.erase(unique(b.begin(), b.end()), b.end());

    int len = (int)b.size() + 10;
    build(1, 1, len);

    for(int i = 1; i <= n; i ++){
        int pos = find_pos(a[i]);

        int max_cnt = 0;
        max_cnt = query(1, pos + 1, len);
        c1[i] = max_cnt;
        modify(1, pos);
    }

    build(1, 1, len);
    for(int i = n; i >= 1; i --){
        int pos = find_pos(a[i]);

        int min_cnt = 0;
        if(pos >= 2) min_cnt = query(1, 1, pos - 1);
        c2[i] = min_cnt;
        modify(1, pos);
    }

    int ans = 0;
    for(int i = 1; i <= n; i ++) ans += c1[i] * c2[i];

    cout << ans << endl;
    return 0;
}
