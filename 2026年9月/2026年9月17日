#include<bits/stdc++.h>
using namespace std;


#define int long long

const int N = 200000 + 100;
int prime[N], idx;
bool vis[N];
int cnt[N];
int mc1[N], mc2[N];


void get_prime(){
    for(int i = 2; i < N; i ++){
        if(!vis[i]) prime[++ idx] = i;
        for(int j = 1; j <= idx && prime[j] * i <= N; j ++){
            vis[prime[j] * i] = true;
            if(i % prime[j] == 0) break;
        }
    }
}

int ksm(int a, int b){
    int sum = 1;
    while(b){
        if(b & 1) sum = (sum * a);
        b >>= 1;
        a = (a * a);
    }
    return sum;
}

signed main(){
    ios::sync_with_stdio(false);cin.tie(NULL);cout.tie(NULL);
    get_prime();

    int n; cin >> n;
    vector<int> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i];
    
    for(int i = 1; i <= n; i ++){
        int x = a[i];
        for(int j = 2; j * j <= x; j ++){
            if(x % j == 0){
                cnt[j] ++;
                while(x % j == 0) x /= j;
            }
        }
        if(x != 1) cnt[x] ++;
    }
    vector<int> ok;
    for(int i = 1; i <= idx; i ++){
        if(cnt[prime[i]] >= n - 1){
            ok.push_back(prime[i]);
            mc1[prime[i]] = mc2[prime[i]] = -1;
        }
    }
    for(int p : ok){
        for(int i = 1; i <= n; i ++){
            int nc = 0, x = a[i];
            while(x % p == 0){
                nc ++;
                x /= p;
            }
            if(mc1[p] == -1) mc1[p] = nc;
            else if(mc2[p] == -1) mc2[p] = nc;
            else{
                if(nc < mc1[p]){
                    mc2[p] = mc1[p];
                    mc1[p] = nc;
                }
                else if(nc < mc2[p]) mc2[p] = nc;
            }
        }
    }
    int ans = 1;
    for(int x : ok){
        ans = ans * ksm(x, max(mc1[x], mc2[x]));
    }
    cout << ans << endl;
    return 0;
}
