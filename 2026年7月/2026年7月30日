int n, m, ans;

void dfs(int flower, int store, int friends){
    if(!flower && store == n && friends == m){
        ans ++;
        return ;
    }
    if(flower - 2 * (m - friends) > 0) return ;

    dfs(flower * 2, store + 1, friends);
    if(flower - 2 >= 0){
        if(flower == 2 && store == n && friends == m - 1) dfs(flower - 2, store, friends + 1);
        if(flower > 2) dfs(flower - 2, store, friends + 1);
    }
}
void solve(){
    
    cin >> n >> m;    
    
    dfs(5, 0, 0);

    cout << ans << endl;
    return ;
}
