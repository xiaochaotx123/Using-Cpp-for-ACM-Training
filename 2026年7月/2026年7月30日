/*
https://www.matiji.net/exam/brushquestion/230/3181/1DC60EA6DF83A333301CFFE1407FBA59
题目的意思是说从在n×m大小的格子中，从(1, 1)走到(n, m)的方案数，显然答案是C(n + m, n)
但是n和m的数据范围最大都为50000，所以求C(n + m, n)需要高精度实现
对于C(n + m, n) = (n + m)! / (n! × m!)
对于这个结果如果使用高精度呢？将其质因数分解，然后累乘质因数即可
*/
#include<bits/stdc++.h>
using namespace std;

#define endl '\n'
#define int long long
#define ull unsigned long long
#define IOS ios::sync_with_stdio(false);cin.tie(NULL);cout.tie(NULL);
#define HelloWorld IOS;

using PII = pair<int, int>;
#define fi first
#define se second
#define pb push_back
#define sz(x) ((int)(x).size())
#define all(x) (x).begin(), (x).end()
const int inf = 3000000000000000000;
const int rinf = -3000000000000000000;
const bool HAVE_CASE = false;


const int N = 100000 + 100;
int prime[N], idx;
bool vis[N];

void get_prime(){
    for(int i = 2; i < N; i ++){
        if(!vis[i]) prime[++ idx] = i;
        for(int j = 1; j <= idx && prime[j] <= N / i; j ++){
            vis[i * prime[j]] = true;
            if(i % prime[j] == 0) break;
        }
    }
}

vector<int> mul(vector<int> a, int num){
    vector<int> c;
    for(int i = 0; i < sz(a); i ++) c.pb(a[i] * num);
    for(int i  = 0; i < sz(c); i ++){
        if(c[i] >= 10){
            if(i + 1 < sz(c)) c[i + 1] += c[i] / 10;
            else c.pb(c[i] / 10);
            c[i] %= 10;
        }
    }    
    while(sz(c) > 100) c.pop_back();
    return c;
}

int ksm(int a, int b){
    int sum = 1;
    while(b){
        if(b & 1) sum = (sum * a);
        b >>= 1;
        a = (a * a);
    }
    return sum;
}

void solve(){
    
    int n, m; cin >> n >> m;
    map<int, int> ma;

    int x = n + m;
    for(int i = 1; prime[i] <= x; i ++){
        int y = x;
        while(y){
            ma[prime[i]] += y / prime[i];
            y /= prime[i];
        }
    }

    x = n;
    for(int i = 1; prime[i] <= x; i ++){
        int y = x;
        while(y){
            ma[prime[i]] -= y / prime[i];
            y /= prime[i];
        }
    }    

    x = m;
    for(int i = 1; prime[i] <= x; i ++){
        int y = x;
        while(y){
            ma[prime[i]] -= y / prime[i];
            y /= prime[i];
        }
    } 
    
    vector<int> ans = {1};
    for(auto [num, cnt] : ma){
        ans = mul(ans, ksm(num, cnt));
    }

    vector<int> fans;
    for(int i = 0; i < 100 - sz(ans); i ++) fans.pb(0);
    for(int i = sz(ans) - 1; i >= 0; i --) fans.pb(ans[i]);
    
    for(int i = 0; i < 100; i ++){
        cout << fans[i];
        if((i + 1) % 10 == 0) cout << endl;
    }
    cout << endl;
    
    return ;
}

signed main(){
    HelloWorld;

    get_prime();

    int tt = 1; 
    if(HAVE_CASE) cin >> tt;
    while(tt --) solve();
    return 0;
}
