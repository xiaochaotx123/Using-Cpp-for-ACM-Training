int f[20][20];

void init(){
    for(int i = 1; i <= 12; i ++){
        for(int j = 0; j <= i; j ++){
            if(j == 0 || j == i) f[i][j] = 1;
            else f[i][j] = f[i - 1][j - 1] + f[i - 1][j];
        }
    }
}

void solve(){
    
    int n, r; cin >> n >> r;

    int ans = 1;
    for(int k = 0; k <= r; k ++){
        int num = 1;
        if((r - k) & 1) num = -1;
        num *= f[r][k];
        num *= pow(k, n);
        ans *= num;
    }

    cout << ans << endl;
    return ;
}

