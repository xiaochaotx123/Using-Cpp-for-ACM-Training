const int N = 11;
int n, m, k;
char a[N][N][N];
bool vis[N][N][N];

struct Node{
    int x, y, z;
};


int dx[] = {1, -1, 0, 0, 0, 0};
int dy[] = {0, 0, 1, -1, 0, 0};
int dz[] = {0, 0, 0, 0, 1, -1};

void solve(){
    
    cin >> k >> n >> m;
    cin.ignore();
    for(int i = 1; i <= k; i ++){
        for(int j = 1; j <= n; j ++){
            for(int z = 1; z <= m; z ++) cin >> a[j][z][i];
        }
        cin.ignore();
    }
    
    int sx, sy; cin >> sx >> sy;
    queue<Node> q;
    q.push({sx, sy, 1});
    vis[sx][sy][1] = 1;

    int ans = 0;
    while(q.size()){
        auto [x, y, z] = q.front();
        q.pop();
        ans ++;
        for(int i = 0; i < 6; i ++){
            int nx = x + dx[i], ny = y + dy[i], nz = z + dz[i];
            if(nx < 1 || nx > n || ny < 1 || ny > m || nz < 1 || nz > k) continue;
            if(a[nx][ny][nz] == '#') continue;
            if(vis[nx][ny][nz]) continue;
            vis[nx][ny][nz] = true;
            q.push({nx, ny, nz});
        }
    }

    cout << ans << endl;
    return ;
}
