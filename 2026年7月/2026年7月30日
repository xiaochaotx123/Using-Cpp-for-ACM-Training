void solve(){
    
    cin >> n;

    queue<PII> q;

    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= n; j ++){
            cin >> a[i][j];
            if(a[i][j] == 2){
                q.push({i, j});
                vis[i][j] = 1;
            }
            else if(a[i][j] == 0) vis[i][j] = 1;
        } 
