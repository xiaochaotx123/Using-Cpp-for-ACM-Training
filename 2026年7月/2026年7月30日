            if(nx < 1) nx = n;
            if(nx > n) nx = 1;
            if(ny < 1) ny = n;
            if(ny > n) ny = 1;
            if(vis[nx][ny]) continue;
            vis[nx][ny] = true;
            ans[nx][ny] = ans[x][y] + 1;
            q.push({nx, ny});
        }
