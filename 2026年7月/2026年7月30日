const int mod = 1007;

int ksm(int a, int b, int p){
    int sum = 1;
    while(b){
        if(b & 1) sum = (sum * a) % p;
        b >>= 1;
        a = (a * a) % p;
    }
    return sum;
}

void solve(){
    
    int m, n; cin >> m >> n;
    int sum1 = ksm(m, n, mod);
    int sum2 = m;
    sum2 = (sum2 * ksm(m - 1, n - 1, mod)) % mod;
    int ans = (sum1 - sum2 + mod) % mod;
    cout << ans << endl;
    return ;
}
