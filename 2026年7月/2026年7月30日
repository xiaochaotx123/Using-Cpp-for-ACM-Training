/*
https://www.matiji.net/exam/brushquestion/245/3181/1DC60EA6DF83A333301CFFE1407FBA59
*/
const int N = 10000 + 100;

int n, m;
int a[N];
map<PII, int> ma;

int ans = rinf;

void solve(){
    
    cin >> n >> m;
    for(int i = 1; i <= n; i ++) cin >> a[i];
    for(int i = 1; i <= m; i ++){
        int u, v; cin >> u >> v;
        ma[{u, v}] = 1;
        ma[{v, u}] = 1;
    }   

    int ans = inf;
    for(int i = 1; i <= n; i ++){
        for(int j = i + 1; j <= n; j ++){
            if(!ma.count({i, j})) continue;
            for(int k = j + 1; k <= n; k ++){
                if(!ma.count({i, k}) || !ma.count({j, k})) continue;
                ans = min(ans, a[i] + a[j] + a[k]);
            }
        }
    }
    cout << (ans == inf ? -1 : ans) << endl;

    return ;
}
