const int N = 100000 + 100;

map<PII, int> ma, fcnt, cost;
int n, s;
vector<int> adj[N];

int cnt[N];
int total_s;


void dfs(int u, int fa){
    for(int v : adj[u]){
        if(v == fa) continue;
        dfs(v, u);
        cnt[u] += cnt[v];
    }
    fcnt[{min(u, fa), max(u, fa)}] = cnt[u];
    return ;
}


struct cmp{
    bool operator() (const PII &a, const PII &b) const{
        int nex_a = a.first / 2;
        int sum1 = (a.first - nex_a) * a.second;
        
        int nex_b = b.first / 2;
        int sum2 = (b.first - nex_b) * b.second;

        return sum1 < sum2;
    }
};

void solve(){

    total_s = 0;
    ma.clear();
    fcnt.clear();
    cost.clear();

    cin >> n >> s;
    for(int i = 1; i <= n; i ++){
        adj[i].clear();
        cnt[i] = 0;
    }

    for(int i = 1; i <= n - 1; i ++){
        int u, v, w, c; cin >> u >> v >> w >> c;
        if(u > v) swap(u, v);
        adj[u].push_back(v);
        adj[v].push_back(u);
        ma[{u, v}] = w;
        cost[{u, v}] = c;
    }

    for(int i = 2; i <= n; i ++){
        if(adj[i].size() == 1) cnt[i] = 1;
    }
    dfs(1, -1);
    
    priority_queue<PII, vector<PII>, cmp> q1, q2;

    for(int u = 1; u <= n; u ++){
        for(int v : adj[u]){
            if(u > v) continue;
            total_s += ma[{u, v}] * fcnt[{u, v}];
            if(cost[{u, v}] == 1) q1.push({ma[{u, v}], fcnt[{u, v}]});
            else q2.push({ma[{u, v}], fcnt[{u, v}]});
        }
    }

    vector<int> pre1, pre2;
    
    int total_cost = 0;
    pre1.push_back(total_cost);
    pre2.push_back(total_cost);
    while(q1.size()){
        PII t = q1.top(); q1.pop();
        int now_cost = t.first, now_cnt = t.second;
        int nex_cost = t.first / 2;
        total_cost += (now_cost - nex_cost) * now_cnt;
        pre1.push_back(total_cost);
        if(nex_cost) q1.push({nex_cost, now_cnt});
    }
    total_cost = 0;
    while(q2.size()){
        PII t = q2.top(); q2.pop();
        int now_cost = t.first, now_cnt = t.second;
        int nex_cost = t.first / 2;
        total_cost += (now_cost - nex_cost) * now_cnt;
        pre2.push_back(total_cost);
        if(nex_cost) q2.push({nex_cost, now_cnt});        
    }

    int ans = inf;
    for(int i = 0; i < (int)pre1.size(); i ++){
        // total_s - pre1[i] - pre1[j] <= s;
        // pre1[i] + pre2[j] >= total_s - s;
        int l = 0, r = (int)pre2.size() - 1, pos = -1;
        while(l <= r){
            int mid = (l + r) / 2;
            if(pre1[i] + pre2[mid] >= total_s - s){
                pos = mid;
                r = mid - 1;
            }
            else l = mid + 1;
        }
        if(pos != -1) ans = min(ans, i + 2 * pos);
    }
    cout << ans << endl;
    return ;
}
