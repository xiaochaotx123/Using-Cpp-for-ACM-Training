/*
https://ac.nowcoder.com/acm/problem/260447
这样搜索是没问题的，但是我做的时候忽略了一个东西就是dfs(x / 2 + (1LL << 19), step + 1);
因为逆向搜索的过程中有两种：要么减去1，要么除以2
减去1，当x是奇数和偶数的时候都可以，所以是dfs(x - 1, step + 1)
除以2，只有当x是偶数的时候才可以，所以是dfs(x / 2, step + 1)

得思考为什么是逆向搜索的，因为多组测试，所以如果对于每一个n来说，我都执行加1或者乘2的操作，那么一定超时
所以我只搜索一遍，从目标点M开始搜索：
对于加1操作，就是(y + 1) % M = x % M, 那么k1 × M + y + 1 = k2 × M + x
所以y = (k2 - k2) × M + x - 1，所以下一步应该是搜索..., y = -M + x - 1, y = x - 1, y = M + x - 1, ...
所以因当是：
dfs(-M + x - 1, step + 1)
dfs(x - 1, step + 1)
dfs(M + x - 1, step + 1)

对于除2操作也是一样的：
dfs(x / 2 - (1LL << 19), step + 1)
dfs(x / 2, step + 1)
dfs(x / 2 + (1LL << 19), step + 1)

剪枝操作：
如果x为负数或者x大于2×M，直接跳过
如果当前的步数超过了20步，直接跳过
如果现在的step已经大于等于了ans[x]，直接跳过
*/
const int M = (1LL << 20);
int ans[2 * M + 100];

void dfs(int x, int step){
    if(x < 0 || x > 2 * M || step >= 21 || step >= ans[x]) return ;
    ans[x] = min(ans[x], step);
    dfs(-M + x - 1, step + 1);
    dfs(x - 1, step + 1);
    dfs(M + x - 1, step + 1);
    if(!(x & 1)){
        dfs(x / 2 - (1LL << 19), step + 1);
        dfs(x / 2, step + 1);
        dfs(x / 2 + (1LL << 19), step + 1);
    }
}

void solve(){

    int n; cin >> n;
    n %= M;
    cout << min(ans[n], 20LL) << endl;
    return ;
}

