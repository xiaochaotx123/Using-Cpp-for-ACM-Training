/*
https://vjudge.net/problem/CodeForces-1805D
首先求出树的直径两个端点A和B，对于树中的任意一个节点u来说，u到其他节点v的最远距离一定是max(dist(u, A), dist(u, B))
所以将k从n到1开始枚举，如果比i大，那么连通块的数量就减1
*/
const int N = 100000 + 100;
int dia1, dia2;

int n;
vector<int> adj[N];
int dist1[N], dist2[N];

void dfs(int u, int fa, int dep){
    dist1[u] = dep; 
    for(int v : adj[u]){
        if(v == fa) continue;
        dfs(v, u, dep + 1);
    }
}

void dfs1(int u, int fa, int dep){
    dist2[u] = dep; 
    for(int v : adj[u]){
        if(v == fa) continue;
        dfs1(v, u, dep + 1);
    }
}

bool cmp(PII a, PII b){
    return a.second > b.second;
}

void solve(){

    cin >> n;
    for(int i = 1; i <= n - 1; i ++){
        int u, v; cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }
    dfs(1, -1, 0);
    int max_dep = -1;
    for(int i = 1; i <= n; i ++){
        if(dist1[i] > max_dep){
            max_dep = dist1[i];
            dia1 = i;
        }
    }

    dfs(dia1, -1, 0);

    max_dep = -1;
    for(int i = 1; i <= n; i ++){
        if(dist1[i] > max_dep){
            max_dep = dist1[i];
            dia2 = i;
        }
    }

    dfs1(dia2, -1, 0);

    vector<PII> d(n + 10);
    for(int i = 1; i <= n; i ++){
        d[i] = {i, max(dist1[i], dist2[i])};
    }

    sort(d.begin() + 1, d.begin() + 1 + n, cmp);
    int ans = n, idx = 1;
    vector<int> fans;

    for(int i = n; i >= 1; i --){
        while(d[idx].second >= i){
            idx ++;
            ans --;
        }
        fans.push_back(min(n, ans + 1));
    }
    // cout << "-----------" << endl;

    // cout << dia1 << " " << dia2 << endl;
    // cout << "-----------" << endl;
    // for(int i = 1; i <= n; i ++) cout << d[i].fi << " " << d[i].se << endl;
    // cout << endl;

    reverse(fans.begin(), fans.end());
    for(int x : fans) cout << x << " ";
    cout << endl;
    return ;
}
