const int N = 100000 + 100;

int n, s;
vector<int> adj[N];
int cnt[N];
int total_s;
map<pair<int, int>, int> ma;
map<pair<int, int>, int> fcnt;

void dfs(int u, int fa){
    for(int v : adj[u]){
        if(v == fa) continue;
        dfs(v, u);
        cnt[u] += cnt[v];
    }
    fcnt[{min(u, fa), max(u, fa)}] = cnt[u];
    return ;
}

struct cmp{
    bool operator() (const PII &a, const PII &b) const{
        int nex_a = a.first / 2;
        int sum1 = (a.first - nex_a) * a.second;

        int nex_b = b.first / 2;
        int sum2 = (b.first - nex_b) * b.second;
        return sum1 < sum2;
    }
};

void solve(){

    total_s = 0;
    ma.clear();
    fcnt.clear();

    cin >> n >> s;
    for(int i = 1; i <= n; i ++){
        adj[i].clear();
        cnt[i] = 0;
    }

    for(int i = 1; i <= n - 1; i ++){
        int u, v, w; cin >> u >> v >> w;
        if(u > v) swap(u, v);
        ma[{u, v}] = w;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    for(int i = 2; i <= n; i ++){
        if(adj[i].size() == 1) cnt[i] = 1;
    }

    dfs(1, -1);

    priority_queue<PII, vector<PII>, cmp> q;
    for(int u = 1; u <= n; u ++){
        for(int v : adj[u]){
            if(u > v) continue;
            total_s += ma[{u, v}] * fcnt[{u, v}];
            q.push({ma[{u, v}], fcnt[{u, v}]});
        }
    }

    // cout << "total_s == " << total_s << endl;
    int ans = 0;
    while(total_s > s){
        PII t = q.top(); q.pop();
        int now_cost = t.first, now_cnt = t.second;
        int nex_cost = t.first / 2;

        // cout << "bug == " << total_s << " " << now_cost << " " << now_cnt << endl;
         
        total_s -= (now_cost - nex_cost) * now_cnt;
        ans ++;
        if(nex_cost) q.push({nex_cost, now_cnt});
    }

    cout << ans << endl;
    return ;
}
