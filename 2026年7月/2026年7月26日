const int N = 200000 + 100;

int n;
vector<int> adj[N];

int distA[N], distB[N];


void bfs(int start, int dist[]){
    fill(dist, dist + 1 + n, -1);
    queue<int> q;
    q.push(start);
    dist[start] = 0;
    while(q.size()){
        int u = q.front(); q.pop();
        for(int v : adj[u]){
            if(dist[v] == -1){
                dist[v] = dist[u] + 1;
                q.push(v);
            }
        }
    }
}

bool cmp(int a, int b){
    return a > b;
}

void solve(){

    cin >> n;
    for(int i = 1; i <= n - 1; i ++){
        int u, v; cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }    

    bfs(1, distA);
    int dia1 = 1;
    for(int i = 1; i <= n; i ++) if(distA[i] > distA[dia1]) dia1 = i;

    bfs(dia1, distA);
    int dia2 = 1;
    for(int i = 1; i <= n; i ++) if(distA[i] > distA[dia2]) dia2 = i;

    bfs(dia2, distB);

    vector<int> d(n + 10);
    for(int i = 1; i <= n; i ++) d[i] = max(distA[i], distB[i]);

    sort(d.begin() + 1, d.begin() + 1 + n, cmp);
    vector<int> fans;
    int idx = 1;
    for(int i = n; i >= 1; i --){
        while(idx <= n && d[idx] >= i){
            idx ++;
        }
        if(idx == 1) fans.push_back(n);
        else fans.push_back(n - idx + 2);
    }

    for(int i = n - 1; i >= 0; i --) cout << fans[i] << " ";
    cout << endl;

    return ;
}
