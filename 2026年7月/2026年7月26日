const int N = 200000 + 100;

int n, m;
vector<int> adj[N];
int a[N];
int vis[N];

struct Node{
    int u, num, state;
};


struct cmp{
    bool operator() (const Node &a, const Node &b) const{
        if(a.state != b.state) return a.state < b.state;
        else return a.num > b.num; 
    }
};

bool work(int root){

    int cnt = 0;
    priority_queue<Node, vector<Node>, cmp> q;
    q.push({root, 0, 1});

    while(q.size()){
        Node t = q.top();
        q.pop();
        if(!t.state) break;
        int u = t.u, num = t.num;

        if(vis[u] == root) continue;
        if(cnt >= num){
            vis[u] = root;
            cnt ++;
            for(int v : adj[u]){
                if(vis[v] == root) continue;
                q.push({v, a[v], 1});
            }
        } 
        else break;
    }
    if(cnt == n) return true;
    else return false;
}

void solve(){

    cin >> n >> m;
    for(int i = 1; i <= n; i ++){
        cin >> a[i];
        adj[i].clear();
        vis[i] = 0;
    }

    for(int i = 1; i <= m; i ++){
        int u, v; cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    for(int i = 1; i <= n; i ++){
        if(a[i] == 0 && vis[i] == 0){
            if(work(i)){
                cout << "YES" << endl;
                return ;
            }
        }
    }
    
    cout << "NO" << endl;

    return ;
}
