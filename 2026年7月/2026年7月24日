/*
https://codeforces.com/contest/1207/problem/C
*/
void solve(){

    int n, a, b; cin >> n >> a >> b;
    vector<char> s(n + 10);
    for(int i = 1; i <= n; i ++) cin >> s[i];
    vector<vector<int> > dp(n + 10, vector<int> (2, inf));
    dp[1][0] = a + b, dp[1][1] = 2 * a + b;
    for(int i = 2; i <= n; i ++){
        if(s[i] == '0'){
            dp[i][0] = min(dp[i - 1][0] + a + b, dp[i - 1][1] + 2 * a + 2 * b);
            dp[i][1] = min(dp[i - 1][0] + 2 * a + b, dp[i - 1][1] + a + 2 * b);
        }
        else dp[i][1] = dp[i - 1][1] + a + 2 * b;
    }
    // for(int i = 1; i <= n; i ++){
    //     cout << i << " " << dp[i][0] << " " << dp[i][1] << endl;
    // }
    cout << dp[n][0] + b << endl;

    return ;
}
