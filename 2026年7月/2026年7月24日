/*
https://codeforces.com/problemset/problem/1272/D
*/
void solve(){

    int n; cin >> n;
    vector<int> a(n + 10);
    vector<vector<int> > dp(n + 10, vector<int> (2, 0));    
    for(int i = 1; i <= n; i ++){
        dp[i][0] = 1;
    }

    for(int i = 1; i <= n; i ++) cin >> a[i];

    for(int i = 2; i <= n; i ++){
        if(a[i] > a[i - 1]){
            dp[i][0] = dp[i - 1][0] + 1;
            dp[i][1] = dp[i - 1][1] + 1;
            if(i >= 3 && a[i] > a[i - 2]) dp[i][1] = max(dp[i][1], dp[i - 2][0] + 1); 
        }
        else{
            dp[i][0] = 1;
            dp[i][1] = 1;
            if(i >= 3 && a[i] > a[i - 2]) dp[i][1] = max(dp[i][1], dp[i - 2][0] + 1); 
        }
    }
    int ans = 0;
    for(int i = 1; i <= n; i ++) ans = max({ans, dp[i][0], dp[i][1]});
    cout << ans << endl;

    return ;
}
