*/
void solve(){

    int n, q; cin >> n >> q;
    vector<int> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i];
    int max_num0 = 0, max_num1 = 0;
    for(int i = 1; i <= n; i ++){
        int now_num0 = max(a[i], max_num1 + a[i]);
        int now_num1 = max(0LL, max_num0 - a[i]);
        max_num0 = max(max_num0, now_num0);
        max_num1 = max(max_num1, now_num1);
    }
    cout << max(max_num0, max_num1) << endl;
    return ;
}
