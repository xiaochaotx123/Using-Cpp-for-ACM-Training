/*
https://codeforces.com/problemset/problem/706/C
*/
const int inf = 1000000000000000000;

void solve(){

    int n; cin >> n;
    vector<int> c(n + 10);
    vector<string> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> c[i];
    for(int i = 1; i <= n; i ++) cin >> a[i];
    vector<vector<int> > dp(n + 10, vector<int> (2, inf));

    dp[1][0] = 0, dp[1][1] = c[1];
    for(int i = 2; i <= n; i ++){
        string s1 = a[i - 1], s2 = a[i];
        string s3 = a[i - 1], s4 = a[i];
        reverse(s3.begin(), s3.end());
        reverse(s4.begin(), s4.end());
        if(s2 >= s1) dp[i][0] = min(dp[i][0], dp[i - 1][0]);
        if(s2 >= s3) dp[i][0] = min(dp[i][0], dp[i - 1][1]);

        if(s4 >= s1) dp[i][1] = min(dp[i][1], dp[i - 1][0] + c[i]);
        if(s4 >= s3) dp[i][1] = min(dp[i][1], dp[i - 1][1] + c[i]);
    }
    int ans = min(dp[n][0], dp[n][1]);
    if(ans == inf) cout << "-1" << endl;
    else cout << ans << endl;

    return ;
}
