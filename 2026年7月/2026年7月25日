/*
2026“钉耙编程”中国大学生算法设计暑期联赛（1）
Problem D. 搭积木
*/
const int N = 200000 + 100;
int n;
int p[N];

int find(int x){
    if(x != p[x]) p[x] = find(p[x]);
    return p[x];
}

struct Node{
    int A, B, id;
};

struct cmp{
    bool operator() (const Node &a, const Node &b) const{
        return a.A * b.B < a.B * b.A;
    }
};

void solve(){

    cin >> n;

    vector<int> a(n + 10), b(n + 10), f(n + 10);
    for(int i = 1; i <= n; i ++) p[i] = i;

    for(int i = 1; i <= n; i ++) cin >> a[i];
    for(int i = 1; i <= n; i ++) cin >> b[i];
    for(int i = 1; i <= n; i ++) cin >> f[i];

    priority_queue<Node, vector<Node>, cmp> q;
    for(int i = 1; i <= n; i ++) q.push({a[i], b[i], i});
    vector<int> vis(n + 10);
    int ans = 0;
    while(q.size()){
        Node t = q.top(); q.pop();
        int u = t.id, fu = find(u);
        
        if(vis[u] || !f[u]) continue;
        vis[u] = 1;
        if(u != fu) continue;
        int v = f[u], fv = find(v);
        ans += a[fu] * b[fv];

        a[fv] += a[fu];
        b[fv] += b[fu];
        p[fu] = fv;
        q.push({a[fv], b[fv], fv});
    }
    cout << ans << endl;
    return ;
}
