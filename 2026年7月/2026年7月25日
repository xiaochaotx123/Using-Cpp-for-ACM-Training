/*
https://codeforces.com/problemset/problem/453/A
有一个m面的骰子，骰子的第一个面有一个点，第二个面有二个点，第三个面有三个点，...，第m个面有m个点。掷出骰子每个面出现的概率相同都是1/m，每次掷出骰子都是独立的
求掷出骰子n次后可能得到的最大点数

因为概率相同并且实践独立，所以设掷出的最大点数为k
那么掷出n次骰子最大点数 小于等于 k的情况有k^n种，但是其中可能不包含k，比如全是1这种情况
所以只需要再减去小于等于k-1的情况，所以掷出n次骰子且出现的最大点数为k的情况有k^n - (k-1)^n种，这是情况数
那么概率就是(k/m)^n - ((k-1)/m)^n, 然后乘以当前的k点数就是期望值
*/
double ksm(double a, int b){
    double sum = 1.0;
    while(b){
        if(b & 1) sum = (sum * a);
        b >>= 1;
        a = (a * a);
    }
    return sum;
}

void solve(){

    int m, n; cin >> m >> n;
    double ans = 0.0;
    for(int i = 1; i <= m; i ++){
        double p1 = ksm(i * 1.0 / m, n);
        double p2 = ksm((i - 1) * 1.0 / m, n);
        ans += (p1 - p2) * i;
    }
    cout << fixed << setprecision(12) << ans << endl;
    return ;
}
