/*
https://codeforces.com/problemset/problem/1753/C
题目的意思是给定一个二进制数组（只包含0和1）
然后可以执行一次操作：随机选择两个下标i < j，如果a[i] > a[j]就交换a[i]与a[j]，求预计的期望操作次数使得a数组有序

设a数组中有k个0，那么就有n - k个1，最终的目标状态就是a数组前面有k个0，后面就是n - k个1

现在假设前面k个位置有cnt个1，那么同样的，后面n - k个位置有cnt个0，我现在如果选择的是前面的1以及后面的0，那么交换就能将cnt减1
这样的对数是cnt × cnt对，一共有C(n, 2)对数，所以选中的概率为cnt × cnt / C(n, 2)
《
    一个基本结论是几何分布的概率为期望结论：
    假设你反复做同一个实验，每次实验成功概率是 p，失败概率是 1-p。各次实验之间的结果相互独立。你一直做，直到第一次成功为止。
    问：你期望要做多少次才能第一次成功？
    这就是经典的几何分布。
    答案是 E = 1 / P
》
所以我选中的概率是cnt × cnt / C(n, 2)，那么期望操作数量是C(n, 2) / cnt × cnt
所以答案直接是i从1到cnt累加 C(n, 2) / i × i
*/
const int mod = 998244353;

int ksm(int a, int b, int p){
    int sum = 1;
    a %= mod;
    while(b){
        if(b & 1) sum = (sum * a) % p;
        b >>= 1;
        a = (a * a) % p;
    }
    return sum;
}

void solve(){

    int n; cin >> n;
    vector<int> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i];
    int total_zero = 0, cnt = 0;
    for(int i = 1; i <= n; i ++) total_zero += (a[i] == 0);
    for(int i = 1; i <= total_zero; i ++) cnt += (a[i] == 1);
    int total_pair = n * (n - 1) / 2;
    total_pair %= mod;
    int ans = 0;
    for(int i = 1; i <= cnt; i ++){
        int sum = total_pair * ksm(i * i, mod - 2, mod) % mod;
        ans = (ans + sum) % mod;
    }
    cout << ans << endl;
    return ;
}
