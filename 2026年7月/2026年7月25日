/*
https://codeforces.com/problemset/problem/1265/E
题目意思是由n面镜子，对于第i面竞赛，询问它我今天是否漂亮，它由 p[i] / 100的概率回复漂亮，有(100 - p[i]) / 100的概率回复不漂亮
现在需要从第一面镜子开始询问。每天，如果询问的是第i面镜子：
    如果第i面镜子回复的是漂亮，这种情况下，如果是最后一面镜子即i = n，那么就会停止询问；否则第二天会继续询问第i + 1面镜子
    如果第i面镜子回复的是不漂亮，那么第二天又需要从第一面镜子开始询问
求停止询问的期望天数

设dp[i]表示询问到第i面镜子的期望询问天数
那么考虑dp[i]如何转移而来，对于第i天
    如果第i天镜子回复漂亮，那么dp[i] += (dp[i - 1] + 1) * (p[i] / 100)
    如果第i天镜子回复不漂亮，那么dp[i] += (dp[i - 1] + 1 + dp[i]) * ((100 - p[i]) / 100)
所以dp[i] = (dp[i - 1] + 1) * 100 / p[i]
*/

const int mod = 998244353;

int ksm(int a, int b, int p){
    int sum = 1;
    a %= mod;
    while(b){
        if(b & 1) sum = (sum * a) % p;
        b >>= 1;
        a = (a * a) % p;
    }
    return sum;
}

void solve(){

    int n; cin >> n;
    int ans = 0;
    for(int i = 1; i <= n; i ++){
        int p; cin >> p;
        ans = (((ans + 1) * 100) % mod * ksm(p, mod - 2, mod)) % mod;
    }
    cout << ans << endl;
    return ;
}
