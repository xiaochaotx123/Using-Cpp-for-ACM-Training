/*
https://codeforces.com/problemset/problem/280/C
给定一棵以1为根的树，每次操作随机等概率选择一个仍然存在的节点u，然后将u以及u的子树全部删除
求将整棵树删除的期望操作次数

直接考虑每一个节点删除的次数的期望E(cnt[i])，那么答案就是所有的节点的E(cnt[i])累加
但是对于一个节点删除的次数的期望要么为0次，要么为1次，所以E(cnt[i])就等于删除该节点的概率为p[i]
现在考虑任意一个操作序列，如果能够删除i节点的条件是i节点的所有祖先都没有删除，也就是说i节点要在所有祖先之前删除，这样才能删除i节点
而任意的操作顺序中，对于i节点，只考虑根节点1到i的路径。从根到i经过的节点数，就是i的深度，记作depth[i]，这条路径上有depth[i]个节点
因为排列是随机的，所有在depth[i]个节点中，首先访问到的节点是第i个节点的概率就是 1 / dpeth[i]
最终的答案就是每个节点的1 / depth[i]之和！
*/
const int N = 100000 + 100;

int n, depth[N];
vector<int> adj[N];

void dfs(int u, int fa, int dep){
    depth[u] = dep;
    for(int v : adj[u]){
        if(v == fa) continue;
        dfs(v, u, dep + 1);
    }
}

void solve(){

    cin >> n;
    for(int i = 1; i <= n - 1; i ++){
        int u, v; cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }    
    dfs(1, -1, 1);
    double ans = 0.0;
    for(int i = 1; i <= n; i ++){
        ans += 1.0 / depth[i];
    }
    cout << fixed << setprecision(20) << ans << endl;
    return ;
}
