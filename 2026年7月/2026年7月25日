/*
2026“钉耙编程”中国大学生算法设计暑期联赛（1）
Problem F. 开关灯

虽然大部分的代码都是打表过了，但是仍然需要思考正确的逻辑
如果现在一共有c个连通块，且现在打开的是第i盏灯，那么就会获得c×a[i]分
分开计算每个位置i被点亮时对答案的贡献，等价于求出当前连通块个数c的期望，然后直接乘以a[i]即可就是该位置的贡献
一个经典的转化：连通块的数量 = 灯亮的个数 - 相邻灯的个数；也就是说每有一堆相邻灯同时两者，就会让连通块数量减少1
令c = |S| - |e(S)|，其中|S|表示一共亮了多少盏灯，|e(S)|表示相邻两盏灯都同时被点亮的对数
E(c) = E(|S|) - E(|e(S)|)

求E(|S|)：一共亮了多少盏灯的期望，现在一定是点亮了第i盏灯，所以+1，对于其他n-1盏灯，都有二分一的概率点亮，所以
E(|S|) = 1 + (n - 1) / 2 =  (n + 1) / 2

求E(|e(S)|)：现在点亮了第i盏灯，点亮的所有灯中，相邻的两盏灯同时亮着的期望
现在分为两种情况讨论：相邻的灯中包含i的情况与不包含i的情况
包含i的情况：那么对于i > 1的时候，都可以有一个相邻的情况(i - 1, i)；对于i < n的时候，都可以由一个相邻的情况(i + 1, i)，相邻的灯亮的概率都是1/2
    所以这种情况的期望是([1 < i] + [i < n]) / 2
不包含i的情况，设i左边相邻的两位位置为a和b，所以如果点亮i的时候，a和b都已经亮了，所有一共有6种情况：
    (a,b,i), (b,a,i), (a,i,b), (b,i,a), (i,a,b), (i,b,a)，其中只有(a,b,i)和(b,a,i)是正确的，那么此时的概率为1/3
    因为包含i的相邻对数有([1 < i] + [i < n]), 一共有n-1个相邻对
    所以这种情况的期望就是((n - 1) - ([1 < i] + [i < n])) / 3

所以对于i来说的贡献就是 ((n + 1) / 2 - (([1 < i] + [i < n]) / 2 + ((n - 1) - ([1 < i] + [i < n])) / 3)) × a[i]
化简为 (n + 5 - ([1 < i] + [i < n])) / 6  × a[i]
*/
const int mod = 998244353;

int ksm(int a, int b, int p){
    int sum = 1;
    while(b){
        if(b & 1) sum = (sum * a) % p;
        b >>= 1;
        a = (a * a) % p;
    }
    return sum;
}

void solve(){

    int n; cin >> n;
    vector<int> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i];
    int ans = 0, niyuan = ksm(6, mod - 2, mod);
    for(int i = 1; i <= n; i ++){
        int sum = (niyuan * (n + 5 - (i > 1) - (i < n))) % mod;
        ans = (ans + a[i] * sum) % mod;
    }
    cout << ans << endl;

    return ;
}
