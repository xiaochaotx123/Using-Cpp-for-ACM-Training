/*
2026“钉耙编程”中国大学生算法设计暑期联赛（1）
Problem J. 游戏
*/
void solve(){

    int n; cin >> n;
    vector<int> a(n + 10), b, c;
    for(int i = 1; i <= n; i ++) cin >> a[i];
    int sum = 0, m = n / 2;
    if(m == 0){
        cout << "NO" << endl;
        return ;
    }    
    for(int i = 1; i <= m; i ++){
        sum += a[i];
        b.push_back(sum);
    }

    sum = 0;
    if(n & 1){
        for(int i = n; i >= m + 2; i --){
            sum += a[i];
            c.push_back(sum);
        }
    }
    else{
        for(int i = n; i >= m + 2; i --){
            sum += a[i];
            c.push_back(sum);
        }
    }
    reverse(b.begin(), b.end());
    reverse(c.begin(), c.end());
    if(b > c) cout << "YES" << endl;
    else cout << "NO" << endl;
    return ;
}
