void solve(){

    
    int n, f; cin >> n >> f;
    int ans = 0;
    if(n > f){
        ans += (n - f) * f;
        n = f;
    }
    
    ans += n * f;
    for(int i = 1; i <= n; i ++){
        int l = i, r = min(n, f / (f / i));
        int x = f / i;
        int sum = (l + r) * (r - l + 1) / 2 * x;
        ans -= sum;
        i = r;
    }
    cout << ans << endl;
    return ;
}
