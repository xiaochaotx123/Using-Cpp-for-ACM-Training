const int MOD = 998244353;

int power(int base, int p) {
    int res = 1;
    while (p) {
        if (p & 1)
            res = res * base % MOD;
        base = base * base % MOD;
        p >>= 1;
    }
    return res;
}

void ylh_() {
    int w, l;
    cin >> w >> l;
    int ans = (power(w, l) + l - 1) % MOD;
    cout << ans << '\n';
