*/
map<int, int> ma, rma;
int idx;


const int N = 1000000;
struct Node{
    int l, r;
    int cnt;
}tr[4 * N];

void push_up(int u){
    tr[u].cnt = (tr[u << 1].cnt + tr[u << 1 | 1].cnt);
}

void build(int u, int l, int r){
    if(l == r){
        tr[u] = {l, r, 0};
        return ;
    }
    else{
        tr[u] = {l, r, 0};
        int mid = (tr[u].l + tr[u].r) >> 1;
        build(u << 1, l, mid);
        build(u << 1 | 1, mid + 1, r);
    }
}

void modify(int u, int x){
    if(tr[u].l == tr[u].r){
        tr[u].cnt ++;
        return ;
    }
    else{
        int mid = (tr[u].l + tr[u].r) >> 1;
        if(x <= mid) modify(u << 1, x);
        else modify(u << 1 | 1, x);
        push_up(u);
    }
}

void erase_modify(int u, int x){
    if(tr[u].l == tr[u].r){
        tr[u].cnt --;
        return ;
    }
    else{
        int mid = (tr[u].l + tr[u].r) >> 1;
        if(x <= mid) erase_modify(u << 1, x);
        else erase_modify(u << 1 | 1, x);

        push_up(u);
    }
}

int query(int u, int x){
    if(tr[u].l == tr[u].r) return tr[u].l;
    else{
        if(x <= tr[u << 1].cnt) return query(u << 1, x);
        else return query(u << 1 | 1, x - tr[u << 1].cnt); 
    }
}

void solve(){

    
    int n, q; cin >> n >> q;
    vector<int> a(n + 10), b;
    for(int i = 1; i <= n; i ++){
        cin >> a[i];
        b.pb(a[i]);
    }
    sort(b.begin(), b.end());
    for(int x : b){
        if(ma.count(x) == 0){
            ma[x] = ++ idx;
            rma[idx] = x;
        }
    }

    int len = 0;

    vector<PII> query_ans;
    while(q --){
        int l, r; cin >> l >> r;
        query_ans.pb({l, r});
        len = r - l+ 1;
    }

    build(1, 1, n);
    for(int i = 1; i < len; i ++) modify(1, ma[a[i]]);

    vector<int> ans(n + 10);
    for(int i = len; i <= n; i ++){
        modify(1, ma[a[i]]);
        ans[i] = rma[query(1, len / 2 + 1)];
        erase_modify(1, ma[a[i - len + 1]]);
    }
    
    for(auto [l, r] : query_ans) cout << ans[r] << endl;
    return ;
}
