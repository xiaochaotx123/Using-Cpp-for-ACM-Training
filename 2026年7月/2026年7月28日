        if(prime[i] + m > n) break;
        if(!vis[prime[i] + m]) ans.pb({prime[i], prime[i] + m});
    }
    if(!sz(ans)) cout << "empty" << endl;
    else{
        for(auto [x, y] : ans) cout << x << " " << y << endl;
    }
