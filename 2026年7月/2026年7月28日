int vis[N];
int phi[N];

void euler(){
    phi[1] =1 ;
    for(int i = 2; i < N; i ++){
        if(!vis[i]){
            prime[++ idx] = i;
            phi[i] = i - 1;
        }
        for(int j = 1; j <= idx && prime[j] <= N / i; j ++){
            vis[i * prime[j]] = 1;
            if(i % prime[j] == 0){
                phi[i * prime[j]] = phi[i] * prime[j];
                break;
            }
            else phi[i * prime[j]] = phi[i] * (prime[j] - 1);
        }
    }
}

