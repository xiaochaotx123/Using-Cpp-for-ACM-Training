/*
2026“钉耙编程”中国大学生算法设计暑期联赛（3）
1009 Six Grade

显然一定会存在环，如果一个环上有k个点，那么期望就是k/2；对于不是环上的点期望就是1
因为环上点的度数永远是2，所以可以直接使用队列不断的删除度数即可；当度数为0时，说明不是环上的点，cnt ++即可
那么n - cnt就是所有环上的点了
*/
const int N = 1000000 + 100;
const int mod = 998244353;
int n;
vector<int> adj[N];

int ksm(int a, int b, int p){
    int sum = 1;
    while(b){
        if(b & 1) sum = (sum * a) % p;
        b >>= 1;
        a = (a * a) % p;
    }
    return sum;
}

void solve(){

    cin >> n;
    for(int i = 1; i <= n; i ++) adj[i].clear();
    vector<int> deg(n + 10);
    for(int i = 1; i <= n; i ++){
        int u, v; cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
        deg[u] ++;
        deg[v] ++;
    }     
    int cnt = 0;
    queue<int> q;
    for(int i = 1; i <= n; i ++){
        if(deg[i] == 1) q.push(i);
    }
    while(q.size()){
        int u = q.front(); q.pop(); 
        cnt ++;
        for(int v : adj[u]){
            if(-- deg[v] == 1) q.push(v);
        }
    }
    cout << (cnt + (n - cnt) * ksm(2, mod - 2, mod)) % mod << endl;
    return ;
}
