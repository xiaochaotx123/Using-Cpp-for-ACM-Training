void get_prime(){
    for(int i = 2; i < N; i ++){
        if(!vis[i]) prime[++ idx] = i;
        for(int j = 1; j <= idx && prime[j] <= N / i; j ++){
            vis[i * prime[j]] = true;
            if(i % prime[j] == 0) break;
        }
    }
}

void solve(){
    
    vector<PII> ans;
    int n, m; cin >> n >> m;
