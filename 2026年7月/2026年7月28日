/*
2026“钉耙编程”中国大学生算法设计暑期联赛（3）
1003 Best

因为现在的一个a[i]大于等于前面所有的值的和，那么值的和是不断的翻倍过程
就拿最小的例子来说：如果a[1] = 1
那么a[2]最小为1，a[3]最小为a[1]+a[2]=2，a[4]最小为a[1]+a[2]+a[3]=4，a[5]最小为8，a[6]最小为16.....这是最小的情况：
当长度为66的时候，a[66]最小为2的64次方，已经大于的最大范围1e18，所以序列的最大长度不会超过66

定义dp[i]表示长度为i的时候最后一个数最小为多少
*/
void solve(){

    int n; cin >> n;
    vector<int> a(n + 10), dp(66, inf);
    for(int i = 1; i <= n; i ++) cin >> a[i];
    dp[0] = 0;

    for(int i = 1; i <= n; i ++){
        for(int j = 64; j >= 1; j --){
            if(a[i] >= dp[j - 1]) dp[j] = min(dp[j], dp[j - 1] + a[i]);
        }
    }

    for(int i = 64; i >= 1; i --){
        if(dp[i] != inf){
            cout << i << endl;
            return ;
        }
    }

    return ;
}
