}

int lcm(int a, int b){
    return a / gcd(a, b) * b;
}
void solve(){

    int n; cin >> n;
    string s1, s2; cin >> s1 >> s2;
    int n1 = (int)s1.size(), n2 = (int)s2.size();
    int len = lcm(n1, n2);
    string s11 = "", s22 = "";
    for(int i = 1; i <= len / n1; i ++) s11 += s1;
    for(int i = 1; i <= len / n2; i ++) s22 += s2;
    
    int cnt1 = 0, cnt2 = 0;
    for(int i = 0; i < len; i ++){
        if(s11[i] == 'R'){
            if(s22[i] == 'P') cnt2 ++;
            if(s22[i] == 'S') cnt1 ++;
        }
        else if(s11[i] == 'P'){
            if(s22[i] == 'R') cnt1 ++;
            if(s22[i] == 'S') cnt2 ++;
        }
        else{
            if(s22[i] == 'R') cnt2 ++;
            if(s22[i] == 'P') cnt1 ++;
        }
    }
    int fans1 = (n / len) * cnt1, fans2 = (n / len) * cnt2;
    n %= len;
    for(int i = 0; i < n; i ++){
        if(s11[i] == 'R'){
            if(s22[i] == 'P') fans2 ++;
            if(s22[i] == 'S') fans1 ++;
        }
        else if(s11[i] == 'P'){
            if(s22[i] == 'R') fans1 ++;
            if(s22[i] == 'S') fans2 ++;
        }
        else{
            if(s22[i] == 'R') fans2 ++;
            if(s22[i] == 'P') fans1 ++;
        }        
    }
    cout << fans2 << " " << fans1 << endl;
    return ;
}
