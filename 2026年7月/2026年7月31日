const int N = 100000 + 100;
const int mod = 1000000000 + 7;

int dp[N][3][3];
// 0表示a，1表示b，2表示c
// dp[i][j][k]表示到第i个位置时，第i个位置是j且第i-1个位置是k的方案数

void solve(){
    
    int n; cin >> n;
    if(n == 1) cout << 3 << endl;
    else if(n == 2) cout << 9 << endl;
    if(n <= 2) return ;

    for(int i = 0; i < 3; i ++){
        for(int j = 0; j < 3; j ++){
            if(i == j) dp[3][i][j] = 2;
            else dp[3][i][j] = 3;   
        }
    }

    for(int i = 4; i <= n; i ++){
        dp[i][0][0] = (dp[i - 1][1][0] + dp[i - 1][2][0]) % mod;
        dp[i][0][1] = (dp[i - 1][0][0] + dp[i - 1][1][0] + dp[i - 1][2][0]) % mod;
        dp[i][0][2] = (dp[i - 1][0][2] + dp[i - 1][1][2] + dp[i - 1][2][2]) % mod;

        dp[i][1][0] = (dp[i - 1][0][1] + dp[i - 1][1][1] + dp[i - 1][2][1]) % mod;
        dp[i][1][1] = (dp[i - 1][0][1] + dp[i - 1][2][1]) % mod;
        dp[i][1][2] = (dp[i - 1][0][1] + dp[i - 1][1][1] + dp[i - 1][2][1]) % mod;

        dp[i][2][0] = (dp[i - 1][0][2] + dp[i - 1][1][2] + dp[i - 1][2][2]) % mod;
        dp[i][2][1] = (dp[i - 1][0][2] + dp[i - 1][1][2] + dp[i - 1][2][2]) % mod;
        dp[i][2][2] = (dp[i - 1][0][2] + dp[i - 1][1][2]) % mod;
    }    
    
    int ans = 0;
    for(int i = 0; i < 3; i ++){
        for(int j = 0; j < 3; j ++) ans = (ans + dp[n][i][j]) % mod;
    }
    cout << ans << endl;
    return ;
}
