/*
https://www.matiji.net/exam/brushquestion/252/3181/1DC60EA6DF83A333301CFFE1407FBA59
*/
PII manacher(string s){
    string t = "#";
    for(int i = 0; i < sz(s); i ++){
        t += s[i];
        t += "#";
    }
    int m = sz(t);
    vector<int> p(m + 10);
    int C = 0, R = 0;
    int center_idx = 0, max_len = 0;
    for(int i = 0; i < m; i ++){
        int mirror = 2 * C - i;
        if(i < R) p[i] = min(R - i, p[mirror]);
        while(i + p[i] + 1 < m && i - p[i] - 1 >= 0 && t[i + p[i] + 1] == t[i - p[i] - 1]) p[i] ++;
        if(i + p[i] > R) R = i + p[i], C = i;
        if(p[i] > max_len) max_len = p[i], center_idx = i;
    }
    int l = (center_idx - max_len) / 2;
    int r = (center_idx + max_len) / 2 - 1;
    return {l, r};
}
void solve(){
    
    string s; getline(cin, s);
    PII ans = manacher(s);
    cout << ans.se - ans.fi + 1 << endl;
    return ;
}
