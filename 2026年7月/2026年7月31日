    if(cnt == n){
        ans = min(ans, dist + d[u][1]);
        return ;        
    }

    for(int i = 2; i <= n; i ++){
        if(vis[i]) continue;
        vis[i] = true;
        dfs(i, cnt + 1, dist + d[u][i]);
        vis[i] = false;
    }
}

void solve(){
    
    cin >> n;
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= n; j ++) cin >> d[i][j];
    }    

    dfs(1, 1, 0);
    cout << ans << endl;
