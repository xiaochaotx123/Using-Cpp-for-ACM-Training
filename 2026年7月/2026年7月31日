const int N = 100 + 10;
int n;
char a[N][N];


bool check(int x1, int y1, int x2, int y2){
    int cnt = 0;
    if(a[x1][y1] == 'B') return false;
    if(a[x1][y1] == '*') cnt ++;

    if(a[x2][y2] == 'B') return false;
    if(a[x2][y2] == '*') cnt ++;
    
    if(x1 + y2 - y1 < 1 || x1 + y2 - y1 > n) return false;
    if(y1 + x1 - x2 < 1 || y1 + x1 - x2 > n) return false;
    if(a[x1 + y2 - y1][y1 + x1 - x2] == 'B') return false;
    if(a[x1 + y2 - y1][y1 + x1 - x2] == '*') cnt ++;

    if(x2 + y2 - y1 < 1 || x2 + y2 - y1 > n) return false;
    if(y2 + x1 - x2 < 1 || y2 + x1 - x2 > n) return false;
    if(a[x2 + y2 - y1][y2 + x1 - x2] == 'B') return false;
    if(a[x2 + y2 - y1][y2 + x1 - x2] == '*') cnt ++;    

    if(cnt <= 1) return true;
    else return false;
}

void solve(){
    
    cin >> n;
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= n; j ++) cin >> a[i][j];
    }    

    int ans = 0;
    for(int x1 = 1; x1 <= n; x1 ++){
        for(int y1 = 1; y1 <= n; y1 ++){
            for(int x2 = x1; x2 <= n; x2 ++){
                for(int y2 = y1; y2 <= n; y2 ++){
                    if(x2 == x1 && y2 == y1) continue;
                    if(check(x1, y1, x2, y2)){
                        int sum = (x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1);
                        ans = max(ans, sum);
                    }
                }
            }
        }
    }
    cout << ans << endl;
    return ;
