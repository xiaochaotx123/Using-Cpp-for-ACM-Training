*/
int a[10][10];

int dx[] = {0, 0, 1, -1};
int dy[] = {1, -1, 0, 0};

void modify(vector<vector<int > > &b, int x, int y){
    for(int i = 0; i < 4; i ++){
        int nx = x + dx[i], ny = y + dy[i];
        if(nx < 1 || nx > 5 || ny < 1 || ny > 5) continue;
        b[nx][ny] ^= 1;
    }    
    b[x][y] ^= 1;
}

int work(int start_state){

    int res = 0;
    vector<vector<int> > b(10, vector<int> (10));
    for(int i = 1; i <= 5; i ++){
        for(int j = 1; j <= 5; j ++) b[i][j] = a[i][j];
    }
    for(int i = 0; i < 5; i ++){
        if((start_state >> i) & 1){
            modify(b, 1, i + 1);
            res ++;
        }
    }
    for(int i = 2; i <= 5; i ++){
        for(int j = 1; j <= 5; j ++){
            if(!b[i - 1][j]){
                modify(b, i, j);
                res ++;
                if(res > 6) break;
            }
        }
        if(res > 6) break;
    }
    if(res > 6) res = inf;
    for(int j = 1; j <= 5; j ++){
        if(!b[5][j]){
            res = inf;
            break;
        }
    }
    
    return res;
}
void solve(){
    
    for(int i = 1; i <= 5; i ++){
        for(int j = 1; j <= 5; j ++) cin >> a[i][j];
    }   
    
    int ans = inf;
    for(int i = 0; i < (1LL << 5); i ++){
        ans = min(ans, work(i));
    }

    if(ans == inf) cout << "-1" << endl;
    else cout << ans << endl;
    return ;
}
