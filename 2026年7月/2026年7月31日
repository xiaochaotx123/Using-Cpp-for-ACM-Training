        int u = q.top(); q.pop();
        ans.pb(u);
        for(int v : adj[u]){
            if(-- deg[v] == 0) q.push(v); 
        }
    }
    if(sz(ans) == n){
        for(int i = n - 1; i >= 0; i --) cout << ans[i] << " ";
        cout << endl;
    }
    else cout << "Impossible!" << endl;
    return ;
}
