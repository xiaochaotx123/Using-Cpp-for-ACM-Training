void solve(){
    
    int x; cin >> x;
    vector<PII> ans;
    for(int i = 1; i <= x / 2; i ++){
        int L = i, R = -1;
        int l = i, r = x;
        while(l <= r){
            int mid = (l + r) / 2;
            int sum = (L + mid) * (mid - L + 1) / 2;
            if(sum <= x){
                R = mid;
                l = mid + 1;
            }
            else r = mid - 1;
        }
        int sum = (L + R) * (R - L + 1) / 2;
        if(sum == x) ans.pb({L, R});
    }
    if(sz(ans)) for(auto [l, r] : ans) cout << l << " " << r << endl;
    else cout << "No" << endl;
    return ;
}
