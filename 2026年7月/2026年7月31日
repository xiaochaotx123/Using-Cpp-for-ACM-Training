void solve(){
    
    int n, m; cin >> n >> m;
    map<PII, int> ma;


    vector<vector<int> > adj(n + 10);
    for(int i = 1; i <= m; i ++){
        int u, v; cin >> u >> v;
        if(u > v) swap(u, v);
        if(ma.count({u, v})) continue;
        ma[{u, v}] = 1;  
        adj[u].pb(v);
        adj[v].pb(u);
    }
    int start; cin >> start;
    queue<PII> q;
    vector<int> vis(n + 10);
    q.push({start, 0});

    int ans = rinf;
    vis[start] = 1;
    while(q.size()){
        PII now = q.front(); q.pop();
        int u = now.fi, dist = now.se;

        ans = max(ans, dist);
        for(int v : adj[u]){
            if(vis[v]) continue;
            vis[v] = true;
            q.push({v, dist + 1});
        }
    }

    cout << ans << endl;
    return ;
}
