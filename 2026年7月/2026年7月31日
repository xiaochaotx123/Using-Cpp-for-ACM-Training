                int l = i, r = i + sz(s[a[2]]) - 1;
                ull now_hash = get_hash(l, r, a[1]);
                if(now_hash == hash_sum){
                    len1 = sz(s[a[2]]);
                    break;
                }
            }            
        }

        if(sz(s[a[2]]) <= sz(s[a[3]])){
            ull hash_sum = get_hash(1, sz(s[a[2]]), a[2]);
            for(int i = 1; i <= sz(s[a[3]]) - sz(s[a[2]]) + 1; i ++){
                int l = i, r = i + sz(s[a[2]]) - 1;
                ull now_hash = get_hash(l, r, a[3]);
                if(now_hash == hash_sum){
                    len1 = sz(s[a[2]]);
                    break;
                }
            }
        }
        else{
            ull hash_sum = get_hash(1, sz(s[a[3]]), a[3]);
            for(int i = 1; i <= sz(s[a[2]]) - sz(s[a[3]]) + 1; i ++){
                int l = i, r = i + sz(s[a[3]]) - 1;
                ull now_hash = get_hash(l, r, a[2]);
                if(now_hash == hash_sum){
                    len2 = sz(s[a[3]]);
                    break;
                }
            }            
        }        
        // if(a[1] == 2 && a[2] == 1 && a[3] == 3) cout << len1 << " " << len2 << endl;
        ans = min(ans, sz(s[1]) + sz(s[2]) + sz(s[3]) - len1 - len2);
        return ;
    }

    for(int i = 1; i <= 3; i ++){
        if(vis[i]) continue;
        vis[i] = 1;
        a[x] = i;
        dfs(x + 1);
        vis[i] = 0;
    }
}
