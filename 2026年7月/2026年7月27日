bool check(string s1, string s2){
    int n = (int)s1.size(), m = (int)s2.size();
    if(n != m){
        if(n > m) return true;
        else return false;
    }
    for(int i = 0; i < n; i ++){
        if(s1[i] != s2[i]){
            if(s1[i] > s2[i]) return true;
            else return false;
        }
    }
}
vector<int> sub(string s1, string s2){
    if(s1 == s2) return {0};
    bool ok = check(s1, s2);

    if(!ok) swap(s1, s2);
    vector<int> v1, v2;
    int n = (int)s1.size(), m = (int)s2.size();
    for(int i = n - 1; i >= 0; i --) v1.push_back((int)(s1[i] - '0'));
    for(int i = m - 1; i >= 0; i --) v2.push_back((int)(s2[i] - '0'));
    vector<int> v(max(n, m), 0);
    for(int i = 0; i < max(n, m); i ++){
        if(i < n) v[i] += v1[i];
        if(i < m) v[i] -= v2[i];
    }

    for(int i = 0; i < (int)v.size(); i ++){
        if(v[i] < 0){
            v[i] += 10;
            v[i + 1] -= 1;
        }
    }
    while(v.size() > 1 && v.back() == 0) v.pop;
    reverse(v.begin(), v.end());
    if(!ok) v[0] *= -1;
    return v;
}
