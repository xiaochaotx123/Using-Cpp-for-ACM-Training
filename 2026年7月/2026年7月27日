    int cnt1 = 0, cnt2 = 0;
    for(int i = 0; i < (int)s.size(); i ++){
        if('A' <= s[i] && s[i] <= 'Z'){
            if(cnt2 == 0) cnt1 = 1;
            else cnt1 = 2;
        }
        else{
            if(cnt1 == 0) cnt2 = 1;
            else cnt2 = 2;
        }
    }

    if(cnt1 == 2 && cnt2 == 2){
        string s1 = "";
        for(int i = (int)s.size() - 1; i >= 0; i --){
            if('0' <= s[i] && s[i] <= '9') s1 += s[i];
            else break;
        }
        reverse(s1.begin(), s1.end());
        int num = 0;
        for(int i = 0; i < (int)s1.size(); i ++){
            num = num * 10 + (s1[i] - '0');
        }
        string ans = "";
        while(num){
            num --;
            char sh = (num % 26) + 'A';
            ans += sh;
            num /= 26;
        }
        if(ans.size()) ans[0] += 1;
        else ans += "A";
        reverse(ans.begin(), ans.end());

        int num1 = 0;
        for(int i = 1; i < (int)s.size(); i ++){
            if('0' <= s[i] && s[i] <= '9') num1 = num1 * 10 + (s[i] - '0');
            else break;
        }
        cout << ans << num1 << endl;
    }
    else{
        string s1 = "", s2 = "";
        for(int i = 0; i < (int)s.size(); i ++){
            if('A' <= s[i] && s[i] <= 'Z') s1 += s[i];
            else s2 += s[i];
        }
        int num = 0;
        reverse(s1.begin(), s1.end());
        for(int i = 0; i < (int)s1.size(); i ++){
            num = num * 26 + (s[i] - 'A' + 1);
        }
        cout << "R" << s2 << "C" << num << endl;
    }
