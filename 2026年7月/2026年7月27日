ull h[10000], p[10000];
const ull base = 131;

ull get_hash(int l, int r){
    return h[r] - h[l - 1] * p[r - l + 1];
}

void solve(){

    vector<int> ans = {1};
    
    int n;
    string m;
    cin >> n >> m;

    for(int i = 1; i <= n; i ++){
        ans = mul(ans, i); 
    }
    string s = " ";
    for(int x : ans){
        char sh = x + '0';
        s += sh;
    }   

    p[0] = 1;
    for(int i = 1; i < 10000; i ++) p[i] = p[i - 1] * base;
    for(int i = 1; i < (int)s.size(); i ++){
        h[i] = h[i - 1] * base + (s[i] - '0');
    }
    
    ull sum = 0;
    for(int i = 0; i < (int)m.size(); i ++){
        sum = sum * base + (m[i] - '0');
    }
    int cnt = 0;
    for(int i = 1; i + (int)m.size() - 1 < (int)s.size(); i ++){
        int l = i, r = i + (int)m.size() - 1;
        ull now_sum = get_hash(l, r);
        if(sum == now_sum) cnt ++;
    }
    cout << cnt << endl;
    return ;
