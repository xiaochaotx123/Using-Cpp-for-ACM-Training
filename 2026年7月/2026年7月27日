void solve(){

    int n; cin >> n;
    if(n == 0){
        cout << 0 << endl;
        return ;
    }
    bool ok = false;
    if(n < 0){
        ok = true;
        n = -n;
    }

    vector<int> f;
    while(n){
        f.push_back(n % 3);
        n /= 3;
    }
    
    for(int i = 0; i < (int)f.size(); i ++){
        if(f[i] == 2){
            f[i] = -1;
            if(i == (int)f.size() - 1) f.push_back(1);
            else f[i + 1] ++;
        }
        else if(f[i] == 3){
            f[i] = 0;
            if(i == (int)f.size() - 1) f.push_back(1);
            else f[i + 1] ++;
        }
    }
    reverse(f.begin(), f.end());
    if(ok){
        for(int i = 0; i < (int)f.size(); i ++) f[i] *= (-1);
    }

    for(int x : f){
        if(x == -1) cout << "-";
        else if(x == 0) cout << "0";
        else cout << "1";
    }
    cout << endl;

    return ;
}
