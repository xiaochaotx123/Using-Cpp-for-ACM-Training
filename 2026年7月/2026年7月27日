    for(int i = 1; i <= n; i ++) cin >> a[i];
    sort(a.begin() + 1, a.begin() + 1 + n);

    vector<int> max_cnt(n + 10);
    for(int i = 1; i <= n; i ++){
        int l = i + 1, r = n, pos = -1;
        while(l <= r){
            int mid = (l + r) / 2;
            if(a[mid] > a[i]){
                pos = mid;
                r = mid - 1;                
            }
            else l = mid + 1;
        }
        if(pos == -1) max_cnt[i] = 0;
        else max_cnt[i] = n - pos + 1;
    }

    // for(int i = 1; i <= n; i ++) cout << a[i] << " ";
    // cout << endl;
    // for(int i = 1; i <= n; i ++) cout << max_cnt[i] << " ";
    // cout << endl;

    int ans = 0, x = (n - 1) * n / 2;
    for(int i = 1; i <= n; i ++){
        int sum = (max_cnt[i] * ((x * f[n - 2]) % mod)) % mod;
        ans = (ans + sum) % mod;
    }
    cout << ans << endl;
    return ;
}
