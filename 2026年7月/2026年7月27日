bool check(int x){
    if(x == 1) return false;
    if(x == 2 || x == 3) return true;
    for(int i = 2; i * i <= x ; i ++){
        if(x % i == 0) return false;
    }
    return true;
}

void solve(){

    int n; cin >> n;
    if(check(n)) cout << 0 << endl;
    else{
        if(n & 1){
            if(check(n - 2)) cout << 2 << endl;
            else cout << 3 << endl;
        }
        else cout << 2 << endl;
    }
    return ;
}
