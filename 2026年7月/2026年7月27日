/*
https://www.matiji.net/exam/brushquestion/199/3181/1DC60EA6DF83A333301CFFE1407FBA59

求a的(b的c次方)对p取模的问题

如果a和p互质，那么a^(φ(p)) = 1(mod p)
如果p为指数，那么φ(p) = p - 1，那么就是a^(p - 1) = 1(mod p)
所以计算a^(b^c) mod p = a^((b^c) % (p - 1)) % p，这样因为b^c如果很大就可以缩小到p-1内，就可以正常使用快速幂了
*/
const int mod = 100000000 + 7;

int ksm(int a, int b, int p){
    int sum = 1;
    while(b){
        if(b & 1) sum = (sum * a) % p;
        b >>= 1;
        a = (a * a) % p;
    }
    return sum;
}

void solve(){

    int a, b; cin >> a >> b;
    b = ksm(2, b, mod - 1);
    b = (b - 1 + mod - 1) % (mod - 1);
    cout << ksm(a, b, mod) << endl;
    return ;
}
