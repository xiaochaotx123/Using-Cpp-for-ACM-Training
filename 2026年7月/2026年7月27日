void solve(){

    int a, b; cin >> a >> b;
    int ans = 0;
    int n = a - b;
    for(int i = 1; i * i <= n; i ++){
        if(n % i == 0){
            int x = i, y = n / i;
            if(x == y){
                if(x > b) ans ++;
            }
            else{
                if(x > b) ans ++;
                if(y > b) ans ++;
            }
        }
    }
    cout << ans << endl;
    return ;
}
