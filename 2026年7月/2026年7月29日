const int mod = 10000000 + 7;

void solve(){
    
    int n; cin >> n;
    priority_queue<int> q;
    for(int i = 1; i <= n; i ++){
        int x; cin >> x;
        q.push(x);
    }
    int ans = 0;
    while(q.size() > 1){
        int x1 = q.top();
        q.pop();
        int x2 = q.top();
        q.pop();
        if(x1 + x2 < 0) break;
        ans = (ans + (x1 + x2)) % mod;
        q.push(x1 + x2);
    }
    cout << ans << endl;
    return ;
}
