const int mod = 1000000000 + 7;

int ksm(int a, int b, int p){
    int sum = 1;
    a %= p;
    while(b){
        if(b & 1) sum = (sum * a) % p;
        b >>= 1;
        a = (a * a) % p;
    }
    return sum;
}

void solve(){
    
    int n; cin >> n;
    cout << ksm((n % mod), mod - 2, mod) << endl;

