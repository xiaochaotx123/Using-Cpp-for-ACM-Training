直接对x到1的所有数进行质因数分解，至于其次幂，直接与质因子出现的次数相乘：比如8^3：因为6中的质因子2出现了3次，那么8^3的质因子2就出现了3*3=9次！
因为数据范围很大，虽然最大只有1e7，但是经过次方相乘之后的质因子比如2的个数需要使用long long！
*/
#include<bits/stdc++.h>
using namespace std;

#define endl '\n'
#define int long long
#define ull unsigned long long
#define IOS ios::sync_with_stdio(false);cin.tie(NULL);cout.tie(NULL);
#define HelloWorld IOS;

using PII = pair<int, int>;
#define fi first
#define se second
#define pb push_back
#define sz(x) ((int)(x).size())
#define all(x) (x).begin(), (x).end()
const int inf = 3000000000000000000;
const int rinf = -3000000000000000000;
const bool HAVE_CASE = false;


const int N = 10000000 + 100;
int prime[1000000 + 100], idx;
bool vis[N];
int min_prime[N];
int cnt[N];

void get_prime(){
    for(int i = 2; i < N; i ++){
        if(!vis[i]){
            prime[++ idx] = i;
            min_prime[i] = i;
        }
        for(int j = 1; j <= idx && prime[j] <= N / i; j ++){
            vis[i * prime[j]] = true;
            min_prime[i * prime[j]] = prime[j];
            if(i % prime[j] == 0) break;
        }
    }
}

void work(int n, int mul){
    while(n > 1){
        cnt[min_prime[n]] += mul;
        n /= min_prime[n];
    }
}

void solve(){
    
    int n; cin >> n;
    for(int i = n; i >= 2; i --) work(i, n - i + 1);

    int final_pos = 1;
    for(int i = 1; i <= idx; i ++){
        if(cnt[prime[i]]) final_pos = i;
    }
    cout << "f(" << n << ")=";

    for(int i = 1; i < final_pos; i ++){
        if(cnt[prime[i]]){
            cout << prime[i];
            if(cnt[prime[i]] > 1) cout << "^" << cnt[prime[i]];
            cout << "*";
        }
    }
    cout << prime[final_pos];
    if(cnt[prime[final_pos]] > 1) cout << "^" << cnt[prime[final_pos]];
    cout << endl;
    return ;
}

signed main(){
    HelloWorld;

    get_prime();
    int tt = 1; 
    if(HAVE_CASE) cin >> tt;
    while(tt --) solve();
    return 0;
}
