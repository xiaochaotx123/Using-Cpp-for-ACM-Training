const int N = 110;
int n, m;
int a[N][N], max_len[N][N];

int dx[] = {0, 0, 1, -1};
int dy[] = {1, -1, 0, 0};

void dfs(int x, int y){
    max_len[x][y] = 1;
    for(int i = 0; i < 4; i ++){
        int nx = x + dx[i], ny = y + dy[i];
        if(nx < 1 || nx > n || ny < 1 || ny > m) continue;
        if(a[x][y] <= a[nx][ny]) continue;
        if(max_len[nx][ny]) max_len[x][y] = max(max_len[x][y], max_len[nx][ny] + 1);
        else{
            dfs(nx, ny);
            max_len[x][y] = max(max_len[x][y], max_len[nx][ny] + 1);
        }
    }
}
void solve(){
    
    cin >> n >> m;
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= m; j ++) cin >> a[i][j];
    }    
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= m; j ++){
            if(!max_len[i][j]) dfs(i, j);
        }
    }
    
    int ans = 1;
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= m; j ++) ans = max(ans, max_len[i][j]);
    }
    cout << ans << endl;
    return ;
}
