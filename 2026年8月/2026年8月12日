void solve(){
    
    int n; cin >> n;
    int a, b, c; cin >> a >> b >> c;

    if(a < b) swap(a, b);
    if(a < c) swap(a, c);
    if(b < c) swap(b, c);

    int ans = inf;
    for(int i = 0; i <= 9999; i ++){
        if(i * a > n) break;
        for(int j = 0; i + j <= 9999; j ++){
            int num = i * a + j * b;
            if(num > n) break;
            if((n - num) % c) continue;
            int z = (n - num) / c;
            ans = min(ans, i + j + z);
        }
    }
    cout << ans << endl;
    return ;
}
