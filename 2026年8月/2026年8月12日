/*
https://atcoder.jp/contests/typical90/tasks/typical90_o

非常厉害的将中间不好处理的限制条件通过换元得以处理！！！

例如现在选取了m个数为x[1], x[2], x[3], ..., x[m]
那么对于所有的i∈[2, m]来说都满足 x[i] - x[i - 1] >= k
(是的，一般都会推导到这里，然后呢？就不知道怎么做了！)

变量代换：
y[1] = x[1]
y[2] = x[2] - (k - 1)

这时候x[2] - x[1] = (y[2] + (k - 1)) - y[1] >= k
所以y[2] - y[1] >= 1
居然可以通过变量代换是的原先需要满足x[i] - x[i - 1] >= k的条件变成y[i] - y[i - 1] >= 1
继续写出后面的变量代换：
y[3] = x[3] - 2 × (k - 1)
y[4] = x[4] - 3 × (k - 1)
....
y[m] = x[m] - (m - 1) × (k - 1)
所以对于所有的i∈[2, m]来说都满足 y[i] - y[i - 1] >= 1

而这个条件y[i] - y[i - 1] >= 1是啥？排序后，这个条件是永远成立的！所以就是直接选取m个y[i]

首先得知道m的范围，因为m的含义是选取m个数字，这是一个范围
然后得知道y[m]的范围，y[m]的含义是最大边界
比如m的范围是3，y[m]的值是10，那么意思就是再在10个数种选取3个数，那么组合数就是C(10, 3)

求m的范围：
选取了m个数，数于数之间的间隔最小为(m - 1) × (k - 1)，所以一共占用的格子最少为 m + (m - 1) × (k - 1)
所以m + (m - 1) × (k - 1) <= n
解得 m <= (n + k - 1) / k，所以m的范围就是[1, (n + k - 1) / k]

然后求y[m]的范围
x[m] = y[m] + (m - 1) × (k - 1) <= n
所以y[m] <= n - (m - 1) × (k - 1)

现在已知m的范围，只需要枚举m的值，然后在n - (m - 1) × (k - 1)种任意选取m个数，就是C(n - (m - 1) × (k - 1), m)
*/
#include<bits/stdc++.h>
using namespace std;

#define endl '\n'
#define int long long
#define ull unsigned long long
#define IOS ios::sync_with_stdio(false);cin.tie(NULL);cout.tie(NULL);
#define HelloWorld IOS;

using PII = pair<int, int>;
#define fi first
#define se second
#define pb push_back
#define sz(x) ((int)(x).size())
#define all(x) (x).begin(), (x).end()
#define alll(x, n) (x).begin() + 1, (x).begin() + 1 + n
template<typename T> using max_queue = priority_queue<T>;
template<typename T> using min_queue = priority_queue<T, vector<T>, greater<T>>;
const double eps = 1e-9;
const int inf = 3000000000000000000;
const int rinf = -3000000000000000000;
const bool HAVE_CASE = false;


const int mod = 1000000000 + 7;
const int N = 100000 + 100;
int f[N];

int ksm(int a, int b, int p){
    int sum = 1;
    while(b){
        if(b & 1) sum = (sum * a) % p;
        b >>= 1;
        a = (a * a) % p;
    }
    return sum;
}

void init(){
    f[0] = 1;
    for(int i = 1; i < N; i ++) f[i] = (f[i - 1] * i) % mod;
}

int get_zu(int n, int m){
    int fz = f[n];
    int fm1 = ksm(f[m], mod - 2, mod);
    int fm2 = ksm(f[n - m], mod - 2, mod);
    int fm = (fm1 * fm2) % mod;
    int sum = (fz * fm) % mod;
    return sum;
}

void solve(){
    
    int n; cin >> n;

    for(int k = 1; k <= n; k ++){
        int ans = 0;
        int m = (n + k - 1) / k;
        for(int i = 1; i <= m; i ++){
            // C(n - (i - 1) * (k - 1), i)
            ans = (ans + get_zu(n - (i - 1) * (k - 1), i)) % mod;
        }
        cout << ans << endl;
    }

    return ;
}

signed main(){
    HelloWorld;

    init();
    int tt = 1; 
    if(HAVE_CASE) cin >> tt;
    while(tt --) solve();
    return 0;
}
