struct Node{
    int d, c, s;
};

bool cmp(Node a, Node b){
    if(a.d != b.d) return a.d < b.d;
    else if(a.c != b.c) return a.c > b.c;
    else return a.s > b.s;
}

void solve(){
    
    int n; cin >> n;
    vector<Node> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i].d >> a[i].c >> a[i].s;

    sort(alll(a, n), cmp);
    vector<int> dp(5000 + 10);

    for(int i = 1; i <= n; i ++){
        for(int j = 5000; j >= 1; j --){
            // dp[j] = max(dp[j], dp[j + 1]);

            if(j <= a[i].d && j - a[i].c >= 0){
                if(j - a[i].c == 0) dp[j] = max(dp[j], a[i].s);
                else dp[j] = max(dp[j], dp[j - a[i].c] + a[i].s);
            }
        }
    }

    int ans = 0;
    for(int i = 1; i <= 5000; i ++) ans = max(ans, dp[i]);
    cout << ans << endl;
    return ;
}
