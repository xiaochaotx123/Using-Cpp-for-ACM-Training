const int N = 400 + 10;
int n, a[N];
int dp[N][N]; // 表示处理区间[l, r]的代价

void solve(){
    
    
    cin >> n;
    n = 2 * n;
    for(int i = 1; i <= n; i ++) cin >> a[i];

    // 初始化
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= n; j ++) dp[i][j] = inf; // 初始化为无穷大
    }

    for(int i = 1; i <= n - 1; i ++){
        dp[i][i + 1] = abs(a[i] - a[i + 1]);
    }

    
    for(int len = 4; len <= n; len += 2){
        /*
        第一层枚举处理的区间长度，一定是偶数
        一开始上面已经预处理了长度为2的情况
        */

        for(int l = 1; l + len - 1 <= n; l ++){
            int r = l + len - 1;
            
            // 对于区间[l, r]的动态转移方程dp[l][r]

            dp[l][r] = min(dp[l][r], dp[l + 1][r - 1] + abs(a[l] - a[r]));
            /*
            这里的动态转移方程：首先对于区间[l, r]，长度一定是偶数
            可以将其分为两个偶数区间[l, k]和[k + 1][r]，所以dp[l][r] = min(dp[l][r], dp[l][k] + dp[k + 1][r])
            所以需要枚举位置k
            
            另外有一种特别的划分方式，分为[l + 1, r - 1]最后去合并a[l]和a[r]
            */
            // dp[l][r] = min(dp[l][r], dp[l][r - 2] + abs(a[r] - a[r - 1]));
            // dp[l][r] = min(dp[l][r], dp[l + 2][r] + abs(a[l] - a[l + 1]));

            for(int k = l + 1; k < r; k += 2){
                dp[l][r] = min(dp[l][r], dp[l][k] + dp[k + 1][r]);
            }
        }
    }

    // for(int len = 2; len < n; len += 2){
    //     for(int l = 1; l + len - 1 <= n; l += 2){
    //         int r = l + len - 1;;
    //         cout << l << " " << r << " " << dp[l][r] << endl;
    //     }
    // }
    cout << dp[1][n] << endl;
    return ;
}
