void solve(){
    
    int n; cin >> n;
    int h, px, py; cin >> h >> px >> py;

    int q; cin >> q;
    for(int i = 1; i <= q; i ++){
        int t; cin >> t;
        double angle = t * 1.0 / n * 2.0 * pi;
        double x = h / 2.0 * sin(angle) * (-1);
        double y = h / 2.0 * (1.0 - cos(angle));
        
        double len1 = y;
        double len2 = sqrt(px * px + (py - x) * (py - x));
        
        double now_angle = atan(len1 * 1.0 / len2);
        double ans_angle = now_angle * 1.0 / pi * 180.0;
        cout << fixed << setprecision(12) << ans_angle << endl;
    }
    return ;
}
