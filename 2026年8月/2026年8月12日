int n, m;
const int N = 100000 + 100;
vector<PII> adj[N];
int dist1[N], distn[N];
int vis[N];

struct cmp{
    bool operator() (const PII &a, const PII &b) const{
        return a.se > b.se;
    }
};

void dijkstra(int start, int dist[]){
    fill(vis + 1, vis + 1 + n, 0);
    fill(dist + 1, dist + 1 + n, inf);

    priority_queue<PII, vector<PII>, cmp> q;
    q.push({start, 0});
    dist[start] = 0;

    while(q.size()){
        PII now = q.top(); q.pop();
        int u = now.fi;
        if(vis[u]) continue;
        vis[u] = 1;

        for(auto [v, w] : adj[u]){
            if(!vis[v] && dist[v] > dist[u] + w){
                dist[v] = dist[u] + w;
                q.push({v, dist[v]});
            }
        }
    }

    return ;
}

void solve(){
    
    cin >> n >> m;
    for(int i = 1; i <= m; i ++){
        int u, v, w; cin >> u >> v >> w;
        adj[u].pb({v, w});
        adj[v].pb({u, w});
    }

    dijkstra(1, dist1);
    dijkstra(n, distn);

    // for(int i = 1; i <= n; i ++) cout << dist1[i] << " ";
    // cout << endl;

    // for(int i = 1; i <= n; i ++) cout << distn[i] << " ";
    // cout << endl;

    for(int i = 1; i <= n; i ++){
        cout << dist1[i] + distn[i] << endl;
    }
    return ;
}
