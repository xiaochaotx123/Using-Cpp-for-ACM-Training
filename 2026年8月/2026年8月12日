const int N = 2000 * 3000;
int n, m;

int p[N];
int find(int x){
    if(x != p[x]) p[x] = find(p[x]);
    return p[x];
}

int dx[] = {0, 0, 1, -1};
int dy[] = {1, -1, 0, 0};

int get_num(int x, int y){
    int sum = (x - 1) * m + y;
    return sum;
}

void solve(){
    
    cin >> n >> m;

    vector<int> vis(n * m + 10);
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= m; j ++){
            int num = get_num(i, j);
            p[num] = num;
        }
    }
    int q; cin >> q;
    
    while(q --){
        int op; cin >> op;
        if(op == 1){
            int x, y; cin >> x >> y;
            int num = get_num(x, y);

            vis[num] = 1;
            for(int i = 0; i < 4; i ++){
                int nx = x + dx[i], ny = y + dy[i];
                if(nx < 1 || nx > n || ny < 1 || ny > m) continue;
                int nnum = get_num(nx, ny);
                if(!vis[nnum]) continue;
                int fu = find(num), fv = find(nnum);
                p[fu] = fv;
            }
        }
        else{
            int x1, y1, x2, y2; cin >> x1 >> y1 >> x2 >> y2;
            int num1 = get_num(x1, y1), num2 = get_num(x2, y2);

            if(!vis[num1] || !vis[num2]){
                cout << "No" << endl;
                continue;
            }
            int fu = find(num1), fv = find(num2);
            if(fu == fv) cout << "Yes" << endl;
            else cout << "No" << endl;
        }
    }
    return ;
}
