/*
https://atcoder.jp/contests/typical90/tasks/typical90_t

确实有一个点没有重视，就是精度丢失的问题

一开始为了方便，就直接使用pow函数
    int a, b, c; cin >> a >> b >> c;
    int sum = pow(c, b);
    if(a < sum) cout << "Yes" << endl;
    else cout << "No" << endl;
但是错了，原因是pow函数返回的是double类型的近似值，只有约15-16位有效数字，当
这个近似值转化为long long类型时，如果超出了15-15位数字，那么精度丢失！

然后使用另外一种想法，直接求出log对数的值
    int a, b, c; cin >> a >> b >> c;
    
    double x = log2(a);
    double y = log2(c) * b;
    
    if(y - x > eps) cout << "Yes" << endl;
    else cout << "No" << endl;
仍然错误，原因一样
*/

int ksm(int a, int b){
    int sum = 1;
    while(b){
        if(b & 1) sum = (sum * a);
        b >>= 1;
        a = (a * a);
    }
    return sum;
}

void solve(){
    
    int a, b, c; cin >> a >> b >> c;
    
    int sum = ksm(c, b);
    if(a < sum) cout << "Yes" << endl;
    else cout << "No" << endl;
    return ;
}
