#include<bits/stdc++.h>
using namespace std;

#define endl '\n'
#define int long long
#define ull unsigned long long
#define IOS ios::sync_with_stdio(false);cin.tie(NULL);cout.tie(NULL);
#define HelloWorld IOS;

using PII = pair<int, int>;
#define fi first
#define se second
#define pb push_back
#define sz(x) ((int)(x).size())
#define all(x) (x).begin(), (x).end()
#define alll(x, n) (x).begin() + 1, (x).begin() + 1 + n
template<typename T> using max_queue = priority_queue<T>;
template<typename T> using min_queue = priority_queue<T, vector<T>, greater<T>>;
const double eps = 1e-9;
const int inf = 3000000000000000000;
const int rinf = -3000000000000000000;
const bool HAVE_CASE = false;


const int N = 300000 + 100;


int n, m;

struct Node{
    int l, r;
    int cnt;
}tr[4 * N];


bool cmp(PII a, PII b){
    if(a.fi != b.fi) return a.fi < b.fi;
    else return a.se > b.se;
}

void push_up(int u){
    tr[u].cnt = (tr[u << 1].cnt + tr[u << 1 | 1].cnt);
}

void build(int u, int l, int r){
    if(l == r){
        tr[u] = {l, r, 0};
        return ;
    }
    else{
        tr[u] = {l, r, 0};
        int mid = (tr[u].l + tr[u].r) >> 1;
        build(u << 1, l, mid);
        build(u << 1 | 1, mid + 1, r);
    }
}

int query(int u, int x){
    if(tr[u].r <= x) return tr[u].cnt;
    else{
        int res = 0;
        int mid = (tr[u].l + tr[u].r) >> 1;
        if(x <= mid) res = query(u << 1, x);
        else res = tr[u << 1].cnt + query(u << 1 | 1, x);
        return res;
    }
}

void modify(int u, int x){
    if(tr[u].l == tr[u].r){
        tr[u].cnt ++;
        return ;
    }
    else{
        int mid = (tr[u].l + tr[u].r) >> 1;
        if(x <= mid) modify(u << 1, x);
        else modify(u << 1 | 1, x);
        push_up(u);
    }
}

void solve(){
    
    cin >> n >> m;
    vector<PII> a(m + 10);
    for(int i = 1; i <= m; i ++) cin >> a[i].fi >> a[i].se;

    sort(alll(a, m), cmp);

    build(1, 1, n + 10);

    int ans = 0;
    for(int i = 1; i <= m; i ++){
        if(a[i].fi <= a[i].se - 1) ans += query(1, a[i].se - 1) - query(1, a[i].fi);

        modify(1, a[i].se);
    }

    cout << ans << endl;
    return ;
}

signed main(){
    HelloWorld;

    int tt = 1; 
    if(HAVE_CASE) cin >> tt;
    while(tt --) solve();
    return 0;
}
