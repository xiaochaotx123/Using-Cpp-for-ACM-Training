/*
https://www.matiji.net/exam/brushquestion/24/3846/4C6668FEB8CFD6520DE73B365B31D1A4
*/
const int N = 1000000 + 100;
const int M = 22;

int n, a[N], b[N];
int st_max[N][M], st_min[N][M];
int lg[N];


int query_min(int l, int r){
    int k = lg[r - l + 1];
    return min(st_min[l][k], st_min[r - (1LL << k) + 1][k]);
}

int query_max(int l, int r){
    int k = lg[r - l + 1];
    return max(st_max[l][k], st_max[r - (1LL << k) + 1][k]);
}


int work(int start){

    int l = start, r = n, first_pos = -1, final_pos = -1;
    while(l <= r){
        int mid = (l + r) / 2;
        int max_a = query_max(start, mid);
        int min_b = query_min(start, mid);
        if(max_a - min_b >= 0){
            first_pos = mid;
            r = mid - 1;
        }
        else l = mid + 1;
    }
    if(first_pos == -1) return 0;
    int now_max_a = query_max(start, first_pos);
    int now_min_b = query_min(start, first_pos);
    if(now_max_a != now_min_b) return 0;

    l = start, r = n;
    while(l <= r){
        int mid = (l + r) / 2;
        int max_a = query_max(start, mid);
        int min_b = query_min(start, mid);
        if(max_a - min_b <= 0){
            final_pos = mid;
            l = mid + 1;
        }
        else r = mid - 1;
    }
    
    return (final_pos - first_pos + 1);
}
void solve(){

    cin >> n;
    for(int i = 1; i <= n; i ++) cin >> a[i];
    for(int i = 1; i <= n; i ++) cin >> b[i];

    lg[1] = 0;
    for(int i = 2; i <= n; i ++) lg[i] = lg[i / 2] + 1;
    
    int m = lg[n] + 1;
    for(int i = 1; i <= n; i ++){
        st_max[i][0] = a[i];
        st_min[i][0] = b[i];
    }

    for(int j = 1; j < m; j ++){
        for(int i = 0; i + (1LL << j) - 1 <= n; i ++){
            st_max[i][j] = max(st_max[i][j - 1], st_max[i + (1LL << (j - 1))][j - 1]);
            st_min[i][j] = min(st_min[i][j - 1], st_min[i + (1LL << (j - 1))][j - 1]);
        }
    }

    int ans = 0;
    for(int i = 1; i <= n; i ++) ans += work(i);
    cout << ans << endl;
    return ;
}
