*/
const int mod = 1000000000 + 7;

int ksm(int a, int b, int p){
    int sum = 1;
    while(b){
        if(b & 1) sum = (sum * a) % p;
        b >>= 1;
        a = (a * a) % p;
    }
    return sum;
}

void solve(){
    
    int n; cin >> n;
    vector<int> a(n + 10);
    for(int i = 1; i <= n; i ++){
        char sh; cin >> sh;
        a[i] = (int)(sh - '0');
    }
    
    int ans = 0, cost = 0;
    for(int i = 1; i <= n; i ++){
        cost = (cost + cost) % mod;
        if(i - 1 >= 1 && a[i - 1] == 0) cost = (cost + 1) % mod;
        if(!(a[i] & 1)){
            ans = (ans + ksm(2, i - 1, mod)) % mod;
            ans = (ans - cost + mod) % mod;
        }
    }
    cout << ans << endl;
    return ;
}
