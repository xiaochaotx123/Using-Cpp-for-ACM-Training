const int N = 100000 + 100;
int n, m; 
PII a[N];

bool cmp(PII a, PII b){
    return a.fi > b.fi;
}

bool check(int x){
    int use_m = 0, use_sum = 0;
    for(int i = 1; i <= n; i ++){
        if(a[i].fi + use_sum < x) use_sum += a[i].fi;
        else if(a[i].fi + use_sum == x){
            use_m ++;
            use_sum = 0;
        }
        else{
            use_sum = use_sum + a[i].fi - x;
            use_m ++;
        }
    }

    if(use_sum) use_m ++;
    if(use_m <= m) return true;
    return false;
}

struct Node{
    int idx1, idx2, l, r;
};


void solve(){
    
    cin >> n >> m;
    int max_time = 0;
    for(int i = 1; i <= n; i ++){
        cin >> a[i].fi;
        a[i].se = i;

        max_time = max(max_time, a[i].fi);
    }
    sort(a + 1, a + 1 + n, cmp);

    int l = max_time, r = 1000000000000000, real_time = max_time;
    while(l <= r){
        int mid = (l + r) / 2;
        if(check(mid)){
            real_time = mid;
            r = mid - 1;
        }
        else l = mid + 1;
    }

    vector<Node> ans;

    int now_m = 1, now_sum = 0;
    for(int i = 1; i <= n; i ++){
        if(now_sum + a[i].fi < real_time){
            ans.pb({a[i].se, now_m, now_sum, now_sum + a[i].fi});
            now_sum += a[i].fi;
        }
        else if(now_sum + a[i].fi == real_time){
            ans.pb({a[i].se, now_m, now_sum, now_sum + a[i].fi});
            now_sum = 0;
            now_m ++;
        }
        else{
            ans.pb({a[i].se, now_m, now_sum, real_time});
            now_sum = now_sum + a[i].fi - real_time;
            now_m ++;
            ans.pb({a[i].se, now_m, 0, now_sum});
        }
    }

    cout << sz(ans) << endl;
    for(int i = 0; i < sz(ans); i ++){
        cout << ans[i].idx1 << " " << ans[i].idx2 << " " << ans[i].l << " " << ans[i].r << endl;
    }
    return ;
}

