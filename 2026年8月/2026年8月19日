const int N = 10000000 + 10;
const int mod = 998244353;

int prime[6000000], cnt[N];
int min_prime[N];
bool vis[N];
int idx;

int ksm(int a, int b, int p){
	int sum = 1;
	while(b){
		if(b & 1) sum = (sum * a) % p;
		b >>= 1;
		a = (a * a) % p;
	}
	return sum;
}

void get_prime(){
	
	for(int i = 2; i < N; i ++){
		if(!vis[i]){
			prime[++ idx] = i;
			min_prime[i] = i; 
		}
		for(int j = 1; j <= idx && prime[j] <= N / i; j ++){
			
			vis[prime[j] * i] = true;
			min_prime[prime[j] * i] = prime[j];
			if(i % prime[j] == 0) break;
		} 
	} 
	return ;
}

void solve(){
    
    int n; cin >> n;
    for(int i = 2; i <= n; i ++){
    	int x = i;
    	while(x > 1){
    		cnt[min_prime[x]] ++;
    		x /= min_prime[x];
		}
	}
	int L = 1;
	for(int i = 1; i <= idx; i ++){
		if(cnt[prime[i]]) L = (L * ksm(prime[i], cnt[prime[i]], mod)) % mod;
	}
	
	int H = 0;
	
	for(int i = 1; i <= n; i ++){
		int h = ksm(i, mod - 2, mod);
		H = (H + h) % mod;
	}
	
	int ans = ((n + 1) * H) % mod;
	ans = (ans - 2 * n + mod) % mod;
	ans = (ans * L) % mod;
	
	cout << ans << endl;
    return ;
}
