/*
https://atcoder.jp/contests/abc470/tasks/abc470_d
*/

void solve(){
    
    int n, q; cin >> n >> q;
    vector<int> a(n + 10), b(n + 10);
    for(int i = 1; i <= n; i ++){
        cin >> a[i];
        b[a[i]] = i;
    }

    int cnt = 1;
    while(q --){
        int op; cin >> op;
        if(op == 1){
            int x, y; cin >> x >> y;
            if(cnt){
                b[a[x]] = y;
                b[a[y]] = x;
                swap(a[x], a[y]);
            }
            else{
                a[b[x]] = y;
                a[b[y]] = x;
                swap(b[x], b[y]);
            }
        }
        else cnt ^= 1;
    }

    for(int i = 1; i <= n; i ++){
        if(cnt) cout << a[i] << " ";
        else cout << b[i] << " ";
    }
    cout << endl;
    return ;
}
