https://atcoder.jp/contests/abc470/tasks/abc470_c
*/

void solve(){
    
    int n, q; cin >> n >> q;
    
    vector<int> a(n + 10);
    set<int> see;
    int ans = 0;

    while(q --){
        int op; cin >> op;
        if(op == 1){
            int x; cin >> x;

            ans ^= a[x];
            a[x] ++;
            ans ^= a[x];
            if(a[x] == 1) see.insert(x);
        }
        else{
            set<int> now_se;
            for(int num : see){
                ans ^= a[num];
                if(a[num] - 1 >= 1) now_se.insert(num);
                a[num] --;
                ans ^= a[num];
            }
            see = now_se;
        }
        cout << ans << endl;
    }
    return ;
}
