/*
https://www.matiji.net/exam/brushquestion/1/4498/F16DA07A4D99E21DFFEF46BD18FF68AD
*/

void solve(){
    
    int n, m; cin >> n >> m;
    vector<PII> a(n + 10);
    for(int i = 1; i <= n; i ++){
        int x, y; cin >> x >> y;
        a[i] = {x + y, x / 2 + y};
    }

    int ans = 0;
    for(int i = 1; i <= n; i ++){

        int m1 = m;
        int now_ans = 0;
        vector<int> v;
        v.pb(a[i].se);

        for(int j = 1; j <= n; j ++){
            if(j == i) continue;
            v.pb(a[j].fi);
        }
        sort(all(v));
        for(int x : v){
            if(m1 - x >= 0){
                now_ans ++;
                m1 -= x;
            }
        }

        ans = max(ans, now_ans);
    }

    cout << ans << endl;
    return ;
}
