const int mod = 998244353;

int ksm(int a, int b, int p){
    int sum = 1;
    while(b){
        if(b & 1) sum = (sum * a) % p;
        b >>= 1;
        a = (a * a) % p;
    }
    return sum;
}

void solve(){
    
    int n; cin >> n;
    int ans = ksm(2, n, mod);
    ans = (ans - 1 + mod) % mod;
    cout << ans << endl;
    return ;
}

