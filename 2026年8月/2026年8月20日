const int N = 5000 + 100;
const int mod = 998244353;

int n, m;
char s[N];

int dp[2][N][3];

void solve(){
    
    cin >> n >> m;
    for(int i = 1; i <= n; i ++) cin >> s[i];
    
    dp[0][0][0] = 1;
    for(int i = 1; i <= n; i ++){
        int x = i % 2;
        
        for(int j = 0; j <= m; j ++){
            if(s[i] == '0'){
                dp[x][j][0] = (dp[x][j][0] + dp[x ^ 1][j][0] + dp[x ^ 1][j][1]) % mod;
                if(j >= 1) dp[x][j][1] = (dp[x][j][1] + dp[x ^ 1][j - 1][0]) % mod;
                if(j >= 1) dp[x][j][2] = (dp[x][j][2] + dp[x ^ 1][j - 1][1] + dp[x ^ 1][j - 1][2]) % mod;
            }
            else{
                if(j >= 1) dp[x][j][0] = (dp[x][j][0] + dp[x ^ 1][j - 1][0] + dp[x ^ 1][j - 1][1]) % mod;
                dp[x][j][1] = (dp[x][j][1] + dp[x ^ 1][j][0]) % mod;
                dp[x][j][2] = (dp[x][j][2] + dp[x ^ 1][j][1] + dp[x ^ 1][j][2]) % mod;
            }
        }
        memset(dp[x ^ 1], 0, sizeof(dp[x ^ 1]));
    }

    int ans = 0;
    int x = n % 2;
    for(int i = 0; i <= m; i ++) ans = (ans + dp[x][i][0] + dp[x][i][1] + dp[x][i][2]) % mod;
    cout << ans << endl;
    return ;
}
