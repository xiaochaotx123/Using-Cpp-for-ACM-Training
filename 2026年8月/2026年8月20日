char from = 'A', mi = 'B', to = 'C';
int n;
string s;

void solve(){
    
    cin >> n >> s;
    string ans = "";
    for(char ch : s){
        if(ch == '1'){
            ans += to;
            swap(from, mi);
        }
        else{
            ans += from;
            swap(mi, to);
        }
    }
    reverse(all(ans));
    cout << ans << endl;
    return ;
}

