/*
https://www.matiji.net/exam/brushquestion/10/4498/F16DA07A4D99E21DFFEF46BD18FF68AD
*/

void solve(){
    
    int n, m; cin >> n >> m;
    vector<int> a(n + 10);
    for(int i = 1; i <= m; i ++){
        int l, r; cin >> l >> r;
        a[l] ++;
        a[r + 1] --; 
    }
    for(int i = 1; i <= n; i ++) a[i] += a[i - 1];
    
    sort(alll(a, n));
    cout << a[n / 2 + 1] << endl;
    return ;
}
