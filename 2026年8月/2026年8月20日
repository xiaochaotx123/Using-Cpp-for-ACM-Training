*/

const int mod = 1000000000 + 7;

int ksm(int a, int b, int p){
    int sum = 1;
    while(b){
        if(b & 1) sum = (sum * a) % p;
        b >>= 1;
        a = (a * a) % p;
    }
    return sum;
}


struct Node{
    int id;
    char from, to;
};

vector<Node> ans;
vector<deque<int> > d(4);

void dfs(char from, char mi, char to, int x){
    if(x == 0) return ;

    dfs(from, to, mi, x - 1);

    int id1 = 1, id2 = 1;
    if(from == 'A') id1 = 1;
    else if(from == 'B') id1 = 2;
    else id1 = 3;
    if(to == 'A') id2 = 1;
    else if(to == 'B') id2 = 2;
    else id2 = 3;

    int idx = d[id1].front();
    d[id1].pop_front();
    d[id2].push_front(idx);
    ans.pb({idx, from, to});

    dfs(mi, from, to, x - 1);
}

void solve(){
    
    int n; cin >> n;
    int fans = ksm(2, n, mod);
    fans = (fans - 1 + mod) % mod;
    cout << fans << endl;

    for(int i = 1; i <= n; i ++) d[1].pb(i);
    dfs('A', 'B', 'C', n);

    for(int i = 0; i < sz(ans); i ++){
        cout << ans[i].id << " " << ans[i].from << "->" << ans[i].to << endl;
    }
    return ;
}
