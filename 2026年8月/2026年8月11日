/*
https://ac.nowcoder.com/acm/problem/315179

给定一个长度n，要求构造一个直角三角形，满足其中一条边长长度为n即可
其实通过打表可以观察出规律就是：只有当n小于等于2时无解，其余情况都是可以构造出来的
当n = 1或n = 2时无解
当n为奇数时，另外两条边可以是(n * n - 1) / 2, (n * n + 1) / 2
当n为偶数时，另外两条边可以是(n * n) / 4 - 1, (n * n) / 4 + 1
*/
void solve(){
    
    int n; cin >> n;
    if(n <= 2) cout << "No" << endl;
    else{
        cout << "Yes" << endl;
        if(n & 1) cout << n << " " << (n * n - 1) / 2 << " " << (n * n + 1) / 2 << endl;
        else{
            if(n == 4) cout << 3 << " " << 4 << " " << 5 << endl;
            else{
                cout << n << " " << (n * n) / 4 - 1 << " " << (n * n) / 4 + 1 << endl;
            }
        } 
    }    
    return ;
}
