const int mod = 1000000000 + 7;
void solve(){
    
    int n; cin >> n;
    vector<char> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i];
    // actoder
    vector<int> dp(7, 0);
    for(int i = 1; i <= n; i ++){
        if(a[i] == 'a') dp[0] ++;
        else if(a[i] == 't') dp[1] = (dp[1] + dp[0]) % mod;
        else if(a[i] == 'c') dp[2] = (dp[2] + dp[1]) % mod;
        else if(a[i] == 'o') dp[3] = (dp[3] + dp[2]) % mod;
        else if(a[i] == 'd') dp[4] = (dp[4] + dp[3]) % mod;
        else if(a[i] == 'e') dp[5] = (dp[5] + dp[4]) % mod;
        else if(a[i] == 'r') dp[6] = (dp[6] + dp[5]) % mod;
    }
    cout << dp[6] << endl;
    return ;
}
