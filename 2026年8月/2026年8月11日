void solve(){
    
    int n; cin >> n;
    vector<int> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i];

    sort(alll(a, n));

    int m; cin >> m;
    for(int i = 1; i <= m; i ++){
        int x; cin >> x;
        if(x > a[n]) cout << x - a[n] << endl;
        else if(x < a[1]) cout << a[1] - x << endl;
        else{
            int l = 1, r = n, pos = -1;
            while(l <= r){
                int mid = (l + r) / 2;
                if(a[mid] <= x){
                    pos = mid;
                    l = mid + 1;
                }
                else r = mid - 1;
            }
            int ans = x - a[pos];
            if(pos + 1 <= n) ans = min(ans, a[pos + 1] - x);
            cout << ans << endl;
        }
    }
    return ;
}
