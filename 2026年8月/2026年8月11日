bool check(int a, int b, int y){
    int sum = 0;
    while(b){
        if(b & 1){
            sum = sum + a;
            if(sum > y) return true;
        }
        b >>= 1;
        a = (a + a);
    }
    return false;
}
void solve(){
    
    int x, y; cin >> x >> y;
    if(x <= 1) cout << -1 << endl;
    else{
        if(x > y){
            if(y == 0) cout << -1 << endl;
            else cout << 0 << endl;
        }
        else if(x == y) cout << 1 << endl;
        else{

            if(x > 1000000000){
                cout << 1 << endl;
                return ;
            }
            
            int sum = x;
            for(int ans = 1; ; ans ++){
                if(check(sum, x, y)){
                    cout << ans << endl;
                    return ;
                }
                sum *= x;

            }
        }
    }
    return ;
