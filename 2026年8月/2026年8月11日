void solve(){
    
    int n, m; cin >> n >> m;
    vector<char> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i];
    stack<int> sta;

    for(int i = 1; i <= n; i ++){
        int num = (int)(a[i] - 'a' + 1);
        while(sz(sta) && sta.top() > num && m - sz(sta) < n - i + 1) sta.pop();
        sta.push(num);
    }
    
    vector<int> ans;
    while(sta.size()){
        ans.pb(sta.top());
        sta.pop();
    }
    reverse(all(ans));
    for(int i = 0; i < m; i ++){
        int x = ans[i];
        char ch = (x - 1 + 'a');
        cout << ch;
    }
    cout << endl;
    return ;
}
