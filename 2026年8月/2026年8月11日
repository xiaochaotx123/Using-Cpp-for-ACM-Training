/*
https://codeforces.com/problemset/problem/1731/C

显然如果一个数的约数个数为奇数等价于这个数是完全平方数
所以就是求这样的子数组[l, r]满足a[l] ^ a[l + 1] ^ ... a[r - ] ^ a[r]不是完全平方数
一共有n * (n + 1) / 2个子数组，如果一一枚举，肯定超时
因为a[i] <= n <= 200000, 所以完全平方数不超过200000，考虑枚举完全平方数，并且完全平方数的个数很少
只有448个！！！

比如现在枚举的一个完全平方数x，现在就是求有多少个子区间[l, r]满足(a[l] ^ a[l + 1] ^ ... a[r - 1] ^ a[r]) = x
转化为前缀异或为pre[r] ^ pre[l - 1] = x，所以pre[r] = pre[l - 1] ^ x
所以只需要统计pre[i] ^ x的个数即可
    int ans = n * (n + 1) / 2;
    map<int, int> cnt;
    for(int j = 0; ;  j ++){
        int num = j * j;
        if(num > min(200000LL, n * n)) break;
        cnt.clear();
        cnt[num] ++;
        for(int i = 1; i <= n; i ++){
            int sum = pre[i] ^ num;
            ans -= cnt[pre[i]];
            cnt[sum] ++;
        }
    }
    cout << ans << endl;
但是这样写超时了，原因是对于不同的完全平方数，都需要重新统计pre[i] ^ num的数量

但是对于pre[r] = pre[l - 1] ^ x，其实转换一下：去统计pre[r]的数量就可以了
*/
vector<int> total_num;

void init(){
    for(int i = 0; i * i < 500000; i ++){
        total_num.pb(i * i);
    }
}

int cnt[1000000];
void solve(){
    
    int n; cin >> n;
    vector<int> a(n + 10), pre(n + 10);
    for(int i = 1; i <= n; i ++){
        cin >> a[i];
        pre[i] = pre[i - 1] ^ a[i];
    }

    int ans = n * (n + 1) / 2;
    cnt[0] = 1;
    for(int i = 1; i <= n; i ++){
        for(int num : total_num){
            ans -= cnt[pre[i] ^ num];
        }
        cnt[pre[i]] ++;
    }
    for(int i = 1; i <= n; i ++) cnt[pre[i]] = 0;
    cout << ans << endl;
    return ;
}
