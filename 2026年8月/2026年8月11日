const int mod = 1000000000 + 7;

vector<int> merge(const vector<int> &pre, const vector<int> &suf, int mul, int B){
    vector<int> res(B, 0);
    for(int i = 0; i < B; i ++){
        if(pre[i] == 0) continue;
        for(int j = 0; j < B; j ++){
            if(suf[j] == 0) continue;
            int r = (i * mul + j) % B;
            res[r] = (res[r] + pre[i] * suf[j]) % mod;
        }
    }
    return res;
}

void solve(){
    
    int n, B, K; cin >> n >> B >> K;
    vector<int> c(K);
    for(int i = 0; i < K; i ++) cin >> c[i];
    
    vector<vector<int> > st(61, vector<int> (B, 0));
    vector<int> p(61);

    for(int d : c) st[0][d % B] ++;
    p[0] = 10 % B;

    for(int i = 1; i <= 60; i ++){
        st[i] = merge(st[i - 1], st[i - 1], p[i - 1], B);
        p[i] = (p[i - 1] * p[i - 1]) % B;
    }

    vector<int> ans(B, 0);
    ans[0] = 1;

    for(int i = 60; i >= 0; i --){
        if((n >> i) & 1) ans = merge(ans, st[i], p[i], B);
    }
    cout << ans[0] << endl;
    return ;
}
