const int N = 100000 + 100;

int n;
vector<int> adj[N];
int dist[N];
int duan1, duan2;


void first_dfs(int u, int fa, int dep){
    dist[u] = dep;
    for(int v : adj[u]){
        if(v == fa) continue;
        first_dfs(v, u, dep + 1);
    }
}

void get_duan2(int u, int fa, int dep){
    dist[u] = dep;
    for(int v : adj[u]){
        if(v == fa) continue;
        get_duan2(v, u, dep + 1);
    }
}

void solve(){
    
    cin >> n;
    for(int i = 1; i <= n - 1; i ++){
        int u, v; cin >> u >> v;
        adj[u].pb(v);
        adj[v].pb(u);
    }    
    first_dfs(1, -1, 0);
    duan1 = 1;
    for(int i = 1; i <= n; i ++){
        if(dist[i] > dist[duan1]) duan1 = i;
    }

    get_duan2(duan1, -1, 0);
    duan2 = duan1;
    for(int i = 1; i <= n; i ++){
        if(dist[i] > dist[duan2]) duan2 = i;
    }

    cout << dist[duan2] + 1 << endl;
    return ;
}
