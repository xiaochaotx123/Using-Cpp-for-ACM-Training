void solve(){
    
    int n, q; cin >> n >> q;
    vector<PII> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i].fi >> a[i].se;
    for(int i = 1; i <= n; i ++){
        int x = a[i].fi, y = a[i].se;
        a[i].fi = x + y;
        a[i].se = x - y;
    }
    
    int min_x = inf, max_x = rinf;
    int min_y = inf, max_y = rinf;

    for(int i = 1; i <= n; i ++){
        min_x = min(min_x, a[i].fi);
        max_x = max(max_x, a[i].fi);
        min_y = min(min_y, a[i].se);
        max_y = max(max_y, a[i].se);
    }

    while(q --){
        int idx; cin >> idx;
        int max_dist = max(abs(a[idx].fi - min_x), abs(a[idx].fi - max_x));
        max_dist = max({max_dist, abs(a[idx].se - min_y), abs(a[idx].se - max_y)});
        cout << max_dist << endl;
    }
    
    return ;
}
