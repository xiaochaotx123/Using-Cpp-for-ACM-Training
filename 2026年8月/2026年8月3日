/*
https://www.matiji.net/exam/brushquestion/26/3846/4C6668FEB8CFD6520DE73B365B31D1A4
贪心的策略是：玉米如果能向左倒，那么就向左倒，这样不影响后面的玉米的决策；如果向左倒不行，就尝试向右边倒，因为如果下一个玉米只能向左倒，那么是等价的，否则下一个玉米尝
    试向右倒，一样的
*/
void solve(){
    
    int n; cin >> n;
    vector<PII> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i].fi >> a[i].se;
    
    vector<int> vis(n + 10);
    for(int i = 1; i <= n; i ++){
        if(i == 1) vis[i] = -1;
        else if(i == n) vis[i] = 1;
        else{
            if(vis[i - 1] <= 0){
                if(a[i].fi - a[i].se > a[i - 1].fi) vis[i] = -1;
                else if(a[i].fi + a[i].se < a[i + 1].fi) vis[i] = 1;
            }
            else if(vis[i - 1] == 1){
                if(a[i].fi - a[i].se > a[i - 1].fi + a[i - 1].se) vis[i] = -1;
                else if(a[i].fi + a[i].se < a[i + 1].fi) vis[i] = 1;
            }
        } 
    }
    int ans = 0;
    for(int i = 1; i <= n; i ++){
        if(vis[i] != 0) ans ++;
    }
    cout << ans << endl;
    return ;
}
