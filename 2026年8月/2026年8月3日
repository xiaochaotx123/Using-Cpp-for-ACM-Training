/*
https://www.matiji.net/exam/brushquestion/29/3846/4C6668FEB8CFD6520DE73B365B31D1A4
反悔贪心，当前已经选了的人任务数量为现在的实际时间，即now_time = sz(q)
如果sz(q) < a[i].fi, 就说明可以杀掉，ans += a[i].se
否则反悔贪心看之前的最小的q.top与现在a[i].se大小

进行的过程中sz(q)始终小于等于a[i].fi，绝对不可能是大于a[i].fi，因为一开始将时间升序排列了的
*/
bool cmp(PII a, PII b){
    return a.fi < b.fi;
}
void solve(){
    
    int n; cin >> n;
    vector<PII> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i].fi >> a[i].se;
    sort(a.begin() + 1, a.begin() + 1 + n, cmp);
    int ans = 0;
    sma_queue q;
    for(int i = 1; i <= n; i ++){
        if(sz(q) < a[i].fi){
            ans += a[i].se;
            q.push(a[i].se);
        }
        else{
            if(a[i].se > q.top()){
                ans += a[i].se - q.top();
                q.pop();
                q.push(a[i].se); 
            }
        }
    }
    cout << ans << endl;
    return ;
}
