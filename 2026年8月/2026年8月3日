/*
https://www.matiji.net/exam/brushquestion/31/3846/4C6668FEB8CFD6520DE73B365B31D1A4
*/
bool cmp(PII a, PII b){
    return a.fi < b.fi;
}

void solve(){
    
    int n, m; cin >> n >> m;
    vector<PII> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i].fi >> a[i].se;
    sort(a.begin() + 1, a.begin() + 1 + n, cmp);

    max_queue<int> q;

    int ans = 0, total_sum = 0;

    for(int i = 1; i <= n; i ++){

        // cout << "--------------------------------" << endl;
        // cout << i << " " << m << " " << sz(q) << endl;
        m -= (a[i].fi - a[i - 1].fi);
        while(m < 0 && sz(q)){
            m += q.top();
            total_sum -= q.top();
            q.pop();
        }
        if(m < 0) break;
        if(m + total_sum < a[i].se) continue;
        

        if(m >= a[i].se){
            q.push(a[i].se);
            m -= a[i].se;
            total_sum += a[i].se;
        }   
        else{
            if(sz(q)){
                if(a[i].se < q.top()){
                    m += q.top() - a[i].se;
                    total_sum -= q.top() - a[i].se;
                    q.pop();
                    q.push(a[i].se);
                }
            }
        }
       
        ans = max(ans, sz(q));
        // cout << i << " " << m << " " << sz(q) << endl;
        // cout << "--------------------------------" << endl;
    }

    cout << ans << endl;
    return ;
}
