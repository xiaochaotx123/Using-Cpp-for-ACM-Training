/*
https://www.matiji.net/exam/brushquestion/28/3846/4C6668FEB8CFD6520DE73B365B31D1A4
设一张卡片的两个数为[x, y]，其中x < y
那么如果对于这张卡片，我选择使用减号，那么因当 -y；如果使用加法，那么应当+x
假设一开始全部都是使用的加法，选取其中(n + 1) / 2张卡片使用减法，那么从加法变为减法的代价是-y - x = -(x + y)
我当然希望这个代码越小越好，所以按照(x + y)从大到小排序，取前面(n + 1) / 2个为减法，其余的为加法
*/
bool cmp(PII a, PII b){
    return (a.fi + a.se) > (b.fi + b.se);
}

void solve(){
    
    int n; cin >> n;
    vector<PII> a(n + 10);
    for(int i = 1; i <= n; i ++){
        int x, y; cin >> x >> y;
        if(x > y) swap(x, y);
        a[i] = {x, y};
    }
    sort(a.begin() + 1, a.begin() + 1 + n, cmp);

    int ans = 0;
    for(int i = 1; i <= n; i ++){
        if(i <= (n + 1) / 2) ans -= a[i].se;
        else ans += a[i].fi;
    }
    cout << ans << endl;
    return ;
}
