bool cmp(pair<int, char> a, pair<int, char> b){
    if(a.se != b.se){
        if(a.se == 'B') return true;
        else return false;
    }
    else return a.fi < b.fi;
}

void solve(){
    
    int n; cin >> n;
    vector<pair<int, char> > a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i].fi;
    for(int i = 1; i <= n; i ++) cin >> a[i].se;

    sort(a.begin() + 1, a.begin() + 1 + n, cmp);

    for(int i = 1; i <= n; i ++){
        if(a[i].se == 'B'){
            if(i > a[i].fi){
                cout << "NO" << endl;
                return ;
            }
        }
        else{
            if(i < a[i].fi){
                cout << "NO" << endl;
                return ;
            }
        }
    }

    cout << "YES" << endl;
    return ;
}
