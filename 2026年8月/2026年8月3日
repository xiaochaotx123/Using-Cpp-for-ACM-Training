/*
https://www.matiji.net/exam/brushquestion/25/3846/4C6668FEB8CFD6520DE73B365B31D1A4
贪心的此策略是，将a数组和b数组都从小到大排序
1：如果a最小的 比 b最小的 大，那么score += 2
2：如果a最大的 比 b最大的 大，那么score += 2
3：如果上面两条都不成立，那么目前最优的是将a最小的与b最大的比较
    因为a最小的 比 b最小的 大 不成立，所以a最小的只能是小于或等于b最大的
    只需要看a最小的是否等于b最大的即可，score ++

这样通过上面的贪心策略可以求出a的最大分数
注意到总分值：
1：赢家+2，输家-0
2：平局各加1分
所以实际上两位玩家的总分一定是2n
那么求min_score，就等于2n - (另一位玩家的max_score)
*/
int work(vector<int> a, vector<int> b, int n){
    int res = 0;
    int la = 1, ra = n, lb = 1, rb = n;
    while(la <= ra){
        if(a[la] > b[lb]){
            res += 2;
            la ++, lb ++;
        }
        else if(a[ra] > b[rb]){
            res += 2;
            ra --, rb --;
        }
        else{
            if(a[la] == b[rb]) res ++;
            la ++, rb --;
        }
    }
    return res;
}

void solve(){
    
    int n; cin >> n;
    vector<int> a(n + 10), b(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i];
    for(int i = 1; i <= n; i ++) cin >> b[i];
    sort(a.begin() + 1, a.begin() + 1 + n);
    sort(b.begin() + 1, b.begin() + 1 + n);

    cout << work(a, b, n) << " " << 2 * n - work(b, a, n) << endl;
    return ;
}
