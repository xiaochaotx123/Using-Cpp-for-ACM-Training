/*
https://codeforces.com/gym/106632/problem/A
任何数都可以分解质因数相乘，x = p1^c1 × p2^c2 × p3^c3
所以x是否能被表示，则只需要看质因数pi^ci即可，因为质因数之间是独立的，所以只需要看c1,c2,...的情况
如果幂指数需要出现ci，那么最优的选择是拥有pi^1, pi^2, pi^4, pi^8,这样任意的pi^ci都可以表示出来，那么任意的一个x都可以表示出来
所以只需要先将1到1000000的所有质因数线性筛出来，然后枚举prime[i]^1, prime[i]^2, prime[i]^4对应的位置pos, cnt[pos] ++
然后累加前缀和即可
最后不要忘了加上1
*/
const int N = 1000000 + 100;

int prime[N], idx;
bool vis[N];
int cnt[N];

void init(){

    for(int i = 2; i < N; i ++){
        if(!vis[i]) prime[++ idx] = i;
        for(int j = 1; j <= idx && prime[j] <= N / i; j ++){
            vis[i * prime[j]] = true;
            if(i % prime[j] == 0) break;
        }
    }

    for(int i = 1; i <= idx; i ++){
        int sum = prime[i];
        while(sum <= N){
            cnt[sum] ++;
            sum *= sum;
        }
    }

    for(int i = 1; i < N; i ++) cnt[i] += cnt[i - 1];
    return ;
}

void solve(){
    init();
    
    int n; cin >> n;
    cout << cnt[n] + 1 << endl;
    return ;
}
