/*
https://www.matiji.net/exam/brushquestion/33/3846/4C6668FEB8CFD6520DE73B365B31D1A4
*/
string s;
int n;

int work(int l, int r){
    
    vector<int> all_num;
    vector<char> op;

    int num = 0;
    for(int i = l; i <= r; i ++){
        if('0' <= s[i] && s[i] <= '9'){
            if(num != -1) num = num * 10 + (s[i] - '0');
            else num = (s[i] - '0');
        }
        else if(s[i] == '|' || s[i] == '&'){
            all_num.pb(num);
            num = -1;    
            op.pb(s[i]);
        }
        else{
            int nl = i + 1, count = 1;
            int nr = i;
            while(count){
                nr ++;
                if(s[nr] == '(') count ++;
                if(s[nr] == ')') count --;
            }
            nr --;
            num = work(nl, nr);
            i = nr + 1;
        }
    }
    if(num != -1) all_num.pb(num);
    int fnum = all_num[0];

    for(int i = 1; i < sz(all_num); i ++){
        if(op[i - 1] == '&') fnum = min(fnum, all_num[i]);
        else fnum = max(fnum, all_num[i]);
    }
    return fnum;
}
void solve(){
    
    cin >> s;
    n = sz(s);
    s = " " + s;

    cout << work(1, n) << endl;
    return ;
}
