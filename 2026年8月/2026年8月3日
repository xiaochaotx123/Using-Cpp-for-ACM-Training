mt19937_64 rnd(time(0));

const int N = 200000 + 50000 + 100;
int hash_num[N], pre_hash_num[N];
void init(){
    for(int i = 1; i < N; i ++) hash_num[i] = rnd();
    for(int i = 1; i < N; i ++) pre_hash_num[i] = pre_hash_num[i - 1] + hash_num[i];
}
void solve(){
    
    int n, q; cin >> n >> q;
    vector<int> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i];    
    vector<ull> pre(n + 10);
    for(int i = 1; i <= n; i ++) pre[i] = pre[i - 1] + hash_num[a[i]];

    while(q --){
        int l, r; cin >> l >> r;
        ull sum = pre[r] - pre[l - 1];
        int len = r - l + 1;
        if(len & 1){
            cout << "No" << endl;
            continue;
        }
        int m = len / 2;
        ull sum1 = pre_hash_num[m] * 2;
        if(sum == sum1) cout << "Yes" << endl;
        else cout << "No" << endl; 
    }
    return ;

}
