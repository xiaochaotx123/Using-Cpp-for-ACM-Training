/*
https://www.matiji.net/exam/brushquestion/52/3846/4C6668FEB8CFD6520DE73B365B31D1A4
并查集+链表维护块

不断的合并相邻的两个块，使用l[i]表示i所在块的左端点，r[i]表示i所在块的右端点
nex[]数组表示合并块时，左边那个块的右端点连接的右边块的左端点
*/
const int N = 1000000 + 100;
int p[N];
int find(int x){
    if(x != p[x]) p[x] = find(p[x]);
    return p[x];
}

int l[N], r[N], nex[N];

void solve(){
    
    int n; cin >> n;

    for(int i = 1; i <= n; i ++){
        p[i] = i;
        l[i] = r[i] = i;
    }
    for(int i = 1; i <= n - 1; i ++){
        int u, v; cin >> u >> v;
        int fu = find(u), fv = find(v);
    
        nex[r[fu]] = l[fv];
        p[fu] = fv;
        l[fv] = l[fu];
    }    
    int root = find(1);
    int cur = l[root];
    while(cur > 0){
        cout << cur << " ";
        cur = nex[cur];
    }
    cout << endl;
    return ;
}
