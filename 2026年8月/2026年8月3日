    }
    
    int cnt = 0;
    for(int i = 1; i <= 2 * n; i ++){
        if(i == find(i)) cnt ++;
    }
    cout << 1;
    for(int i = 1; i <= cnt / 2; i ++) cout << 0;
    cout << endl;
    return ;
}
