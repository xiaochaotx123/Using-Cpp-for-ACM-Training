/*
https://www.matiji.net/exam/brushquestion/32/3846/4C6668FEB8CFD6520DE73B365B31D1A4
*/
void solve(){
    
    int n, m; cin >> n >> m;
    vector<int> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i];
    if(n == 1){
        cout << a[1] << endl;
        return ;
    }
    if(m > n / 2){
        cout << "Error!" << endl;
        return ;
    }

    int ans = 0;
    max_queue<pair<int, int> > q;
    vector<int> l(n + 10), r(n + 10), vis(n + 10);
    for(int i = 1; i <= n; i ++) q.push({a[i], i});
    for(int i = 1; i <= n; i ++){
        l[i] = i - 1;
        r[i] = i + 1;
    }
    l[1] = n;
    r[n] = 1;

    for(int i = 1; i <= m; i ++){
        while(vis[q.top().se]) q.pop();

        ans += q.top().fi;
        int idx = q.top().se;
        q.pop();

        int left = l[idx], right = r[idx];
        vis[left] = 1, vis[right] = 1;
        a[idx] = a[left] + a[right] - a[idx];
        
        q.push({a[idx], idx});
        r[l[left]] = idx;
        l[idx] = l[left];
        l[r[right]] = idx;
        r[idx] = r[right];
    }
    cout << ans << endl;
    return ;
}
