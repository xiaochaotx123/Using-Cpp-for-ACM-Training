int read() {
    int x = 0, f = 1;
    char ch = getchar();
    while (!isdigit(ch)) {
        if (ch == '-') f = -1;
        ch = getchar();
    }
    while (isdigit(ch)) {
        x = x * 10 + ch - '0';
        ch = getchar();
    }
    return x * f;
}

int write(int x) {
    if (x < 0) {
        putchar('-');
        x = -x;
    }
    if (x > 9) write(x / 10);
    putchar(x % 10 + '0');
    return x;
}

const int N = 200000 + 100;
const int M = 22;

int n, q;
int st[N][M];
int lg[N];

int gcd(int a, int b){
    if(!b) return a;
    else return gcd(b, a % b);
}

void solve(){
    
    lg[1] = 0;
    for(int i = 2; i < N; i ++) lg[i] = lg[i / 2] + 1;
    
    n = read();
    q = read();
    for(int i = 1; i <= n; i ++){
        int x = read();
        st[i][0] = x;
    }

    for(int j = 1; j < M; j ++){
        
        int half = (1LL << (j - 1));
        for(int i = 1; i + (1LL << j) - 1 <= n; i ++){
            st[i][j] = gcd(st[i][j - 1], st[i + half][j - 1]);
        }
    }

    while(q --){
        int l = read();
        int r = read();
        int k = lg[r - l + 1];
        cout << gcd(st[l][k], st[r - (1LL << k) + 1][k]) << endl;
    }
    return ;
}
