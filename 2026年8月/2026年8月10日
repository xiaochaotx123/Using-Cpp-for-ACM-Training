/*
https://codeforces.com/contest/2230/problem/D
显然如果[L, R]是合法的线段，那么区间[L, R - 1]也是合法的线段，故需要找到每个L最大值R即可

首先对于每一个位置[1, n]来说其中一个位置举例为L, 容易想到他们观看第一集的日子(设为第x天与第y天)，那么如果x不等于y，显然此时R = min(x, y) - 1
如果x和y相等，那么就去想他们观看第二集的日子(依旧设为x, y)如果x不等于y，那么此时R = min(x, y) - 1
就这么一直进行下去......直到要么x != y要么后面没有下一集了就停止了

那么如果解决上面的问题了，使用了动态规划的方法
从n向前到1遍历，pa[i]表示当前位置从左向右a[i]第一次出现的位置，如果不存在则默认为n + 1，pb[i]同理
显然需要一边更新pa[i], pb[i]一边计算贡献
dp[i]表示的是一i为L区间的左端点能够达到最远的区间右端点R的值
对于现在如果a[i] == b[i]，那么
*/ 
void solve(){
    
    int n; cin >> n;
    vector<int> a(n + 10), b(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i];
    for(int i = 1; i <= n; i ++) cin >> b[i];
    vector<int> pa(n + 10, n + 1), pb(n + 10, n + 1);
    vector<int> dp(n + 10, n + 1);

    int ans = 0;
    for(int i = n; i >= 1; i --){
        pa[a[i]] = i;
        pb[b[i]] = i;

        /*
        更新dp[i]
        如果这一天爱丽丝和鲍勃播放的是同一集，那么就去看后面第a[i] + 1集的情况
        如果爱丽丝和鲍勃播放第a[i] + 1集仍然在同一天，那么就可以更新dp[i] = dp[p[a]];
        否则说明播放的不是在同一天，那么dp[u] = min(pa[x], pb[x]) - 1;
        所以pa[]和pb[]数组是一边更新一边计算答案的，不能是先将pa,pb更新完后再来计算答案

        如果这一天爱丽丝和鲍勃播放的不是同一集，那么就去看第1集的情况
        */       
        if(a[i] == b[i]){
            int x = a[i] + 1;
            if(pa[x] == pb[x]) dp[i] = dp[pa[x]];
            else dp[i] = min(pa[x], pb[x]);
        }
        /*
        dp[i]表示的是这一天匹配了第a[i]集，区间能够延申的最远区间有边界R
        所以只与匹配的a[i] == b[i]有关系！
        */
        // else{
        //     if(pa[1] == pb[1]) dp[i] = dp[pa[1]];
        //     else dp[i] = min(pa[1], pb[1]) - 1;
        // }

        /*
        对于枚举的i来说充当为区间的左边界，寻找最远的有边界R，都需要从1开始判断！！
        */
        if(pa[1] == pb[1]) ans += dp[pa[1]] - i;
        else ans += min(pa[1], pb[1]) - i;
    }

    cout << ans << endl;
    return ;
}
