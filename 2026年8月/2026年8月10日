/*
https://codeforces.com/gym/104887/problem/C
*/
void solve(){
    
    int r, c, m, k; cin >> r >> c >> m >> k;
    vector<vector<int> > vis(r + 10, vector<int> (c + 10));
    
    if(m < k || k > min(r, c)){
        cout << "NO" << endl;
        return ;
    }

    for(int i = 1; i <= k; i ++){
        vis[i][i] = 1;
        m --;
    }

    for(int i = 1; i <= k; i ++){
        for(int j = 1; j <= k; j ++){
            if(vis[i][j]) continue;
            if(!m) break;
            vis[i][j] = 1;
            m --;
        }
        if(!m) break;
    }
    if(r <= c){
        for(int i = 1; i <= k; i ++){
            for(int j = 1; j <= c; j ++){
                if(vis[i][j]) continue;
                if(!m) break;
                vis[i][j] = 1;
                m --;
            }
            if(!m) break;
        }
    }
    else{
        for(int i = 1; i <= r; i ++){
            for(int j = 1; j <= k; j ++){
                if(vis[i][j]) continue;
                if(!m) break;
                vis[i][j] = 1;
                m --;
            }
            if(!m) break;
        }
    }

    if(m){
        cout << "NO" << endl;
        return ;
    }
    cout << "YES" << endl;
    for(int i = 1; i <= r; i ++){
        for(int j = 1; j <= c; j ++){
            if(vis[i][j]) cout << "#";
            else cout << ".";
        }
        cout << endl;
    }

    return ;
}
