/*
https://codeforces.com/contest/2230/problem/A
*/
void solve(){
    
    int n, a, b; cin >> n >> a >> b;
    if(b <= 3 * a){
        int ans = 0;
        ans += (n / 3) * b;
        n %= 3;
        if(n == 1){
            if(b <= a) ans += b;
            else ans += a;
        }
        if(n == 2){
            if(b <= 2 * a) ans += b;
            else ans += 2 * a;
        }
        cout << ans << endl;
    }
    else cout << n * a << endl;
    return ;
}
