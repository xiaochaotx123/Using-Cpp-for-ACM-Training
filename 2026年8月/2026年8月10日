/*
https://codeforces.com/contest/2254/problem/G
*/
const int N = 200000 + 100;
int n, a[N];

void solve(){
    
    cin >> n;
    for(int i = 1; i <= n; i ++) cin >> a[i];
    vector<min_queue<int> > q(n + 10);
    vector<int> extra;
    
    vector<vector<int> > adj(n + 10);
    for(int i = 2; i <= n; i ++){
        int fa; cin >> fa;
        adj[fa].pb(i);
    }

    for(int u = n; u >= 1; u --){
        if(!sz(adj[u])){
            q[u].push(a[u]);
        }
        else{
            int idx = adj[u][0];
            for(int v : adj[u]){
                if(sz(q[v]) > sz(q[idx])) idx = v;
            }
            swap(q[u], q[idx]);

            for(int v : adj[u]){
                if(v == idx) continue;

                while(sz(q[v])){
                    q[u].push(q[v].top());
                    q[v].pop();
                }

                min_queue<int>().swap(q[v]);
            }

            int x = q[u].top();
            q[u].pop();
            q[u].push(max(x, a[u]));
            if(a[u] <= x) extra.pb(a[u]);
            else extra.pb(x);
        }
    }

    int leaves = sz(q[1]);

    long long ans = 0;
    while(sz(q[1])){
        ans += q[1].top();
        q[1].pop();
    }

    sort(all(extra));
    for(int i = 1; i <= n; i ++){
        if(i < leaves) cout << -1 << " ";
        else{
            cout << ans << " ";
            if(i < n) ans += extra.back();
            if(i < n) extra.pop_back();
        }
    }
    cout << endl;
    return ;
}
