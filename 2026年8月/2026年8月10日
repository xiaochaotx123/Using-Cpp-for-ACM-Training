/*
https://codeforces.com/contest/2230/problem/B
*/
void solve(){
    
    string s; cin >> s;
    int n = sz(s);
    s = " " + s;
    int ans = 0;
    vector<int> pre1(n + 10), pre3(n + 10);
    for(int i = 1; i <= n; i ++){
        pre1[i] = pre1[i - 1];
        pre3[i] = pre3[i - 1];
        if(s[i] == '1' || s[i] == '3') pre1[i] ++;
        if(s[i] == '2') pre3[i] ++;
        if(s[i] == '4') ans ++;
    }
    int min_num = inf;
    for(int i = 0; i <= n; i ++){
        min_num = min(min_num, pre1[i] + pre3[n] - pre3[i]);
    }
    // for(int i = 1; i <= n; i ++) cout << pre1[i] << " ";
    // cout << endl;
    // for(int i = 1; i <= n; i ++) cout << pre3[i] << " ";
    // cout << endl;

    cout << ans + min_num << endl;
    
    return ;
}
