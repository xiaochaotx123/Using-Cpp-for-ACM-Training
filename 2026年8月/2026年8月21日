/*
https://codeforces.com/contest/148/problem/E
*/

void solve(){
    
    int n, m; cin >> n >> m;
    vector<int> dp(m + 10);
    
    for(int i = 1; i <= n; i ++){
        int k; cin >> k;
        vector<int> a(k + 10), f(k + 10), pre(k + 10), suf(k + 10);
        for(int i = 1; i <= k; i ++) cin >> a[i];
        for(int i = 1; i <= k; i ++) pre[i] = pre[i - 1] + a[i];
        for(int i = k; i >= 1; i --) suf[i] = suf[i + 1] + a[i];

        for(int len = 0; len <= k; len ++){
            for(int l = 1; l <= k - len + 1; l ++){
                int r = l + len - 1;
                int res_len = k - len;
                // cout << len << " " << l << ' ' << r << " " << res_len << " " << pre[l - 1] + suf[r + 1] << endl;
                f[res_len] = max(f[res_len], pre[l - 1] + suf[r + 1]);
            }
        }

        for(int j = m; j >= 1; j --){
            for(int z = 1; z <= k; z ++){
                if(j >= z) dp[j] = max(dp[j], dp[j - z] + f[z]);
            }
        }
    }
    
    cout << dp[m] << endl;
    return ;
}
