/*
https://codeforces.com/contest/148/problem/B
*/

void solve(){
    
    double vp, vd, t, f, c; cin >> vp >> vd >> t >> f >> c;

    int ans = 0;
    double pos = vp * t;

    if(pos >= c || vp >= vd){
        cout << 0 << endl;
        return ;
    }

    while(1){
        if(pos >= c) break;
        double x = pos * 1.0 / (vd - vp);
        pos += x * vp;
        if(pos >= c) break;
        ans ++;
        pos += ((pos / vd) + f) * vp;
    }
    cout << ans << endl;
    return ;
}
