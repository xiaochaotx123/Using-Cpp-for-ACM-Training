const int mod = 998244353;

void solve(){
    
    int n; cin >> n;
    vector<int> a(n + 10);
    for(int i = 1; i <= n; i ++) cin >> a[i];

    int x = 0;

    bool ok = true;
    for(int i = 1; i <= n; i ++){

        if(i == 1){
            if(a[i] >= 2) ok = false;
            x = (x + a[i]) % mod;
        }
        else{
            if(a[i] != 0){
                if(a[i] == 1){
                    if(x >= 1) ok = false;
                    x = (x + a[i]) % mod;
                }
                else{
                    if(x == 0){
                        if(ok) x = (x + a[i]) % mod;
                        else{
                            if(a[i] >= 2) ok = false;
                            x = (x * a[i]) % mod;
                        }
                    }
                    else if(x == 1){
                        if(ok) x = (x + a[i]) % mod;
                        else x = (x * a[i]) % mod;
                        ok = false;
                    }
                    else{
                        x = (x * a[i]) % mod;
                        ok = false;
                    }
                }
            }
        }
    }
    cout << x << endl;
    return ;
}

