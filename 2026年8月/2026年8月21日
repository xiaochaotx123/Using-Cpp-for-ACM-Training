const int N = 100000 + 100;
int n, m;
vector<PII> adj[N];
double p[N], dist[N];
int deg[N];

void solve(){
    
    cin >> n >> m;
    for(int i = 1; i <= m; i ++){
        int u, v, w; cin >> u >> v >> w;
        adj[u].pb({v, w});
        deg[v] ++;
    }

    queue<int> q;
    q.push(1);

    p[1] = 1.0;
    dist[1] = 0.0;

    while(q.size()){
        int u = q.front(); q.pop();
        int fm = sz(adj[u]);
        
        for(auto [v, w] : adj[u]){
            if(-- deg[v] == 0) q.push(v);

            p[v] += p[u] * 1.0 / fm;
            dist[v] += dist[u] * 1.0 / fm + w * (p[u] * 1.0 / fm);
        }
    }
    cout << fixed << setprecision(2) << dist[n] << endl;
    return ;
}
