/*
https://codeforces.com/contest/148/problem/C
*/

void solve(){
    
    int n, ca, cb; cin >> n >> ca >> cb;
    if(n == 1){
        cout << 1 << endl;
        return ;
    }

    if(cb == 0){
        if(ca == n - 1){
            cout << -1 << endl;
            return ;
        }
        vector<int> ans(n + 10);
        ans[1] = 100;
        ans[2] = 100;
        for(int i = 3; i <= n; i ++){
            if(ca) ans[i] = ans[i - 1] + 1, ca --;
            else ans[i] = ans[i - 1];
        }
        for(int i = 1; i <= n; i ++) cout << ans[i] << " ";
        cout << endl;
        return;
    }
    vector<int> a(n + 10);
    int total_sum = 0;
    for(int i = 1; i <= n; i ++){
        if(i == 1){
            a[i] = 1;
            total_sum += a[i];
        }
        else{
            if(cb) a[i] = total_sum + 1, cb --;
            else if(ca) a[i] = a[i - 1] + 1, ca --;
            else a[i] = a[i - 1];
            total_sum += a[i];
        }
        if(a[i] > 50000){
            cout << -1 << endl;
            return ;
        }
    }

    for(int i = 1; i <= n; i ++) cout << a[i] << " ";
    cout << endl;
    return ;
}
