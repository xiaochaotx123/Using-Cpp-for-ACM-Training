const int N = 3000 + 100;
const int mod = 1000000000 + 7;

int f[N][N];

int ksm(int a, int b, int p){
    int sum = 1;
    while(b){
        if(b & 1) sum = (sum * a) % p;
        b >>= 1;
        a = (a * a) % p;
    }
    return sum;
}

int inv(int x){
    return ksm(x, mod - 2, mod);
}

void solve(){
    
    int x, a1, b1, a2, b2; cin >> x >> a1 >> b1 >> a2 >> b2;

    int p1 = a1 * inv(b1) % mod;
    int q1 = (1 - p1 + mod) % mod;
    int p2 = a2 * inv(b2) % mod;
    int q2 = (1 - p2 + mod) % mod;

    int denom = (1 - q1 * q2 % mod + mod) % mod;
    int inv_denom = inv(denom);

    for(int i = 0; i <= x - 1; i ++) f[i][x] = 1;

    for(int i = x - 1; i >= 0; i --){
        for(int j = x - 1; j >= 0; j --){

            int num = 0;
            num = (num + p1 * p2 % mod * f[i + 1][j + 1]) % mod;
            num = (num + p1 * q2 % mod * f[i + 1][j]) % mod;
            num = (num + q1 * p2 % mod * f[i][j + 1]) % mod;
            
            f[i][j] = num * inv_denom % mod;
        }
    }
    cout << f[0][0] << endl;
    return ;
}
