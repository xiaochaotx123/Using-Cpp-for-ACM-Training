const int N = 1000 + 100;
double f[N][N];


double dfs(int n, int m){
    if(n <= 0) return 0;
    if(m <= 0) return 1;
    if(f[n][m] != -1) return f[n][m];

    double ans = n * 1.0 / (n + m);

    if(m >= 2){
        double p = m * 1.0 / (n + m);
        p *= (m - 1) * 1.0 / (n + m - 1);

        if(m >= 3) ans += p * (m - 2) * 1.0 / (n + m - 2) * dfs(n, m - 3);
        if(n >= 1) ans += p * n * 1.0 / (n + m - 2) * dfs(n - 1, m - 2);
    }
    return f[n][m] = ans;
}
void solve(){
    

    int n, m; cin >> n >> m;

    for(int i = 0; i <= n; i ++){
        for(int j = 0; j <= m; j ++) f[i][j] = -1;
    }
    cout << fixed << setprecision(9) << dfs(n, m) << endl;        
    return ;
}
