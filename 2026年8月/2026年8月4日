int dx[] = {0, 0, 1, -1};
int dy[] = {1, -1, 0, 0};
int n, m;

void bfs(int x, int y, vector<vector<char> > a, vector<vector<bool> > &vis){
    queue<PII> q;
    q.push({x, y});

    while(q.size()){
        int x1 = q.front().fi, y1 = q.front().se;
        q.pop();
        vis[x1][y1] = 1;

        for(int i = 0; i < 4; i ++){
            int nx = x1 + dx[i];
            int ny = y1 + dy[i];
            if(nx < 1 || nx > n || ny < 1 || ny > m) continue;
            if(a[nx][ny] == '0') continue;
            if(vis[nx][ny]) continue;
            q.push({nx, ny});
            vis[nx][ny] = 1;
        }
    }
}
void solve(){
    
    cin >> n >> m;
    vector<vector<char> > a(n + 10, vector<char> (m + 10));
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= m; j ++) cin >> a[i][j];
    }
    int final_cnt = 0;
    for(int j = 1; j <= m; j ++){
        if(a[n][j] == '1') final_cnt ++;
    }
    if(final_cnt < 2){
        cout << "No" << endl;
        return ;
    }
    vector<vector<bool> > vis(n + 10, vector<bool> (m + 10, false));
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= m; j ++){
            if(a[i][j] == '1'){
                bfs(i, j, a, vis);
                
                for(int ii = 1; ii <= n; ii ++){
                    for(int jj = 1; jj <= m; jj ++){
                        if(a[ii][jj] == '1' && vis[ii][jj] == 0){
                            cout << "No" << endl;
                            return ;
                        }
                    }
                }

                cout << "Yes" << endl;
                return ;

            }
        }
    }
    return ;
}
