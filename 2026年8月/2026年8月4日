const int N = 200000 + 100;

int n, a[N];

struct Node{
    int l, r;
    int cnt;
}tr[4 * N];

void push_up(int u){
    tr[u].cnt = (tr[u << 1].cnt + tr[u << 1 | 1].cnt);
}

void modify(int u, int l, int r){
    if(l == r){
        tr[u] = {l, r, 0};
        return ;
    }
    else{
        tr[u] = {l, r, 0};
        int mid = (tr[u].l + tr[u].r) >> 1;
        modify(u << 1, l, mid);
        modify(u << 1 | 1, mid + 1, r);
    }
}

int query(int u, int l, int r){
    if(l <= tr[u].l && tr[u].r <= r) return tr[u].cnt;
    else{
        int res = 0;
        int mid = (tr[u].l + tr[u].r) >> 1;
        if(l <= mid) res += query(u << 1, l, r);
        if(r > mid) res += query(u << 1 | 1, mid + 1, r);
        return res;
    }
}

void modify(int u, int x){
    if(tr[u].l == tr[u].r){
        tr[u].cnt ++;
        return ;
    }
    else{
        int mid = (tr[u].l + tr[u].r) >> 1;
        if(x <= mid) modify(u << 1, x);
        else modify(u << 1 | 1, x);
        push_up(u);
    }
}   

void solve(){
    
    cin >> n;
    for(int i = 1; i <= n; i ++) cin >> a[i];
    
    modify(1, 1, 100000);

    int ans = 0;
    for(int i = n; i >= 1; i --){
        if(a[i] - 1 >= 1) ans += query(1, 1, a[i] - 1);
        modify(1, a[i]);
    }
    
    int q; cin >> q;
    while(q --){
        int l, r; cin >> l >> r;
        int len = r - l + 1;
        len = (len - 1) * len / 2;
        if(len & 1) ans ++;
        cout << (ans & 1) << endl;
    }
    return ;
}
