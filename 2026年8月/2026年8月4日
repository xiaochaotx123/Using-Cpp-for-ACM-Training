const int N = 200000 + 100;

// points[i]记录的是这n个守卫的坐标，使用double类型
struct Node1{
    double x, y;
}points[N];


// deges[i]记录的是这m条关系，u和v需要和解成为朋友的平均工资
struct Node2{
    int u, v;
    double w;
}edges[N];

// p[i]使用并查集的父节点数组
int p[N];


// id[i]表示的是所属块的标号
int id[N];

int find(int x){
    if(x != p[x]) p[x] = find(p[x]);
    return p[x];
}

void unite(int u, int v){
    int fu = find(u), fv = find(v);
    if(fu != fv) p[fu] = fv;
}
int n, m;
double k;

bool cmp(Node2 a, Node2 b){
    return a.w < b.w;
}

void solve(){
    
    cin >> n >> m >> k;
    for(int i = 1; i <= n; i ++) cin >> points[i].x >> points[i].y;
    
    double max_w = 0.0;

    for(int i = 1; i <= m; i ++){
        cin >> edges[i].u >> edges[i].v >> edges[i].w;
        max_w = max(max_w, edges[i].w);
    }

    if(k <= eps){
        cout << "0.000" << endl;
        return ;
    }


    for(int i = 1; i <= n; i ++) p[i] = i;
   
/*
网络分块法(又称空间哈希或离散化网络优化), 是一种在二维平面中处理"距离"或"邻近关系"时极为常用
的空间优化算法
本题中距离公式时切比雪夫距离：d = max(|x1 - x2|, |y1 - y2|)
如果我想知道哪两个点是的切比雪夫距离是小于K的，那么如果暴力枚举就是时间复杂度是O(n^2)
我们可以将整个二维平面划分为边长为K的正方形网格，映射关系
gx = floor(x / k + eps)
gy = floor(y / k + eps)
这样只需要看当前网格周围9个网格的点就可以了，时间复杂度优化至O(9×n)
*/
    map<int, int> grid;
    for(int i = 1; i <= n; i ++){
        int gx = floor(points[i].x / k + eps);
        int gy = floor(points[i].y / k + eps);

        for(int dx = -1; dx <= 1; dx ++){
            for(int dy = -1; dy <= 1; dy ++){
                // key是映射值，将二维左边映射为一个数字，方便处理
                int key = (gx + dx) * 1000000007LL + (gy + dy);

                // 如果当前这个网格中已经存在点了，那么就判断切比雪夫距离是否小于k
                if(grid.count(key)){
                    int j = grid[key];
                    double dist = max(abs(points[i].x - points[j].x), abs(points[i].y - points[j].y));
                    // 如果距离小于k，那么就合并这两个点；维护集合中任意两点的距离就是小于K的
                    if(dist < k - eps) unite(i, j);
                }
            }
        }

        int key = gx * 1000000007LL + gy;
        // 对于当前块来说，如果当前块不存在任何一个点，那么就给这个块赋值一个代表点
        if(!grid.count(key)) grid[key] = find(i);
        else{
            // 如果当前块存在点的话直接合并
            unite(grid[key], i);
            grid[key] = find(i);
        }
    }

    // id[i]表示的是与i点距离小于k的集合的祖先节点
    for(int i = 1; i <= n; i ++) id[i] = find(i);

    // 按照边的长度从小到大排序
    sort(edges + 1, edges + 1 + m, cmp);
    
    double l = 0.0, r = max_w, ans = 0.0;
    for(int cc = 1; cc <= 60; cc ++){
        double mid = (l + r) / 2.0;

        for(int i = 1; i <= n; i ++) p[i] = i;

        for(int i = 1; i <= m; i ++){
            if(edges[i].w <= mid + eps) unite(edges[i].u, edges[i].v);
            else break;
        }

        bool ok = true;
        int root[N];
        // root表示的是在当前的二分mid中，第cid个强制连通块中，目前已经访问到的节点的并查集根节点
        for(int i = 1; i <= n; i ++) root[i] = -1;

        for(int i = 1; i <= n; i ++){
            int cid = id[i]; // cid表示的是i所属强制连通块的编号
            int r = find(i); // r是i在当前工资mid下属于哪个并查集根
            if(root[cid] == -1) root[cid] = r;
            else if(root[cid] != r){
                ok = false;
                break;
            }
        }
        if(ok){
            ans = mid;
            r = mid;
        }
        else l = mid;
    }
    cout << fixed << setprecision(3) << ans << endl;
    return ;
}
