/*
可持久化线段树，又叫做主席树
做一次修改操作，就生成一棵新版本线段树，去处理比较复杂的的区间查询问题
如果生成n个版本的线段树，有m个查询操作，那么单次生成、单次查询的时间复杂度就是O(log(n))

单点修改的可持久化线段树
1，单点修改操作，不需要懒更新机制
2，新版本的线段树生成时，沿途节点新建，其他节点复用，新建的空间为O(log(n))
3，查询单点x的信息时，根据版本号，从头节点往下找到x位置对应的的节点即可
4，查询范围l~r的信息时，利用 r版本的信息  -(l - 1)版本的信息 完成查询
5，总空间O(4 × n + n × log(n))

在可持续化线段树中，节点的编号是杂乱无章的，编号id是按照创建的顺序(id ++)分配的，完全不是普通线段树中2u和2u+1的关系
所以无论是build函数中，还是modify，query函数中，递归的形式都是(tr[u].l, ....), (tr[u].r, ....)这样子的
*/
/*
P3919 【模板】可持久化线段树 1（可持久化数组）
https://www.luogu.com.cn/problem/P3919
*/
#include<bits/stdc++.h>
using namespace std;

#define endl '\n'
#define int long long
#define ull unsigned long long
#define IOS ios::sync_with_stdio(false);cin.tie(NULL);cout.tie(NULL);
#define HelloWorld IOS;

using PII = pair<int, int>;
#define fi first
#define se second
#define pb push_back
#define sz(x) ((int)(x).size())
#define all(x) (x).begin(), (x).end()
template<typename T> using max_queue = priority_queue<T>;
template<typename T> using min_queue = priority_queue<T, vector<T>, greater<T>>;
const double eps = 1e-9;
const int inf = 3000000000000000000;
const int rinf = -3000000000000000000;
const bool HAVE_CASE = false;


const int N = 1000000 + 100;

int n, m;
int a[N];

/*
由于每次操作均会创建log(n)个节点，因此我们最多额外添加Q × log(n)个节点(Q是询问个数), 所以可持久化线段是的空间要求较高。
一般采用开20或30倍的空间来避免空间不足的问题

tr[]: 存储所有节点的数组, 这里的l和r不是区间边界, 而是左右孩子在数组中的下标, 因为是动态开点, 节点编号不再是连续的堆式编号
*/
struct Node{
    int l, r; // 左, 右子节点的编号
    int val; // 当前节点维护的值
}tr[30 * N]; // 动态开点, 预留足够空间

/*
一般来说, 可持续化线段树使用动态开点实现, 因此我们需要额外记录当前节点的编号id.
为实现实时访问历史版本的功能, 我们还需要记录根节点
*/
int id; // 编号, 全局节点编号计数器, 用于动态开点; 每新建一个节点, id就加1, 保证每个节点都有唯一编号
int root[N]; // 根节点, root[i]存储第i个版本的根节点编号; 每个版本都通过它的根节点来访问. root[0]是初始版本, root[i]是第i次操作后的版本

/*
动态开点, 创建新节点操作, 克隆节点的操作, 它创建一个与节点u一模一样的副本, 并返回新节点的编号.
这是实现"只新建改变部分"的基础
*/
int insert(int u){
    id ++;
    tr[id] = tr[u];
    return id;
}

/*
建树操作, 可持续化线段树的原始建树过程和线段树基本一样
构建初始版本(版本0)的线段树, 它与普通线段树的建树过程几乎一模一样, 只是用了动态开点的方式
这个函数的作用非常单纯，在输出状态下（版本0），新建一棵完整的线段树，并给每个节点分配一个唯一的编号id
它不涉及任何历史版本的复用，就是"从零开始"建树

不涉及任何历史版本的复用，是因为build是创建的第一个版本，此时线段树是空的，所有节点都是崭新的，没有任何节点可以复用，所以
直接一路id++暴力新建所有节点即可
而insert复用只有modify(修改操作)才需要复用旧节点，因为要保留即使版本
*/
int build(int u, int l, int r){
    id ++, u = id; // 赋予编号，其实无论u传进来是什么，都会被id覆盖掉
    if(l == r){
        tr[u].val = a[l];
        return id; // 返回编号
    }
    else{
        int mid = (l + r) >> 1;
        /*
        看build中的第一行代码: id ++, u = id
        所以无论调用build函数中u是什么, 都会被id赋值给覆盖掉
        */
        tr[u].l = build(tr[u].l, l, mid); // 递归左子树
        tr[u].r = build(tr[u].r, mid + 1, r); // 递归右子树
        return u;
    }
}

/*
模板题目的两个操作：
修改某个历史版本上的某一个位置的值
查询某个历史版本上的某一个位置的值

这就是可持续化线段树的修改操作(modify)以及查询操作(query)
由于每个历史版本的线段树我们都能够由不同的根节点独立访问，因此这零个操作与普通线段是也是一样的

modify函数创建了一条从根到叶子的新路径（这些节点都是新id），其余未被修改的地方直接是复制上一个版本的节点，这样就不需要重新花费空间了
*/
int modify(int u, int l, int r, int p, int val){
    u = insert(u); // 1, 克隆当前节点, 此时的u已经成了一个全新副本
    if(l == r){
        tr[u].val = val; // 2, 如果到大叶子节点, 直接修改叶子节点的值
        return u;
    }
    else{
        int mid = (l + r) >> 1;
        // 3. 递归修改左右子树, 并修改左右子树的标号
        /*
        如果不在叶子节点, 则递归调用modify去修改发生变化的那个还.
        modify函数会返回新子树的根节点编号, 我们用这个新编号来更新当前副本u的l或r指针
        这样, 从根到叶子路径上的所有节点都被赋值并修改了, 而其他子树的指针则执行就版本的节点, 实现的复用
        */
        if(p <= mid) tr[u].l = modify(tr[u].l, l, mid, p, val);
        else tr[u].r = modify(tr[u].r, mid + 1, r, p, val);
        return u;
    }
}

int query(int u, int l, int r, int p){
    if(l == r) return tr[u].val;
    int mid = (l + r) >> 1;
    if(p <= mid) return query(tr[u].l, l, mid, p);
    else return query(tr[u].r, mid + 1, r, p);
}


void solve(){
    
    cin >> n >> m;
    for(int i = 1; i <= n; i ++) cin >> a[i];

    root[0] = build(0, 1, n); // 建立版本0
    for(int i = 1; i <= m; i ++){
        int ver, op; cin >> ver >> op;
        if(op == 1){
            int p, c; cin >> p >> c;
            /*
            root[i]表示的新版本的根节点
            */
            root[i] = modify(root[ver], 1, n, p, c); // 在版本ver上修改, 产生新版本i
        }
        else{
            int p; cin >> p;
            cout << query(root[ver], 1, n, p) << endl; 
            root[i] = root[ver]; // 查询操作不产生新版本, 所有版本i与版本ver相同
        }
    }
    return ;
}

signed main(){
    HelloWorld;

    int tt = 1; 
    if(HAVE_CASE) cin >> tt;
    while(tt --) solve();
    return 0;
}


/*
P3834 【模板】可持久化线段树 2（静态区间第 k 小）
https://www.luogu.com.cn/problem/P3834
*/
const int N = 200000 + 100;

int n, m;
int a[N], b[N], len;


struct Node{
    int l, r;
    int cnt; 
}tr[30 * N];

int id;
int root[N];


void push_up(int u){
    tr[u].cnt = (tr[tr[u].l].cnt + tr[tr[u].r].cnt);
}

int insert(int u){
    ++ id;
    tr[id] = tr[u];
    return id;
}

int modify(int u, int l, int r, int pos){
    u = insert(u);
    if(l == r){
        tr[u].cnt ++;
        return u;
    }
    else{
        int mid = (l + r) >> 1;
        if(pos <= mid) tr[u].l = modify(tr[u].l, l, mid, pos);
        else tr[u].r = modify(tr[u].r, mid + 1, r, pos);
        push_up(u);
        return u;
    }
}

int query(int u, int v, int l, int r, int k){
    if(l == r) return l;
    else{
        int mid = (l + r) >> 1;
        int left_cnt = tr[tr[u].l].cnt - tr[tr[v].l].cnt;
        if(k <= left_cnt) return query(tr[u].l, tr[v].l, l, mid, k);
        else return query(tr[u].r, tr[v].r, mid + 1, r, k - left_cnt);
    }
}
void solve(){
    
    cin >> n >> m;
    for(int i = 1; i <= n; i ++){
        cin >> a[i];
        b[i] = a[i];
    }
    sort(b + 1, b + 1 + n);
    len = unique(b + 1, b + 1 + n) - (b + 1);
    
    root[0] = 0;    

    for(int i = 1; i <= n; i ++){
        int pos = lower_bound(b + 1, b + 1 + len, a[i]) - b;
        root[i] = modify(root[i - 1], 1, len, pos);
    }

    for(int i = 1; i <= m; i ++){
        int l, r, k; cin >> l >> r >> k;
        int ans_pos = query(root[r], root[l - 1], 1, len, k);
        cout << b[ans_pos] << endl;
    }
    return ;
}
