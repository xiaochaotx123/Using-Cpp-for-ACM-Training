    for(int i = 1; i <= n; i ++){
        cin >> a[i];
        p[i] = i;
        num[i] = a[i];
    }
    for(int i = 1; i <= n; i ++) cin >> b[i];
    
    int ans = 0, max_num = 0;
    for(int i = n; i >= 1; i --){
        ans += max_num;

        int u = b[i];
        vis[u] = 1;
        if(1 <= u - 1 && u - 1 <= n && vis[u - 1]){
            int fu = find(u);
            int fv = find(u - 1);
            if(fu != fv){
                num[fu] += num[fv];
                p[fv] = fu;
            }
        }
        if(1 <= u + 1 && u + 1 <= n && vis[u + 1]){
            int fu = find(u);
            int fv = find(u + 1);
            if(fu != fv){
                num[fu] += num[fv];
                p[fv] = fu;
            }
        }
        max_num = max(max_num, num[find(u)]);
    }
    cout << ans << endl;

    return ;
