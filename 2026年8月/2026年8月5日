/*
https://www.matiji.net/exam/brushquestion/64/3846/4C6668FEB8CFD6520DE73B365B31D1A4

排列的性质：排列的逆序对数 = 操作数（仅交换相邻两个位置的数使得最终排列递增）
如果我可以最多执行一次特殊的操作：可以交换不相邻的位置，求最少的交换次数
设原来一开始的排列的逆序对数为cnt，也就是说经过一次交换不相邻位置的操作后cnt最小
    交换的两个位置是偏离原来位置最左边和最右边的两个位置
*/
bool cmp(PII a, PII b){
    return a.first < b.first;
}

const int N = 300000 + 100;
int n, a[N];

struct Node{
    int l, r;
    int cnt;
}tr[4 * N];


void push_up(int u){
    tr[u].cnt = (tr[u << 1].cnt + tr[u << 1 | 1].cnt);
}

void build(int u, int l, int r){
    if(l == r){
        tr[u] = {l, r, 0};
        return ;
    }
    else{
        tr[u] = {l, r, 0};
        int mid = (tr[u].l + tr[u].r) >> 1;
        build(u << 1, l, mid);
        build(u << 1 | 1, mid + 1, r);
    }
}

void modify(int u, int pos){
    if(tr[u].l == tr[u].r){
        tr[u].cnt ++;
        return ;
    }
    else{
        int mid = (tr[u].l + tr[u].r) >> 1;
        if(pos <= mid) modify(u << 1, pos);
        else modify(u << 1 | 1, pos);

        push_up(u);
    }
}

int query(int u, int l, int r){
    if(l <= tr[u].l && tr[u].r <= r) return tr[u].cnt;
    else{
        int mid = (tr[u].l + tr[u].r) >> 1;
        int res = 0;
        if(l <= mid) res += query(u << 1, l, r);
        if(r > mid) res += query(u << 1 | 1, l, r);
        return res;
    }
}

void solve(){
    
    int n; cin >> n;
    vector<PII> b(n + 10);
    for(int i = 1; i <= n; i ++){
        cin >> a[i];
        b[i].fi = a[i] - i;;
        b[i].se = i;
    }

    sort(b.begin() + 1, b.begin() + 1 + n, cmp);

    if(b[1].fi == 0 && b[n].fi == 0){
        cout << 0 << endl;
        return ;
    }
    
    swap(a[b[1].se], a[b[n].se]);

    int ans = 0;
    build(1, 1, 300000 + 10);

    for(int i = 1; i <= n; i ++){
        if(a[i] + 1 <= n) ans += query(1, a[i] + 1, n);
        modify(1, a[i]);
    }
    cout << ans + 1 << endl;
    return ;
}
