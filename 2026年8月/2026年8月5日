/*
https://codeforces.com/contest/2254/problem/A
*/
void solve(){
    
    int a, b, c; cin >> a >> b >> c;
    int ans = 0;
    while(a != b && b != c && a != c){
        if(a < b) swap(a, b);
        if(a < c) swap(a, c);
        if(b < c) swap(b, c);
        a --, c ++;
        ans ++;
    }
    cout << ans << endl;
    return ;
}
