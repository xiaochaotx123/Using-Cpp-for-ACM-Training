bool cmp(PII a, PII b){
    return a.first < b.first;
}

void solve(){
    
    int n; cin >> n;
    vector<int> a(n + 10);
    vector<PII> b(n + 10), c;

    for(int i = 1; i <= n; i ++){
        cin >> a[i];
        b[i] = {a[i], i};
    }


    sort(b.begin() + 1, b.begin() + 1 + n, cmp);
    for(int i = 1; i <= n; i ++){
        int cnt = 1;
        while(i + 1 <= n && b[i].fi == b[i + 1].fi){
            cnt ++;
            i ++;
        }
        c.pb({b[i].fi, cnt});
    }

    // for(auto [num, cnt] : c) cout << num << " " << cnt << endl;

    if(c[0].fi){
        cout << -1 << endl;
        return ;
    }
    if(sz(c) == 1){
        for(int i = 1; i <= n; i ++) cout << 1 << " ";
        cout << endl;
        return ;
    }

    map<int, int> ma;
    for(int i = 0; i < sz(c) - 1; i ++){
        if((c[i + 1].fi - c[i].fi) % c[i].se){
            cout << -1 << endl;
            return ;
        }
        ma[c[i].fi] = (c[i + 1].fi - c[i].fi) / c[i].se;
    }

    ma[c[sz(c) - 1].fi] = ma[c[sz(c) - 2].fi] + 1;
    for(int i = 0; i < sz(c) - 1; i ++){
        if(ma[c[i].fi] >= ma[c[i + 1].fi]){
            cout << -1 << endl;
            return ;
        }
    }
    for(int i = 1; i <= n; i ++) cout << ma[a[i]] << " ";
    cout << endl;

    return ;
}
