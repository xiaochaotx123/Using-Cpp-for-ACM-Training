const int N = 500000 + 100;

struct Node{
    int l, r;
    bitset<30> bt;
}tr[4 * N];

int n, m;

void push_up(int u){
    tr[u].bt = (tr[u << 1].bt | tr[u << 1 | 1].bt);
}

void build(int u, int l, int r){
    if(l == r){
        tr[u].l = l;
        tr[u].r = r;
        return ;
    }
    else{
        tr[u].l = l, tr[u].r = r;
        int mid = (tr[u].l + tr[u].r) >> 1;
        build(u << 1, l, mid);
        build(u << 1 | 1, mid + 1, r);
    }
}

void modify(int u, int pos, int num){
    if(tr[u].l == tr[u].r){
        tr[u].bt.reset();
        tr[u].bt[num] = 1;
        return ;
    }
    else{
        int mid = (tr[u].l + tr[u].r) >> 1;
        if(pos <= mid) modify(u << 1, pos, num);
        else modify(u << 1 | 1, pos, num);
        
        push_up(u);
    }
}

bitset<30> query(int u, int l, int r){
    if(l <= tr[u].l && tr[u].r <= r) return tr[u].bt;
    else{
        int mid = (tr[u].l + tr[u].r) >> 1;
        bitset<30> res;
        if(l <= mid) res |= query(u << 1, l, r);
        if(r > mid) res |= query(u << 1 | 1, l, r);
        return res;
    }
}

void solve(){
    
    cin >> n;
    build(1, 1, n);

    for(int i = 1; i <= n; i ++){
        char ch; cin >> ch;
        int num = ch - 'a';
        modify(1, i, num);
    }

    cin >> m;
    for(int i = 1; i <= m; i ++){
        int op; cin >> op;
        if(op == 1){
            int pos;
            char ch; 
            cin >> pos >> ch;
            int value = ch - 'a';
            modify(1, pos, value);
        }
        else{
            int l, r; cin >> l >> r;
            bitset<30> ans = query(1, l, r);
            cout << ans.count() << endl;
        }
    }
    return ;
}
