/*
https://www.matiji.net/exam/brushquestion/65/3846/4C6668FEB8CFD6520DE73B365B31D1A4

题目给了表达式中，仔细分析：对于i来说是任意的i，那么满足|a[x] - a[y]| <= |a[x] - a[i]| (i != x, x != y)
因为i是任意的从1到n，考虑从小到大的排列顺序中，如果a[x]与a[y]不是相邻的，那么i就可以取a[x]和a[y]中间的数，这样|a[x] - a[y]|一定是大于|a[x] - a[i]|
比如3，6，9，11。如果a[x] = 3， a[y] = 9，如果a[x]可以是6，此时|a[x] - a[y]| <= |a[x] - a[i]|不成立
所以在从小到大的排列顺序中a[x]与a[y]一定相邻才可以！这样其实可以预处理出来哪些a[x]与a[y]是可以配对的
注意排序后的下标也和原来发生了变化！

比如现在a[x]与a[y]是相邻的，那么在原来a数组中a[x]对于的下标是4，a[y]对应的下标是10，那么如果查询区间[l, r]中包含4和10，那么就可以选取出来一个合法配对(4, 10)满足题意
1，对于排序后的数组，比如b[1], b[2], b[3], b[4]，那么b[1]和b[2]一定是可以配对的（要对应回原来a数组中的下标）
    对于b[2]来说，b[1]和b[2]可以都是配对的，这时候满足的条件是b[3] - b[2] = b[2] - b[1]
    否则要么b[3] - b[2]小，要么b[2] - b[1]小，必须取最小的那一个配对！
2，从刚才的第一点可以得知如果b[i]和b[i + 1]可以配对，那么b[i + 1]不一定和b[i]配对
    比如1，10，15，16.中间的10和15配对，但是15和16配对

那么这些可以配对的b[i]与b[i - 1]或者b[i + 1]，对于原来a数组中的左边为[L, R]，那么就是如果查询区间[l, r]满足l <= L < R <= r，那么累加答案！
理解透彻题目后可以总结为，预处理出合法的区间[L, R]，然后在每一次查询区间[l, r]中求出包含了多少个[L, R]区间即可！

这里可以使用主席树解决，对于第i个版本存入刚好区间[L, R]中L = i，然后将R存进去
查询区间[l, r]时，就是将版本r与l - 1做差得到区间中的R，然后需要小于等于r的个数即为答案
*/
const int N = 100000 + 100;

int n, q;
int a[N];

struct Node{
    int l, r;
    int cnt;
}tr[30 * N];


int id;
int root[N];

bool cmp(PII a, PII b){
    return a.first < b.first;
}

void push_up(int u){
    tr[u].cnt = (tr[tr[u].l].cnt + tr[tr[u].r].cnt);
}

int insert(int u){
    ++ id;
    tr[id] = tr[u];
    return id;
}

int modify(int u, int l, int r, int pos){
    u = insert(u);

    if(l == r){
        tr[u].cnt ++;
        return u;
    }
    else{
        int mid = (l + r) >> 1;
        if(pos <= mid) tr[u].l = modify(tr[u].l, l, mid, pos);
        else tr[u].r = modify(tr[u].r, mid + 1, r, pos);
        
        push_up(u);
        return u;
    }
}

int query(int u, int v, int l, int r, int k){
    
    if(l == r) return tr[u].cnt - tr[v].cnt;
    else{
        int mid = (l + r) >> 1;
        int res = 0;
        if(k <= mid) res += query(tr[u].l, tr[v].l, l, mid, k);
        else{
            res += tr[tr[u].l].cnt - tr[tr[v].l].cnt;
            res += query(tr[u].r, tr[v].r, mid + 1, r, k);
        }
        return res;
    } 
}

void solve(){
    
    cin >> n >> q;
    for(int i = 1; i <= n; i ++) cin >> a[i];
    vector<PII> b(n + 10);
    for(int i = 1; i <= n; i ++) b[i] = {a[i], i};
    sort(b.begin() + 1, b.begin() + 1 + n, cmp);
    vector<vector<int> > adj(n + 10);

    for(int i = 1; i <= n; i ++){
        if(i == 1){
            int l = min(b[1].se, b[2].se);
            int r = max(b[1].se, b[2].se);
            adj[l].pb(r);
        }
        else if(i == n){
            int l = min(b[n].se, b[n - 1].se);
            int r = max(b[n].se, b[n - 1].se);
            adj[l].pb(r);
        }
        else{
            int num = min(b[i].fi - b[i - 1].fi, b[i + 1].fi - b[i].fi);
            if(b[i].fi - b[i - 1].fi == num){
                int l = min(b[i].se, b[i - 1].se);
                int r = max(b[i].se, b[i - 1].se);
                adj[l].pb(r);
            }
            if(b[i + 1].fi - b[i].fi == num){
                int l = min(b[i].se, b[i + 1].se);
                int r = max(b[i].se, b[i + 1].se);
                adj[l].pb(r);
            }
        }
    }
    
    root[0] = 0;

    for(int i = 1; i <= n; i ++){
        root[i] = root[i - 1];
        for(int j : adj[i]){
            root[i] = modify(root[i], 1, n, j);
        }
    }

    int ans = 0;
    for(int i = 1; i <= q; i ++){
        int l, r; cin >> l >> r;
        ans += i * query(root[r], root[l - 1], 1, n, r);
    }
    cout << ans << endl;
    return ;
}

