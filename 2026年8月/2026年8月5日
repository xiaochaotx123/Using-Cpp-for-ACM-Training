*/
void solve(){
    
    int n; cin >> n;
    int sum = 0;
    vector<int> a(n + 10);
    multiset<int> see;
    for(int i = 1; i <= n; i ++){
        cin >> a[i];
        sum += a[i];
    }
    if(sum <= 0){
        cout << -1 << endl;
        return ;
    }

    vector<int> ans(n + 10);
    bool ok = true;
    sort(a.begin() + 1, a.begin() + 1 + n);
    for(int i = 1; i <= n; i ++){
        if(a[i] <= 0) see.insert(a[i]);
        else{
            if(ok) ans[1] = a[i], ok = false;
            else see.insert(a[i]);
        }
    }
    for(int i = 2; i <= n; i ++){
        auto it = see.lower_bound(1 - ans[i - 1]);
        ans[i] = *it + ans[i - 1];
        see.erase(it);
    }
    for(int i = 1; i <= n; i ++) cout << ans[i] << " ";
    cout << endl;
    return ;
}
