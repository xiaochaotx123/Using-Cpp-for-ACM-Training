const int N = 100000 + 100;

int n;

struct Node{
    int l, r;
    int val;
}tr[30 * N];

int id;
int root[N];
int len[N];
vector<int> caozuo;


int insert(int u){
    ++ id;
    tr[id] = tr[u];
    return id;
}

int modify(int u, int l, int r, int pos, int value){
    u = insert(u);

    if(l == r){
        tr[u].val = value;
        return u;
    }
    else{
        int mid = (l + r) >> 1;
        if(pos <= mid) tr[u].l = modify(tr[u].l, l, mid, pos, value);
        else tr[u].r = modify(tr[u].r, mid + 1, r, pos, value);
        return u;
    }
}

int query(int u, int l, int r, int pos){
    if(l == r) return tr[u].val;
    else{
        int mid = (l + r) >> 1;
        if(pos <= mid) return query(tr[u].l, l, mid, pos);
        else return query(tr[u].r, mid + 1, r, pos);
    }
}

void solve(){
    
    cin >> n;
    
    root[0] = 0;
    len[0] = 0;
    caozuo.pb(0);

    for(int i = 1; i <= n; i ++){
        char op; cin >> op;
        if(op == 'T'){
            char ch; cin >> ch;
            int num = (int)(ch - 'a');
            len[i] = len[i - 1] + 1;
            root[i] = modify(root[i - 1], 1, n, len[i], num);
            caozuo.pb(i);
        }
        else if(op == 'U'){
            int x; cin >> x;
            int pos = sz(caozuo) - x - 1;
            root[i] = root[caozuo[pos]];
            len[i] = len[caozuo[pos]];
            caozuo.pb(i);
        }
        else{
            int x; cin >> x;
            root[i] = root[i - 1];
            len[i] = len[i - 1];
            int num = query(root[i], 1, n, x);
            cout << (char)(num + 'a') << endl;
        }
    }
    return ;
}

/*
https://www.luogu.com.cn/problem/P1972

《预处理pre[i]表示现在位置a[i]前面最近的一个a[i]的位置，如果不存在，默认为0即可
现在求区间[l, r]中不同元素的种类数目，实际上就是：
    对于[l, r]中的每一个位置pos来说如果满足pre[pos] < l，那么a[pos]就算作一个贡献！》
    所以就是查询区间[l, r]中有多少个比l小的数即可
    将1到n看作n个版本......这和求区间[l, r]中第k小的数有些类似
*/
int read() {
    int x = 0, f = 1;
    char ch = getchar();
    while (!isdigit(ch)) {
        if (ch == '-') f = -1;
        ch = getchar();
    }
    while (isdigit(ch)) {
        x = x * 10 + ch - '0';
        ch = getchar();
    }
    return x * f;
}

const int N = 1000000 + 10;


int n, m;
int a[N], pre_pos[N], pos[N];

struct Node{
    int l, r;
    int cnt;
}tr[30 * N];

int id;
int root[N];


void push_up(int u){
    tr[u].cnt = (tr[tr[u].l].cnt + tr[tr[u].r].cnt);
}

int insert(int u){
    ++ id;
    tr[id] = tr[u];
    return id; 
}

int modify(int u, int l, int r, int pos){
    u = insert(u);

    if(l == r){
        tr[u].cnt ++;
        return u;
    }
    else{
        int mid = (l + r) >> 1;
        if(pos <= mid) tr[u].l = modify(tr[u].l, l, mid, pos);
        else tr[u].r = modify(tr[u].r, mid + 1, r, pos);

        push_up(u);
        return u;
    }
}

int query(int u, int v, int l, int r, int pos){
    if(l == r) return tr[u].cnt - tr[v].cnt;
    else{
        int mid = (l + r) >> 1;
        int res = 0;
        if(pos <= mid) res += query(tr[u].l, tr[v].l, l, mid, pos);
        else{
            res += tr[tr[u].l].cnt - tr[tr[v].l].cnt;
            res += query(tr[u].r, tr[v].r, mid + 1, r, pos);
        }
        return res;
    }
}

void solve(){
    
    n = read();
    for(int i = 1; i <= n; i ++){
        a[i] = read();
        pos[i] = pre_pos[a[i]] + 1;
        pre_pos[a[i]] = i;
    }    

    root[0] = 0;

    for(int i = 1; i <= n; i ++){
        root[i] = modify(root[i - 1], 1, n + 1, pos[i]);
    }

    m = read();
    for(int i = 1; i <= m; i ++){
        int l, r; 
        l = read();
        r = read();
        cout << query(root[r], root[l - 1], 1, n + 1, l) << endl;
    }
    return ;
}
