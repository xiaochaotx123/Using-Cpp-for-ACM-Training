const int N = 100000 + 100;

int n, m;
vector<int> adj[N];
int dfn[N], low[N];
int dfn_cnt, scc_cnt;
stack<int> sta;
bool in_stack[N];
int scc_id[N];

map<PII, int> ma;


void tarjan(int u){
    dfn[u] = low[u] = ++ dfn_cnt;
    sta.push(u);
    in_stack[u] = true;

    for(int v : adj[u]){
        if(!dfn[v]){
            tarjan(v);
            low[u] = min(low[u], low[v]);
        }
        else if(in_stack[v]){
            low[u] = min(low[u], dfn[v]);
        }
    }

    if(dfn[u] == low[u]){
        int v = 0;
        scc_cnt ++;
        while(u != v){
            v = sta.top();
            sta.pop();
            scc_id[v] = scc_cnt;
            in_stack[v] = false;
        }
    }
}

void solve(){
    
    cin >> n >> m;
    for(int i = 1; i <= m; i ++){
        int u, v; cin >> u >> v;
        if(ma.count({u, v})) continue;
        ma[{u, v}] = 1;

        adj[u].pb(v);
    }
    
    for(int i = 1; i <= n; i ++){
        if(!dfn[i]) tarjan(i);
    }

    vector<int> cnt(scc_cnt + 10);
    for(int i = 1; i <= n; i ++){
        cnt[scc_id[i]] ++;
    }

    int ans = 0;
    for(int i = 1; i <= scc_cnt; i ++){
        int sum = (cnt[i] - 1) * cnt[i] / 2;
        ans += sum;
    }
    
    cout << ans << endl;
    return ;
}
