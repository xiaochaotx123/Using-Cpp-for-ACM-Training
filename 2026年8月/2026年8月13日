const int mod = 1000000000 + 7;

void solve(){
    /*
    状态压缩DP，以行为阶段，使用二进制数mask表示某一行的放置方案(1表示放国王，0表示不放)
    定义dp[i][mask]表示处理完第i行，且第i行的状态为mask 的方案数
    初始化：dp[0][0] = 1(第0行看作空状态)
    优化：如果w > h，可以将网格转置，保证w <= h，不仅减少空间消耗并且减少枚举的状态，缩小时间！

    1，首先，预处理出所有行内合法的状态，即mask内不用有相邻的1。同时每个状态必须符合该行白字格子的限制
    2，然后对于相邻两行，需要检查它们之间是否兼容：即同一列不能同时为1(上下攻击), 且错开一列也不能同时为1()斜对角攻击
    */
        
    int n, m; cin >> n >> m;
    vector<vector<char> > a(n + 10, vector<char> (m + 10));
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= m; j ++) cin >> a[i][j];
    }

    if(m > n){
        vector<vector<char> > b(m + 10, vector<char> (n + 10));
        
        for(int i = 1; i <= n; i ++){
            for(int j = 1; j <= m; j ++){
                b[j][i] = a[i][j];
            }
        }
        swap(n, m);
        a = b;
    }

    /*
    这一步预处理出一行中所有的合法状态，就是一行内不能存在相邻的1
    即(mask & (mask << 1)) == 0
    当n和m都最大为24时，state中元素的个数最多为121393个
    */
    vector<int> state;
    for(int mask = 0; mask < (1LL << m); mask ++){
        if((mask & (mask << 1)) == 0){
            state.pb(mask);
        }
    }

    /*
    为了快速从掩码值获取其索引，建立映射数组，大小为1LL << m
    */
    int size_state = sz(state);
    vector<int> mask_to_idx(1LL << m, -1);
    for(int i = 0; i < size_state; i ++){
        mask_to_idx[state[i]] = i;
    }
    
    vector<vector<int> > nex_state(size_state + 10);

    int total_state = (1LL << m) - 1;
    for(int i = 0; i < size_state; i ++){
        int mask = state[i];

        /*
        如果当前这一行的状态是mask，那么下一列的状态不能是 与maks, mask << 1, mask >> 1存在相同位置1的状态
        所以mask | (mask << 1) | (mask >> 1)是求出下一列与mask不合法的状态
        然后对(mask | (maks << 1) | (mask >> 1)按位取反，求出下一行中可以放置国王的合法位置
        但是按位取反会把多余的0变为1，所以还需要与(1LL << m) - 1 按位与操作
        */
        int safe = total_state & ~(mask | (mask << 1) | (mask >> 1));
       
        /*
        求safe的子集(模板)
        */
        int sub = safe;
        while(1){
            if((sub & (sub << 1)) == 0){
                int j = mask_to_idx[sub];
                nex_state[i].pb(j);
            }
            if(sub == 0) break;
            sub = (sub - 1) & safe; 
        }
    }

    /*
    allow表示的是每一行除去#位置可以放置的合法位置，因为只有.可以放置国王
    */
    vector<int> allow(n + 10, 0);
    for(int i = 1; i <= n; i ++){
        int now_mask = 0;
        for(int j = 1; j <= m; j ++){
            if(a[i][j] == '.') now_mask |= (1LL << (j - 1));
        }
        allow[i] = now_mask;
    }

    /*
    滚动优化空间
    */
    vector<int> dp(size_state, 0), pre_dp(size_state, 0);
    dp[mask_to_idx[0]] = 1;

    for(int i = 1; i <= n; i ++){
        fill(all(pre_dp), 0);
        for(int j = 0; j < size_state; j ++){
            int mask = state[j];
            if((mask & ~allow[i]) != 0) continue;

            int sum = 0;
            for(int nex_mask : nex_state[j]){
                sum = (sum + dp[nex_mask]) % mod;
            }
            pre_dp[j] = sum;
        }
        swap(dp, pre_dp);
    }
    for(int i = 1)

    int ans = 0;
    for(int i = 0; i < size_state; i ++){
        int mask = state[i];
        if((mask & ~allow[n]) == 0) ans = (ans + dp[i]) % mod;
    }
    cout << ans << endl;
    return ;
}
