/*
https://atcoder.jp/contests/abc470/tasks/abc470_b
*/

void solve(){
    
    int n; cin >> n;
    vector<int> cnt(n + 10);

    int max_cnt = 0;
    for(int i = 1; i <= n; i ++){
        int x; cin >> x;
        cnt[x] ++;
        max_cnt = max(max_cnt, cnt[x]);
    }

    cout << n - max_cnt << endl;
    return ;
}
