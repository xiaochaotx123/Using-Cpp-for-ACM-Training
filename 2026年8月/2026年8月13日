void solve(){
    
    int n, m; cin >> n >> m;
    map<int, int> ma;
    vector<int> a(n + 10);

    for(int i = 1; i <= n; i ++) cin >> a[i];

    int right = 0;
    int cnt = 0;
    int max_len = 0;
    for(int left = 1; left <= n; left ++){
        while(right + 1 <= n && cnt <= m){
            if(ma[a[right + 1]] == 0) cnt ++;
            ma[a[right + 1]] ++;
            right ++;
        }
        while(cnt > m){
            if(ma[a[right]] == 1) cnt --;
            ma[a[right]] --;
            right --;
        }
        // cout << left << " " << right << endl;
        max_len = max(max_len, right - left + 1);
        if(ma[a[left]] == 1) cnt --;
        ma[a[left]] --;
    }

    cout << max_len << endl;
    return ;
}
