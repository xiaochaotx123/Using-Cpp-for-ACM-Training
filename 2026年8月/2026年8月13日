vector<int> total_num;

void dfs(int num, int x, int mul){
    total_num.pb(mul);
    if(x == 11) return ;
    for(int i = num; i <= 9; i ++){
        dfs(i, x + 1, mul * i);
    }
}

void solve(){
    /*
    数据范围最大是10的11次方，也就是说十进制位的长度最大是12，所以我一开始就是想到了搜索dfs处理
    但是一共有12位，每一位有0到9一共10种选择，所以一共有10的12次方种，肯定超时！

    m - f(m) = B
    所以放弃枚举m，但是可考虑f(m)的值，f(m)就是各个数位的乘积
    先不考虑0和1，因为如果数位上存在0，那么f(m) = 0
    如果数位上存在1，无影响 

    这里就是区别：如果我去枚举m，那么每一位上都需要去确定是哪一个具体的数字，但是对于f(m)这个乘积来说
    1 × 2 × 3 = 6， 2 × 3 × 1 = 6，即不同的排列但是有相同的乘积，所以枚举其中的组合情况即可
    在dfs中，从小到大枚举，比如现在枚举的a[x] = 5, 那么a[x + 1] 一定 大于等于5，不会小于5，这样将枚举排列转化位了枚举组合情况
    对于式子m = f(m) + B, 多个不同的m值可能的数位乘积对应相同的f(m), 所以只需要去搜索f(m)就可以了
    如果f(m)确定了，那么f(m) + B的值就确定了!

    f(m)的可能取值数量非常有限，从而避免了遍历巨大的m范围
    首先dfs搜索出所有可能的f(m), 然后m = B + f(m), 检查m是否在[1, N]范围内即可
    */
    int N, B; cin >> N >> B;

    dfs(2, 0, 1);
    set<int> see;

    /*
    将乘积为0的情况放入total_num中
    */
    total_num.pb(0);
    for(int num : total_num){
        int m = num + B;

        int temp = m, dig_num = 1;
        while(temp){
            dig_num = dig_num * (temp % 10);
            temp /= 10;
        }

        // 验证当前m的数位乘积等不等于num

        if(dig_num != num) continue;
        if(1 <= m && m <= N) see.insert(m);
    }

    cout << sz(see) << endl;
    return ;
}
