int SG[55][2000];

int sg(int w, int b){
    if(w == 0 && b <= 1) return 0;

    if(SG[w][b] != -1) return SG[w][b];

    // 使用set来保存所以的下一步的可能值，求mex
    set<int> see;
    
    // 操作A: 拿走一颗白石 ----> (w - 1, b + w)
    if(w >= 1) see.insert(sg(w - 1, b + w));

    // 操作B：选取一个k∈[1, b / 2] ----> (w, b - k)
    for(int i =  1; i <= b / 2; i ++){
        see.insert(sg(w, b - i));
    }

    int mex = 0;
    while(see.count(mex)) mex ++;

    SG[w][b] = mex;
    return mex;
}

void solve(){
    /*
    操作A:(仅 w >= 1 可以使用)
        拿走1颗白石，额外增加w颗青石，新状态:(w - 1, b + w)
    操作B:(仅 b >= 2 可以使用)
        选整数k∈[1, b / 2], 拿走k颗青石，新状态:(w, b - k)
    */
    
    /*
    公平组合游戏拆分：每一堆是独立子游戏，总游戏Grundy值 = 所有堆Grundy值的异或
    SG定理：多个独立子游戏，吧每一堆的sg值全部异或起来：
        总异或值不等于0，那么先手必胜
        总异或值等于0，那么后手必胜

    Grundy(SG)函数定义：
        终态(w = 0, b <= 1): sg[w][b] = 0
        普通状态：收集所有一步可达后继状态的sg值几何，sg = mex(集合) (最小未出现非负整数)
    预处理范围：w <= 50, 操作A会让青石大幅上涨，但w上限仅为50，可以预先达标sg[w][b]
    */

    memset(SG, -1, sizeof(SG));
    int n; cin >> n;
    vector<int> W(n), B(n);

    for(int i = 0; i < n; i ++) cin >> W[i];
    for(int i = 0; i < n; i ++) cin >> B[i];

    int xor_sum = 0;
    for(int i = 0; i < n; i ++){
        xor_sum = xor_sum ^ sg(W[i], B[i]);
    }

    if(!xor_sum) cout << "Second" << endl;
    else cout << "First" << endl;
    return ;
}
