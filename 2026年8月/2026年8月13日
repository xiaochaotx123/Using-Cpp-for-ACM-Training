const int N = 20;
int n, m;

int a[N][N];
map<PII, int> ma;


int b[N], vis[N];
int min_time = inf;

void dfs(int x){
    
    if(x == n + 1){
        for(int i = 1; i <= n - 1; i ++){
            int u = b[i], v = b[i + 1];
            if(u > v) swap(u, v);
            if(ma.count({u, v})) return ;
        }
        int now_time = 0;
        for(int i = 1; i <= n; i ++){
            now_time += a[b[i]][i];
        }
        min_time = min(min_time, now_time);
        return ;
    }
    for(int i = 1; i <= n; i ++){
        if(!vis[i]){
            vis[i] = 1;
            b[x] = i;
            dfs(x + 1);
            vis[i] = 0;
        }
    }
}

void solve(){
    
    cin >> n;
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= n; j ++) cin >> a[i][j];
    }
    
    cin >> m;
    for(int i = 1; i <= m; i ++){
        int u, v; cin >> u >> v;
        if(u > v) swap(u, v);
        ma[{u, v}] = 1;
    }

    dfs(1);

    if(min_time == inf) cout << "-1" << endl;
    else cout << min_time << endl;
    return ;
}
