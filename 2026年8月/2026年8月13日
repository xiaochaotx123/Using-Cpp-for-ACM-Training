const int N = 500000 + 100;

struct Node{
    int l, r;
    int sum, flag;
}tr[4 * N];


void push_down(int u){
    if(tr[u].flag){
        int flag = tr[u].flag;
        tr[u << 1].sum = flag;
        tr[u << 1].flag = flag;
        tr[u << 1 | 1].sum = flag;
        tr[u << 1 | 1].flag = flag;
        tr[u].flag = 0;
    }
}

void push_up(int u){
    tr[u].sum = max(tr[u << 1].sum, (tr[u << 1 | 1].sum));
}

void build(int u, int l, int r){
    if(l == r){
        tr[u] = {l, r, 0, 0};
        return ;
    }
    else{
        tr[u] = {l, r, 0, 0};
        int mid = (tr[u].l + tr[u].r) >> 1;
        build(u << 1, l, mid);
        build(u << 1 | 1, mid + 1, r);
    }
}

int query(int u, int l, int r){
    if(l <= tr[u].l && tr[u].r <= r) return tr[u].sum;
    else{
        push_down(u);
        int res = 0;
        int mid = (tr[u].l + tr[u].r) >> 1;
        if(l <= mid) res = max(res, query(u << 1, l, r));
        if(r > mid) res = max(res, query(u << 1 | 1, l, r));
        return res;
    }
}

void modify(int u, int l, int r, int x){
    if(l <= tr[u].l && tr[u].r <= r){
        tr[u].sum = x;
        tr[u].flag = x;
        return ;
    }
    else{
        push_down(u);
        int mid = (tr[u].l + tr[u].r) >> 1;
        if(l <= mid) modify(u << 1, l, r, x);
        if(r > mid) modify(u << 1 | 1, l, r, x);
        push_up(u);
    }
}

void solve(){
    
    int n, m; cin >> n >> m;

    build(1, 1, n);

    for(int i = 1; i <= m; i ++){
        int l, r; cin >> l >> r;
        int max_num = query(1, l, r) + 1;
        cout << max_num << endl;
        modify(1, l, r, max_num);
    }
    return ;
}
