    cin >> n;
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= n - 1; j ++){
            int x; cin >> x;
            adj[i].pb(x);
        }
        reverse(all(adj[i]));
    }    

    int ans = 0;
    while(1){
        vector<bool> vis(n + 10, false);
        
        bool ok1 = true, ok2 = true;

        for(int i = 1; i <= n; i ++){
            if(vis[i]) continue;
            if(adj[i].size()){
                int x = adj[i].back();
                if(vis[x]) continue;

                if(d[x][i]){
                    vis[i] = 1;
                    vis[x] = 1;
                    adj[i].ppb();
                    adj[x].ppb();
                    if(sz(adj[i])) d[i][adj[i].back()] = 1;
                    if(sz(adj[x])) d[x][adj[x].back()] = 1;
                    ok1 = false;
                }
                else d[i][x] = 1;
            }
        }

        if(!ok1) ans ++;
        else{
            cout << "-1" << endl;
            return ;
        }
        for(int i = 1; i <= n; i ++){
            if(sz(adj[i])){
                ok2 = false;
                break;
            }
        }
        if(ok2) break;
    }

    cout << ans << endl;
