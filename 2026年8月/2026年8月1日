    for(int i = 1; i <= n; i ++){
        int x, y; cin >> x >> y;
        int nx = (x - 1) % m + 1;
        int ny = (y - 1) % m + 1;
        state[nx][ny] ^= 1;
    }

    vector<vector<int> > a = state;
    bool ok = true;
    for(int i = 1; i <= m; i ++){
        if(a[i][1]){
            for(int j = 1; j <= m; j ++){
                a[i][j] ^= 1;
            }
        }
    }
    for(int i = 1; i <= m; i ++){
        for(int j = 1; j <= m; j ++){
            if(a[i][j]){
                ok = false;
            }
        }
    }
    if(ok){
        cout << "YES" << endl;
        return ;
    }
    ok = true;

    a = state;
    for(int i = 1; i <= m; i ++){
        if(a[1][i]){
            for(int j = 1; j <= m; j ++){
                a[j][i] ^= 1;
                if(a[j][i]) ok = false;
            }
        }
    }
    for(int i = 1; i <= m; i ++){
        for(int j = 1; j <= m; j ++){
            if(a[i][j]){
                ok = false;
            }
        }
