const int N = 10000 + 100;
int n, m;
int a[N];

bool check(int x){
    int cnt_people = 0, now_time = 0;
    for(int i = n; i >= 1; i --){
        if(now_time + a[i] > x){
            cnt_people ++;
            now_time = a[i];
        }
        else now_time += a[i];
    }
    if(now_time) cnt_people ++;


    if(cnt_people <= m) return true;
    return false;
}

void solve(){
    
    int l = 0, r = 1000000000, min_time = 100000000;
    cin >> n >> m;
    for(int i = 1; i <= n; i ++){
        cin >> a[i];
        l = max(l, a[i]);
    }
    while(l <= r){
        int mid = (l + r) / 2;
        if(check(mid)){
            r = mid - 1;
            min_time = mid;
        }
        else l = mid + 1;
    }

    vector<PII> ans;
    int R = n, now_time = 0;
    for(int i = n; i >= 1; i --){
        if(now_time + a[i] > min_time){
            ans.pb({i + 1, R});
            R = i;
            now_time = a[i];
        }
        else if(now_time + a[i] == min_time){
            ans.pb({i, R});
            R = i - 1;
            now_time = 0;
        }
        else now_time += a[i];
    }
    if(now_time) ans.pb({1, R});
    while(sz(ans) < m) ans.pb({0, 0});
    reverse(all(ans));
    for(auto [u, v] : ans) cout << u << " " << v << endl;

    return ;
}
