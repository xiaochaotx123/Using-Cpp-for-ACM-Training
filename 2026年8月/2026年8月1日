首先需要想到将每一个位置(i, j)转换到k×k以内的格子中，然后如何判断k×k大小的矩阵是否可以全部范围为0呢？
条件是对于每一行要么与第一行完全相同，要么是与第一行完全取反
虽然我这么写也可以，但是写复杂了
*/
void solve(){
    
    int n, m; cin >> n >> m;
    vector<vector<int> > state(m + 10, vector<int> (m + 10));
    
    for(int i = 1; i <= n; i ++){
        int x, y; cin >> x >> y;
        int nx = (x - 1) % m + 1;
        int ny = (y - 1) % m + 1;
        state[nx][ny] ^= 1;
    }

    for(int i = 1; i <= m; i ++){
        bool ok1 = false, ok2 = false;
        for(int j = 1; j <= m; j ++){
            if(state[i][j] != state[1][j]) ok1 = true;
            if(state[i][j] != 1 - state[1][j]) ok2 = true;
