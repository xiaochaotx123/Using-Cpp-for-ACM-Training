/*
码蹄集的题目是这样的，看起来时间复杂度因该超时了，但是数据没有去卡；正式的百度之星的题目呢？有可能你的做法感觉超时了，但实际上可以通过的/(ㄒoㄒ)/~~
但这道题目确实可以优化一下，而不是这种纯暴力。
1：首先一个显而易见的点就是如果我使用i×j大小的矩阵去覆盖(不能超过n×m大小，且每一个位置恰好覆盖一定的次数)，如果可以的话，那么累加和一定是i×j的倍数
    使用的次数也直接就是total_sum / (i × j)
2：可以从大到小枚举i和j，这样如果一旦可以，一定是最大的举矩形块，求出的次数也一定最小
3：对于check函数中，每次判断b[i][j]是否为0，如果不是0，就是实时更新再枚举一遍矩形的范围，这个其实是可以使用二维差分经行实时查询的
    虽然做不到实时全部查询，但是当判断b[i][j]时，使用b[i][j] + diff[i][j] - diff[i - 1][j] - diff[i][j - 1] + diff[i - 1][j - 1]就可以修改前面经过
    若干次修改的真实值了！
*/
const int N = 100 + 10;
int n, m;
int a[N][N], b[N][N];
int total_sum;

// X,Y 是矩形大小
bool check(int X, int Y){
    vector<vector<int>> diff(n+2, vector<int>(m+2, 0));
    vector<vector<int>> g(n+2, vector<int>(m+2));
    // 复制原数组
    for(int i=1;i<=n;i++)
        for(int j=1;j<=m;j++)
            g[i][j] = a[i][j];

    for(int i = 1; i <= n; i++){
        for(int j = 1; j <= m; j++){
            // 先更新差分前缀和，算出当前位置受到的影响
            // 二维差分实时求当前位置增量
            if(i>1) diff[i][j] += diff[i-1][j];
            if(j>1) diff[i][j] += diff[i][j-1];
            if(i>1 && j>1) diff[i][j] -= diff[i-1][j-1];

            int cur = g[i][j] + diff[i][j];
            if(cur < 0) return false;
            if(cur == 0) continue;

            // 需要放置 cur 个 X*Y 的矩形
            int x2 = i + X - 1;
            int y2 = j + Y - 1;
            if(x2 > n || y2 > m) return false;

            int v = -cur;
            // 二维差分：矩形 [i,j] ~ [x2,y2] += v
            diff[i][j] += v;
            diff[i][y2+1] -= v;
            diff[x2+1][j] -= v;
            diff[x2+1][y2+1] += v;
        }
    }
    return true;
}

void solve(){
    
    cin >> n >> m;
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= m; j ++){
            cin >> a[i][j];
            total_sum += a[i][j];
        }
    }    

    // 从大到小枚举一定最优
    for(int i = n; i >= 1; i --){
        for(int j = m; j >= 1; j --){
            // 如果大小为i×j的矩形能够完成，那么总数total_sum一定是i×j的倍数
            if(total_sum % (i * j)) continue;
            if(check(i, j)){
                cout << total_sum / (i * j) << endl;
                return ;
            }
        }
    }
    return ;
}
