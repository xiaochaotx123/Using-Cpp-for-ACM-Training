/*
https://www.matiji.net/exam/brushquestion/19/3846/4C6668FEB8CFD6520DE73B365B31D1A4

给定长度为n的整数序列，让这n个整数划分成m段连续区间，设每个区间的数字的异或和为e[i], 求e[1] | e[2] | e[3] | ... e[m - 1] | e[m]的最小值
经典的从高位开始思考，对于现在第mask位，如果要让e[1] | e[2] | e[3] | ... e[m - 1] | e[m]的结果在第mask位上为0，那么需要满足所有的e[i]在第mask位上为0
设e[i]对应的区间为[l, r]，前缀异或，那么就是e[i] = pre[r] ^ pre[l - 1]在第mask位上为0
pre[r] ^ pre[l - 1]在第mask位上为0，那么pre[r]和pre[l - 1]在第mask位上要么都是0，要么都是1
《注意到》因为第一段区间的左边界是1，所以pre[l - 1] = pre[0]在任何位上都是0，那么后面的pre[r1]在第mask位上也为0
然后[1, r1][l2, r2]，因为l2 = r1 + 1, pre[l2 - 1] = pre[r1]，所以pre[r2]第mask位上要为0
总的来说就是pre[i]二进制第mask位上位0即可，这样的i至少要有m个，但是对于mask-1位上又要重新判断
所以需要使用vis[]来标记哪些位置可以作为分割点，哪些位置不能作为分割点
*/
void solve(){
    
    int n, m; cin >> n >> m;
    vector<int> a(n + 10), pre(n + 10);
    vector<bool> vis(n + 10);

    for(int i = 1; i <= n; i ++){
        cin >> a[i];
        pre[i] = pre[i - 1] ^ a[i];
    }

    int ans = 0;
    for(int mask = 62; mask >= 0; mask --){
        if((pre[n] >> mask) & 1){
            ans += (1LL << mask);
            continue;
        }

        int cnt = 0;
        for(int i = 1; i <= n; i ++){
            if(vis[i]) continue;
            if(!((pre[i] >> mask) & 1)) cnt ++;
        }
        if(cnt >= m){
            for(int i = 1; i <= n; i ++){
                if(vis[i]) continue;
                if((pre[i] >> mask) & 1) vis[i] = true;
            }
        }
        else ans += (1LL << mask);
    }
    cout << ans << endl;
    return ;
}
