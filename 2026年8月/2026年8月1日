int total_sum;

bool check(int x, int y){
    memcpy(b, a, sizeof(a));
    for(int i = 1; i <= n - x + 1; i ++){
        for(int j = 1; j <= m - y + 1; j ++){
            if(b[i][j]){
                for(int x1 = i + x - 1; x1 >= i; x1 --){
                    for(int y1 = j + y - 1; y1 >= j; y1 --){
                        b[x1][y1] -= b[i][j];
                        if(b[x1][y1] < 0) return false;
                    }
                }
            }
        }
    }
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= m; j ++){
            if(b[i][j] != 0) return false;
        }
    }
    return true;
}

void solve(){
    
    cin >> n >> m;
    for(int i = 1; i <= n; i ++){
        for(int j = 1; j <= m; j ++){
            cin >> a[i][j];
            total_sum += a[i][j];
        }
    }    

    // 从大到小枚举一定最优
    for(int i = n; i >= 1; i --){
        for(int j = m; j >= 1; j --){
            // 如果大小为i×j的矩形能够完成，那么总数total_sum一定是i×j的倍数
            if(total_sum % (i * j)) continue;
            if(check(i, j)){
                cout << total_sum / (i * j) << endl;
                return ;
            }
        }
