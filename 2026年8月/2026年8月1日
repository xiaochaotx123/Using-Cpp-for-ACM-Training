void solve(){
    
    memset(nex, 0x3f3f3f3f, sizeof(nex));

    int q; cin >> q;
    vector<string> a(q + 10);
    for(int i = 1; i <= q; i ++) cin >> a[i];
    string s; cin >> s;
    int n = sz(s);
    s = " " + s;
    for(int i = n; i >= 1; i --){
        for(int j = 0; j < 26; j ++) nex[i][j] = nex[i + 1][j];
        nex[i][s[i] - 'a'] = i;
    }

    for(int i = 1; i <= q; i ++){
        int pos = 1;
        bool ok = true;
        for(char sh : a[i]){
            if(nex[pos][sh - 'a'] == 0x3f3f3f3f3f3f3f3f){
                cout << "NO" << endl;
                ok = false;
                break;
            }
            pos = nex[pos][sh - 'a'] + 1;
        }
        if(ok) cout << "YES" << endl;
    }
    return ;
}

void solve(){
    
    int q; cin >> q;
    vector<string> a(q + 10);
    for(int i = 1; i <= q; i ++) cin >> a[i];

    string s; cin >> s;
    int n = sz(s);
    s = " " + s;

    vector<vector<int> > pos(26);
    for(int i = 1; i <= n; i ++){
        pos[s[i] - 'a'].pb(i);
    }
    for(int i = 1; i <= q; i ++){
        int pre_pos = 1;
        bool ok = true;

        for(int j = 0; j < sz(a[i]); j ++){
            int l = 0, r = sz(pos[a[i][j] - 'a']) - 1, now_pos = -1;
            while(l <= r){
                int mid = (l + r) / 2;
                if(pos[a[i][j] - 'a'][mid] >= pre_pos){
                    now_pos = mid;
                    r = mid - 1;
                }
                else l = mid + 1;
            }
            if(now_pos == -1){
                ok = false;
                cout << "NO" << endl;
                break;
            }
            pre_pos = pos[a[i][j] - 'a'][now_pos] + 1;
        }

        if(ok) cout << "YES" << endl;
    }
    return ;
}
